ass="btn btn-secondary button-cancel me-3" type="button" ng-click="$ctrl.cancel()" ng-disabled="$ctrl.isUpdating()">{{ "Cancel" | i18next}}</button>\n  </div>\n  <div ng-if="$ctrl.isUploading()" class="items-upload-spinner-holder">\n    <div class="os-spinner-medium os-spinner-spinning"></div>\n  </div>\n</div>\n')}]),e.exports=n},39158:function(e,t,i){var n="/project/web/ts/items/items.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<item-list\n  ng-show="$ctrl.isItemListActive()"\n  owner-info="$ctrl.ownerInfo"\n  refresh-list="$ctrl.itemSaved"\n  on-edit-item="$ctrl.onEditItem(item)"\n  on-add-item="$ctrl.onAddItem()"\n  on-bulk-upload="$ctrl.onBulkUpload(file)">\n</item-list>\n<item-details\n  ng-if="$ctrl.isItemDetailsActive()"\n  item-summary="$ctrl.selectedItemSummary"\n  on-cancel="$ctrl.onDetailCancel()"\n  on-save="$ctrl.onDetailSave()">\n</item-details>\n<item-upload\n  ng-if="$ctrl.isBulkUploadActive()"\n  selected-file="$ctrl.selectedFile"\n  owner-info="$ctrl.ownerInfo"\n  on-save="$ctrl.onUploadSave()"\n  on-cancel="$ctrl.onUploadCancel()">\n</item-upload>')}]),e.exports=n},59689:function(e,t,i){var n="/project/web/ts/keyboard-shortcuts/components/customize-shortcut-dialog-component.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="customize-shortcut-dialog-container">\n  <div class="dialog-header">\n    <div class="ns-dialog-button-ok button-ok add-space-right" ng-click="$ctrl.submit()" ng-class="{\'disabled\': !$ctrl.canSubmit()}">\n      <os-svg icon="ok-button"></os-svg>\n    </div>\n    <div class="ns-dialog-button-cancel backbone-cancel" ng-click="$ctrl.cancel()">\n      <os-svg icon="cancel-button"></os-svg>\n    </div>\n  </div>\n  <div class="dialog-body">\n    <div class="shortcut-description">\n      <div class="title">\n        <span>{{ \'Edit shortcut: __shortcutLabel__\' | i18next:{shortcutLabel: $ctrl.shortcut.label} }}</span>\n      </div>\n      <span ng-if="!$ctrl.isShortcutDisa