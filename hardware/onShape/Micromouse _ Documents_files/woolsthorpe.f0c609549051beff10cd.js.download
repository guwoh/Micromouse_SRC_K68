        <div ng-if="!documentSearch.searchText && documentList.isQueryPending" class="alert alert-info bt-no-model-alert os-documents-loading-zero-state">\n            <span class="os-loading-documents"><strong>{{ "Retrieving data…" | i18next}}</strong></span>\n          </div>\n          <div ng-if="documentList.items.length === 0 && documentList.isQueryPending && documentSearch.searchText" class="alert alert-info bt-no-model-alert os-documents-loading-zero-state">\n            <span><strong>{{ "Searching…" | i18next}}</strong></span>\n          </div>\n          <div ng-if="documentList.items.length === 0 && !documentList.isQueryPending && documentSearch.searchText" class="alert alert-info bt-no-model-alert os-documents-loading-zero-state">\n            <span>\n              <strong>{{ "No results found that match this search." | i18next}}</strong>\n              <div ng-hide="documentSearch.resourceType === \'cloudstorageaccount\' || documentSearch.resourceType === \'cloudstoragefolderobject\'">\n                {{"Try other search terms or refine the search by clicking the arrow in the search box." | i18next}}\n              </div>\n              <div ng-show="documentSearch.resourceType === \'cloudstorageaccount\' || documentSearch.resourceType === \'cloudstoragefolderobject\'">\n                {{"Try other search terms." | i18next}}\n              </div>\n            </span>\n          </div>\n        </td>\n        <td></td>\n      </tr>\n      </tbody>\n    </table>\n    <document-list-zero-state\n      ng-if="documentList.items.length === 0 && !documentSearch.searchText && !documentList.isQueryPending"\n      document-search="documentSearch" can-create-publication="canCreatePublication()" is-light-user="isLightUser()"\n      user-teams="userTeams" user-labels="userLabels"\n      should-show-switch-to-structure-view="shouldShowSwitchToStructureView()"></document-list-zero-state>\n  </div>\n</div>\n')}]),e.exports=n},7019:function(e,t,i){var n="/project/web/woolsthorpe/app/partials/documentMemoryStatistics.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div ng-controller="DocumentMemoryStatisticsController as controller" class="os-content-between-navbar-footer-container">\n  <div class="container-fluid">\n    <div class="row">\n      <div class="col-sm-4">\n        <h5>Memory usage for {{controller.documentInfo.name}}</h5>\n      </div>\n      <form class="col-sm-3 form-inline">\n        <label> Size Units: </label>\n        <select class="form-control"\n                ng-options="option.name for option in controller.getSizeUnits()"\n                ng-model="controller.selectedSize">\n        </select>\n      </form>\n      <div class="col-sm-1">\n        <button type="button" class="btn btn-primary" ng-click="controller.refresh()">\n          Refresh\n        </button>\n      </div>\n    </div>\n  </div>\n  <div class="container-fluid">\n    <table class="table table-striped table-bordered">\n      <tr>\n        <th>Info</th>\n        <th>\n          <form class="form-inline">\n            <label class="os-bold">Counts:</label>\n            <select class="form-control"\n                    ng-change="controller.onSortCountFieldChange(controller.currentSortCountField)"\n                    ng-options="option for option in controller.allCountFields"\n                    ng-model="controller.currentSortCountField">\n            </select>\n          </form>\n        </th>\n        <th>\n          <form class="form-inline">\n            <label class="os-bold">Sizes:</label>\n            <select class="form-control"\n                    ng-change="controller.onSortSizeFieldChange(controller.currentSortSizeField)"\n                    ng-options="option for option in controller.allSizeFields"\n                    ng-model="controller.currentSortSizeField">\n            </select>\n          </form>\n        </th>\n      </tr>\n      <tr ng-repeat="eInfo in controller.getElementList()">\n        <td>\