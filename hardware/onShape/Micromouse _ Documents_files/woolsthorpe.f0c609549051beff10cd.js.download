lass="form-control" ng-model="$ctrl.options.objectType"\n              ng-options="t.label for t in $ctrl.objectTypes" ng-change="$ctrl.onObjectTypeChanged()"\n              bt-focus="!$ctrl.isUserInMultipleCompanies()"></select>\n    </div>\n    <div class="form-group" ng-show="$ctrl.shouldShowCategorySelect()">\n      <label class="control-label inline-hint-label-flex">\n        <span>{{ "Category" | i18next }}</span>\n        <div class="popover-container">\n          <span class="os-user-preference-info os-question-mark"\n                popover-trigger="\'mouseenter\'"\n                popover-append-to-body="true"\n                uib-popover=\'{{"The rule will apply to applicable objects with the selected category or any category if none selected." | i18next}}\'\n                popover-placement="right">\n          </span>\n        </div>\n      </label>\n      <category-picker\n        company-id="$ctrl.options.company.id"\n        id="category-dropdown"\n        include-onshape="false"\n        include-global="true"\n        active-only="true"\n        os-multiple="false"\n        cat-filter="$ctrl.isCategoryValid"\n        ng-model="$ctrl.options.categories"\n        ng-change="$ctrl.onCategoryChanged()"\n        placeholder="\'Add category to rule…\' | i18next"\n        with-class="as-metadata-property"\n      ></category-picker>\n    </div>\n    <div class="form-group">\n      <label class="control-label inline-hint-label-flex">\n        <span>{{ "Format" | i18next }}</span>\n        <div class="popover-container">\n          <span class="os-user-preference-info os-question-mark"\n                popover-trigger="\'mouseenter\'"\n                popover-append-to-body="true"\n                uib-popover=\'{{"The rule will apply when exporting applicable objects to the selected file format." | i18next}}\'\n                popover-placement="right">\n          </span>\n        </div>\n      </label>\n      <select tabindex="1" id="format-dropdown" class="