blication\' | i18next}}">\n      <os-svg icon="assembly-insert-button"></os-svg>\n      <span class="align-insert-tab-text">{{ \'Insert document tabs\' | i18next }}</span>\n    </button>\n  </div>\n\n  \x3c!-- Main content --\x3e\n  <div class="tab-list-container os-col" os-tab-manager-list>\n    <div class="document-tab-list tab-tree" ng-class="view.tabs">\n      <div class="alert alert-info no-search-results" ng-if="!isEmptyTree && numberOfResults === 0">\n        <p>{{"No results found" | i18next}} </p>\n        <button class="btn btn-secondary" ng-click="TabCtrl.clearAllFilters()">{{TabCtrl.getSearchHelpText()}}</button>\n      </div>\n      <element-tree class="os-col os-grow os-full-height"\n                    is-publication="TabCtrl.isPublication"\n                    filter-mode="view.filters"\n                    help-message="filterHelpMessage"\n                    num-results="numberOfResults"\n                    is-empty-tree="isEmptyTree"\n                    view-mode="view.tabs"\n                    has-focus="hasFocus"\n                    clear-filters="TabCtrl.clearAllFilters()"\n                    on-select="setHighlightedTab(tab)"></element-tree>\n    </div>\n  </div>\n\n  \x3c!-- Element thumbnail --\x3e\n  <div class="element-thumbnail" ng-if="view.preview && numberOfResults > 0">\n    <div class="element-name d-flex align-items-center" data-bs-original-title="{{highlightedTab.getElementName()}}" overflow-tooltip="true">\n      <os-svg class="element-icon add-space-right" icon="{{highlightedTab.getIconSrc()}}"></os-svg>\n      {{highlightedTab.getElementName()}}\n    </div>\n    <os-thumbnail class="thumbnail-image"\n                  document-id="{{documentId}}"\n                  has-thumbnail="{{::highlightedTab.hasThumbnail()}}"\n                  workspace-id="{{workspaceId}}"\n                  version-id={{versionId}}\n                  element-id="{{highlightedTab.elementId}}"\n                  api-configuration="{{highlightedTab.getCachedConfigurationEncoded()}}"\n                  part-id="{{highlightedTab.getPartIdForThumbnail()}}"\n                  document-thumbnail-stamp="{{highlightedTab.getDocumentThumbnailStamp()}}"\n                  ideal-width="300"\n                  ideal-height="170"\n                  is-publication="{{TabCtrl.isPublication}}"\n                  fallback-image="{{highlightedTab.getDefaultIconSrc()}}"\n                  watch-changes="true">\n    </os-thumbnail>\n    <div class="collaborator-list">\n      <div class="collaborator-badge"\n            ng-repeat="collaborator in selectedTab.collaborators"\n            ng-style="{\'background-color\': collaborator.color}">\n        <span class="collaborator-name">{{collaborator.name}}</span>\n      </div>\n    </div>\n  </div>\n\n  \x3c!-- Footer --\x3e\n  <div class="document-panel-footer">\n    <span class="help-text ellipseOverflowText">\n      <span ng-show="hasFocus" ng-i18next="[html:i18next]({arrowKeyUp:\'↑\', arrowKeyDown:\'↓\'})<key>tab</key> or <key>__arrowKeyUp__</key><key>__arrowKeyDown__</key> to navigate"></span>\n      &emsp;\n      <span ng-show="hasFocus" ng-i18next="[html:i18next]({enterKey:\'↵\'})<key>__enterKey__</key> to open"></span>\n    </span>\n    <div class="os-row os-pin-right view-icons">\n        <os-svg class="view-icon footer-icon"\n              icon="view-preview"\n              ng-click="setViewState(\'preview\', \'toggle\')"\n              ng-class="{\'active\': view.preview}"\n              data-bs-original-title="{{(\'Toggle preview\' | i18next)}}"></os-svg>\n        <os-vue-help-link-component v-props="{helpContextKey: TabCtrl.helpContextKey}"></os-vue-help-link-component>\n    </div>\n  </div>\n</div>\n')}]),e.exports=n},75005:function(e,t,i){var n="/project/web/ts/tabBar/tabBar-template.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="os-tab-bar-content"\n  ng-controller="Woolsthorpe.TabBar.TabBarController as tabController"\n  oncontextmenu