ocumentElements">\n              </select>\n            </div>\n          </div>\n        </fieldset>\n        <fieldset class="form-group tab-types-field" ng-show="ctrl.shouldShowElementTypeSelector()">\n          <div class="form-field-container">\n            <div class="form-field-label">\n              <label>{{\'Tab types\' | i18next}}</label>\n            </div>\n            <div class="form-field-input">\n              <element-type-selector document-types="ctrl.elementTypeOptions"\n                                     selected-filters-changed="ctrl.elementTypeFiltersChanged()"\n              ></element-type-selector>\n            </div>\n          </div>\n        </fieldset>\n        <fieldset class="form-group modified-by-field">\n          <div class="form-field-container">\n            <div class="form-field-label">\n              <label>{{\'Modified by\' | i18next}}</label>\n            </div>\n            <div class="form-field-input">\n              <select class="form-control"\n                      id="user-filter"\n                      ng-model="ctrl.selectedUserFilter"\n                      ng-change="ctrl.userFilterChanged()"\n                      ng-options="userFilter.localName for userFilter in ctrl.userFilterOptions"\n              ></select>\n            </div>\n          </div>\n        </fieldset>\n        <fieldset class="form-group date-modified-field">\n          <div class="form-field-container">\n            <div class="form-field-label">\n              <label>{{\'Date modified\' | i18next}}</label>\n            </div>\n            <div class="form-field-input">\n              <div class="form-group form-group-for-advanced start-date-field">\n                <input type="datetime-local"\n                       name="startDate"\n                       ng-change="ctrl.startDateChanged()"\n                       class="form-control"\n                       data-bs-original-title="{{\'Start date\' | i18next}}"\n                       n