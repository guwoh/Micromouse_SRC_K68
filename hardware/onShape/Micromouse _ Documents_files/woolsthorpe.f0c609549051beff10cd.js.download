at house the connection information.\n    // At one point we had attempted to use a single mat4 to hold connection information, but there are compatibility\n    // issues with using matrices as attributes and varyings on different systems. (BEL-188540)\n    bool foundMultiple = getConnectionFromVectors(vContactTraction, vContactPairCoordinate,\n      contactColor, maxTraction, contactCount);\n\n    if (!foundMultiple) {\n        foundMultiple = getConnectionFromVectors(vContactTraction1, vContactPairCoordinate1,\n            contactColor, maxTraction, contactCount);\n    }\n\n    if (!foundMultiple) {\n        foundMultiple = getConnectionFromVectors(vContactTraction2, vContactPairCoordinate2,\n            contactColor, maxTraction, contactCount);\n    }\n\n    if (!foundMultiple) {\n        foundMultiple = getConnectionFromVectors(vContactTraction3, vContactPairCoordinate3,\n            contactColor, maxTraction, contactCount);\n    }\n\n    if (contactCount == 0.0) {\n        discard;\n    }\n\n    float alpha = clamp((maxTraction - uTractionContactThreshold) / (PERFECT_TRACTION - uTractionContactThreshold), 0.0, 1.0);\n    if ((uBlendTransparent > 0.0) != (alpha < 1.0)) {\n        discard;\n    }\n\n    vec4 outputColor;\n    outputColor.a = alpha;\n\n#ifdef DERIVATIVES_SUPPORTED\n    // A light from the right, up, behind direction at 0.5 power\n    vec3 directionalLight = vec3(0.288675, 0.288675, 0.288675);\n    float diffuseWeight = max(dot(normal, directionalLight), 0.0);\n    outputColor.rgb = (AMBIENT_FACTOR + diffuseWeight) * contactColor;\n#else\n    outputColor.rgb = contactColor;\n#endif\n\n    return outputColor;\n}\n'},60822:function(e,t){"use strict";t.Z='uniform float uCylinderRadius;\nuniform vec3 uCylinderAxisX;\nuniform vec3 uCylinderAxisY;\nuniform vec3 uCylinderAxisZ;\nuniform vec3 uCylinderOrigin;\nuniform mat4 uMVMatrix_fs;\nuniform float uThreadPitch;\nuniform float uThreadLength;\n\n{{{constants}}}\n\nfloat getCylinderUValue(vec3 normal, vec3 cylinderAxisX, vec3 cylinderAxisY)\n{\n    float dotNormalOnCylinderSide = (dot(normalize(cylinderAxisX), normalize(normal)) + 1.) / 4.;\n\n    // Use step function to differentiate between sides of the cylinder, then invert the result\n    // to ensure the threads have correct handedness.\n    float uValue = 1. - mix(dotNormalOnCylinderSide, 0.5 + (0.5 - dotNormalOnCylinderSide),\n        step(0.0, dot(normalize(cylinderAxisY), normal)) );\n    return uValue;\n}\n\nvec3 rotateAroundAxis(vec3 toRotate, vec3 axis, float angle)\n{\n    axis = normalize(axis);\n    float cosAngle = cos(angle);\n    float sinAngle = sin(angle);\n    return toRotate * cosAngle + cross(axis, toRotate) * sinAngle + axis * dot(axis, toRotate) * (1.0 - cosAngle);\n}\n\nvec3 getUpdatedNormal(vec3 normal, vec3 binormal, float threadVal)\n{\n    // upNormal and downNormal indicate the surface normals on either side of the thread geometry.\n    vec3 upNormal = rotateAroundAxis(normal, binormal, PI / -6.);\n    vec3 downNormal = rotateAroundAxis(normal, binormal, PI / 6.);\n\n    // normalBlend is the threshold of how the surface normals will be smoothed to avoid aliasing on the peak and valley\n    // of the thread. The thresholds indicate the transition points from one normal direction to the other, which are\n    // set based on ISO thread standards (which is also very similar to ANSI standards): https://en.wikipedia.org/wiki/ISO_metric_screw_thread\n    float normalBlend = 1. / 8.;\n\n    vec3 mixed = normal;\n    mixed = mix(mixed, downNormal, smoothstep(0., normalBlend, threadVal));\n    mixed = mix(mixed, normal, smoothstep(.5 - normalBlend, .5, threadVal));\n    mixed = mix(mixed, upNormal, smoothstep(.5, .5 + normalBlend, threadVal));\n    mixed = mix(mixed, normal, smoothstep(1. - normalBlend, 1., threadVal));\n    return normalize(mixed);\n}\n\nvec3 getThreadedNormal(vec3 position, vec3 normal)\n{\n    mat3 transposeMatrix = mat3(uMVMatrix_fs);\n\n    vec3 cylinderAxisX = normalize(transposeMatrix * uCylinderAxisX);\n    vec3 cylinderAxisY = normalize(transposeMatrix * uCylinderAxisY);\n    vec3 cylinderAxisZ = normalize(transposeMatrix * uCylinderAxisZ);\n\n    vec3 cylinderOrigin = (uMVMatrix_fs * vec4(uCylinderOrigin, 1.0)).xyz;\n\n    // These values represent the uv coordinates of the fragment in relation to the threaded cylinder. clyinderU has a\n    // range of 0-1 (1 represents 2PI radians). cylinderV is the distance from the fragment to the origin of the thread.\n    float cylinderU = getCylinderUValue(normal, cylinderAxisX, cylinderAxisY);\n    float cylinderV = dot(cylinderAxisZ, position - cylinderOrigin);\n\n    // threadVal represents where the current pixel is in "threadspace", a 0-1 value covering the entire profile of\n    // the thread being rendered. Values of 0 and 1 represent the peak of the thread, .5 is the valley in between these\n    // peaks. 0-1 encapsulates the antire "pitch" of the thread.\n    float threadVal = mod(cylinderV, uThreadPitch) / uThreadPitch;\n\n    // Adjust the thread value by the relative location around the U coordinate of the cylinder. This achieves the spiral\n    // effect.\n    threadVal = fract(threadVal + cylinderU);\n\n    vec3 binormal = normalize(cross(cylinderAxisZ, normal));\n    // Adjust the provided vertex normal around the binormal according to where the pixel is in thread space. Use the\n    // adjusted normal to generate the light fragment.\n    vec3 threadedNormal = getUpdatedNormal(normal, binormal, threadVal);\n\n    float lengthBlendThreshold = uThreadPitch;\n    threadedNormal = mix(threadedNormal, normal, smoothstep(uThreadLength - lengthBlendThreshold,\n        uThreadLength, cylinderV));\n\n    return threadedNormal;\n}\n\n\n'},94420:function(e,t){"use strict";t.Z="varying highp vec3 vPosition;\nvarying highp vec3 vModelPosition;\nvarying lowp vec3 vNormal;\nvarying lowp float vOpacity;\n\nuniform sampler2D uAmbientTexture;\n\nuniform mat4 uDecalProjection;\nuniform mat3 uUvTransform;\nuniform float uCylinderRadius;\n\n{{{constants}}}\n\nvec4 getDecalColor() {\n    vec2 projectedUv;\n    if (uCylinderRadius > 0.0) {\n      vec3 vectorToCylinderOrigin = vModelPosition - uDecalProjection[3].xyz;\n      vec3 directionFromCylinderAxis = normalize(vectorToCylinderOrigin);\n      float theta = atan(dot(uDecalProjection[1].xyz, directionFromCylinderAxis), dot(uDecalProjection[0].xyz, directionFromCylinderAxis));\n\n      // Depending on how the cylinder UV is offset, we need to adjust theta such that\n      // it makes a continuous U value as it crosses it crosses PI.\n      if (uUvTransform[2][0] <= 0.0 && theta < 0.0) {\n        theta += TWO_PI;\n      } else if (uUvTransform[2][0] >= 1.0 && theta > 0.0) {\n        theta -= TWO_PI;\n      }\n\n      projectedUv[0] = theta * uCylinderRadius;\n      projectedUv[1] = dot(vectorToCylinderOrigin, uDecalProjection[2].xyz);\n    } else {\n      projectedUv = (uDecalProjection * vec4(vModelPosition, 1.0)).xy;\n    }\n\n    vec3 textureCoordinate = uUvTransform * vec3(projectedUv, 1.0);\n\n    if (textureCoordinate.x < 0.0 || textureCoordinate.x > 1.0 ||\n      textureCoordinate.y < 0.0 || textureCoordinate.y > 1.0) {\n        discard;\n    }\n\n    textureCoordinate.y = 1.0 - textureCoordinate.y;\n\n    return texture2D(uAmbientTexture, textureCoordinate.xy);\n}"},10348:function(e,t){"use strict";t.Z="\n#ifdef GL_FRAGMENT_PRECISION_HIGH\n\n#ifndef TWO_TO_TWENTY_FOUR\n#define TWO_TO_TWENTY_FOUR 16777216.0\n#endif\n\n//We want to take advantage of high precision, when available, to avoid losing fidelity in depth;\nvec4 packFloatIntoRGBA(highp float f) {\n    vec4 color;\n    color.b = floor(f / 256.0 / 256.0);\n    color.g = floor((f - color.b * 256.0 * 256.0) / 256.0);\n    color.r = floor(f - color.b * 256.0 * 256.0 - color.g * 256.0);\n    color.a = 255.0; //We'll just put one in the alpha value\n    //Normalize the value for color output\n    return color / 255.0;\n}\n\nvec4 packDepthIntoRGBA(highp float pointZ, highp float pointW) {\n    //Convert the depth into a value between 0 and (2^24-1).\n    //8388608.0 is 2^24 / 2.  This is an attempt to convert\n    //the number into the desired range without losing too\n    //much precision.\n    highp float f = (8388608.0 / pointW) * pointZ + 8388607.0;\n    return packFloatIntoRGBA(f);\n}\n\nvec4 packNormalizedFloatIntoRGBA(highp float f) {\n    return packFloatIntoRGBA(f * (TWO_TO_TWENTY_FOUR - 1.0));\n}\n\n#else\n\n#ifndef TWO_TO_FOURTEEN\n#define TWO_TO_FOURTEEN 16384.0\n#endif\n\nvec4 packFloatIntoRGBA(float f) {\n    vec4 color;\n    color.b = 0.0;\n    color.g = floor(f / 256.0);\n    color.r = floor(f - color.g * 256.0);\n    color.a = 255.0; //We'll just put one in the alpha value\n    //Normalize the value for color output\n    return color / 255.0;\n}\n\nvec4 packDepthIntoRGBA(float pointZ, float pointW) {\n    //If we're operating in medium precision mode, the best we can do is get a number between 0 and 2^14 - 1.\n    float f = (8192.0 / pointW) * pointZ + 8191.0;\n    return packFloatIntoRGBA(f);\n}\n\nvec4 packNormalizedFloatIntoRGBA(highp float f) {\n    return packFloatIntoRGBA(f * (TWO_TO_FOURTEEN - 1.0));\n}\n\n#endif\n\nvec2 encodeNormal(vec3 normal)\n{\n    // http://aras-p.info/texts/CompactNormalStorage.html#method04spheremap\n    float f = sqrt(8.0 * normal.z + 8.0);\n    return normal.xy / f + 0.5;\n}\n\n#ifdef GL_FRAGMENT_PRECISION_HIGH\nvec2 encodeDepth(highp float depth) {\n    highp float d = 65535.0 * depth;\n#else\nvec2 encodeDepth(float depth) {\n    float d = 16383.0 * depth;\n#endif\n    float x = floor(d / 256.0) / 255.0;\n    float y = mod(d, 256.0) / 255.0;\n    return vec2(x, y);\n}\n\n#ifdef GL_FRAGMENT_PRECISION_HIGH\nhighp float decodeDepth(highp vec2 encoded) {\n  // We want to calculate:  (256 * encoded[0] * 255 + encoded[1] * 255) / (2^16-1)   This reduces to:\n  highp float d = (256.0 * encoded[0] + encoded[1]) / 257.0;\n  return d;\n}\n#else\nfloat decodeDepth(vec2 encoded) {\n  // For medium precision, there will only be six bits of precision in the first byte.  This means that the range\n  // of possible numbers will be between 0 and 63.\n  float d = 255.0 * ((256.0 * encoded[0] + encoded[1]) / 16383.0);\n  return d;\n}\n#endif\n\nvec3 decodeNormal(vec2 encoded)\n{\n    // http://aras-p.info/texts/CompactNormalStorage.html#method04spheremap\n    vec2 e = 4.0 * encoded - 2.0;\n    float f = dot(e, e);\n    float g = sqrt(1.0 - f / 4.0);\n    vec3 n;\n    n.xy = e * g;\n    n.z = 1.0 - f / 2.0;\n    return n;\n}\n\nvec3 flipNormalTowardViewer(vec3 normal, vec3 position, mat4 projMatrix)\n{\n    float signPerspective = sign(dot(normal, -position));\n    float signOrthographic = sign(normal.z);\n    float sign = projMatrix[3][3] * signOrthographic - projMatrix[2][3] * signPerspective;\n\n    return sign * normal;\n}\n\n"},16256:function(e,t){"use strict";t.Z="// This defines the width of the fall-off around lines' edges.  This fall-off provides anti-aliasing.\nuniform mediump float uLineFilterWidth;\nuniform mediump float uBackgroundMixProportion;\nuniform lowp vec4 uBackgroundColor;\n\nbool isGap(highp float edgeLength, vec4 lineStipple) {\n  // line stipple defines 4 intervals, 2 of which are gaps, where fragments need to be discarded\n  float gapStart1 = lineStipple.x;\n  float gapStop1 = gapStart1 + lineStipple.y;\n  float gapStart2 = gapStop1 + lineStipple.z;\n  float stippleLength = gapStart2 + lineStipple.w;\n\n  float stippleDistance = mod(edgeLength, stippleLength + impulse(0.0, stippleLength));\n  return (stippleDistance > gapStart1 && stippleDistance < gapStop1) ||\n         (stippleDistance > gapStart2 && stippleDistance < stippleLength);\n}\n\nvoid discardIfIsGap(highp float edgeLength, vec4 lineStipple) {\n  if (isGap(edgeLength, lineStipple)) {\n    discard;\n  }\n}\n\nfloat getStippleAlphaMultiplier(highp float edgeLength, vec4 lineStipple) {\n  return float(!isGap(edgeLength, lineStipple));\n}\n\nvec4 edgeColor(vec4 inputColor, float lineWidth, float filterDistance) {\n  // apply edge filter\n  float opacityScale = smoothstep(0.0, uLineFilterWidth, 0.5 * (lineWidth + uLineFilterWidth) - abs(filterDistance));\n\n  vec4 color = inputColor;\n  color.rgb = mix(inputColor.rgb, uBackgroundColor.rgb, uBackgroundMixProportion);\n  color.a *= opacityScale;\n  return color;\n}\n"},17994:function(e,t){"use strict";t.Z="attribute vec4 aEdgeData;  // XYZ = direction, abs(W)-1 = length, length(XYZ) = corner index, sign(W) = infinite if negative\nuniform float uUsePrimitiveLines;\n\nfloat edgeCornerIndex() {\n  return round(length(aEdgeData.xyz));\n}\n\nfloat edgeNormalDirectionFlag(float cornerIndex) {\n  return -impulse(1.0, cornerIndex) - impulse(2.0, cornerIndex) + impulse(3.0, cornerIndex) + impulse(4.0, cornerIndex);\n}\n\nfloat edgeTangentDirectionFlag(float cornerIndex) {\n  return -impulse(1.0, cornerIndex) + impulse(2.0, cornerIndex) + impulse(3.0, cornerIndex) - impulse(4.0, cornerIndex);\n}\n\nbool edgeIsInfinite() {\n  return aEdgeData.a < 0.0;\n}\n\nfloat edgeLength() {\n  return abs(aEdgeData.a) - 1.0;\n}\n\nvoid computeTangentAndNormalOffsets(mat4 modelViewMatrix, vec4 projectedPosition, float lineWidth, out vec2 tangentOffset, out vec2 normalOffset) {\n  vec3 edgeDirection = normalize(aEdgeData.xyz);\n  bool isInfinite = edgeIsInfinite();\n  float cornerIndex = edgeCornerIndex();\n  float normalDirectionFlag = edgeNormalDirectionFlag(cornerIndex);\n  float tangentDirectionFlag = edgeTangentDirectionFlag(cornerIndex);\n\n  vec4 projectedDirection = uPMatrix * (modelViewMatrix * vec4(edgeDirection, 0.0));\n\n  // compute tangent and normal offsets that will make the line quad\n  tangentOffset = vec2(0.0, 0.0);\n  vec2 screenNormal = vec2(0.0, 0.0);\n  bool isOrthographic = (uPMatrix[3][3] > 0.0);\n  if (isOrthographic) {\n    // orthographic projection is simpler\n\n    screenNormal = normalize(uViewport.wz * vec2(-projectedDirection.y, projectedDirection.x));\n\n    // make infinite line\n    if (isInfinite) {\n      tangentOffset = tangentDirectionFlag * (length(projectedPosition.xy) + 2.0) * normalize(projectedDirection.xy);\n    }\n  } else {\n    // perspective projection is trickier\n\n    float flip = sign(projectedPosition.w + projectedDirection.w);\n    vec4 projectedEnd = projectedPosition + flip * projectedDirection;\n    vec2 screenTangent = flip * normalize(uViewport.zw * (projectedEnd.xy / projectedEnd.w - projectedPosition.xy / projectedPosition.w));\n    screenNormal = vec2(-screenTangent.y, screenTangent.x);\n\n    // make infinite line\n    if (isInfinite) {\n      vec2 screenPosition = (projectedPosition.xy / projectedPosition.w + vec2(1.0, 1.0)) * uViewport.zw;\n      vec2 screenOffset = tangentDirectionFlag * (length(screenPosition) + length(uViewport.zw)) * screenTangent;\n      tangentOffset = projectedPosition.w * (screenOffset / uViewport.zw);\n    }\n  }\n\n  // offset the projected vertex\n  normalOffset = (lineWidth * normalDirectionFlag * projectedPosition.w) * (screenNormal / uViewport.zw);\n}\n"},24412:function(e,t){"use strict";t.Z="{{{constants}}}\n\n#ifndef UPMATRIX_DEFINE\nuniform mat4 uPMatrix_fs;\n#define UPMATRIX_DEFINE\n#endif\n\nuniform float uStripeCount;\nuniform float uStripeRotation;\nuniform float uFilterWidth;\nuniform float uRespectOrthographic;\n\nconst float VERTICAL_OFFSET = 0.02;\n\nvec4 zebraStripeFragment(highp vec3 position, vec3 normal) {\n  bool isOrthographic = (uPMatrix_fs[3][3] > 0.0);\n\n  // pick a look vector, -z for orthogonal and eye(origin) -> position for perpective\n  vec3 look = (isOrthographic && bool(uRespectOrthographic)) ? vec3(0.0, 0.0, -1.0) : normalize(position.xyz);\n\n  // reflect about the surface normal\n  vec3 reflection = normalize(reflect(look, normalize(normal)));\n\n  // calculate vertical inclination of reflection, clamping to avoid dots at 0 and pi\n  float xFactor = sin(uStripeRotation);\n  float yFactor = cos(uStripeRotation);\n  float rotatedComponent = acos(xFactor * reflection.x + yFactor * reflection.y);\n\n  float inclination = clamp(rotatedComponent, VERTICAL_OFFSET, PI - VERTICAL_OFFSET);\n\n  // create sawtooth function\n  float bandHeight = PI / uStripeCount;\n  float stripe = mod(inclination, 2.0 * bandHeight);\n\n  // transform the function into a sine wave\n  stripe = sin(stripe * uStripeCount);\n\n  // transform sine to solid stripes with smooth transitions\n  stripe = smoothstep(-uFilterWidth, uFilterWidth, stripe);\n\n  return clamp(vec4(stripe, stripe, stripe, 1), 0.0, 1.0);\n}\n"},47744:function(e,t){"use strict";t.Z="#ifndef UPMATRIX_DEFINE\nuniform mat4 uPMatrix_fs;\n#define UPMATRIX_DEFINE\n#endif\n\nuniform vec4 uViewport;\n\nuniform float uShininess;\nuniform sampler2D uAmbientTexture;\nuniform float uAmbientTextureFactor;\n\nuniform sampler2D uOcclusionMap;\nuniform float uOcclusionFactor;\n\nuniform bool uApplyTranslucentAlphaToAll;\n\n{{{getNormalSign}}}\n\nvec4 lightFragment(vec3 ambient, vec3 diffuse, vec3 specular, float opacity,\n                   vec3 position, vec3 normal, vec2 textureCoordinate, vec4 fragCoord) {\n    if (uAmbientTextureFactor > 0.0) {\n      vec4 sample = texture2D(uAmbientTexture, textureCoordinate);\n      ambient = mix(ambient, sample.rgb, uAmbientTextureFactor);\n\n      // Since these textures are really only used for labels right now, the translucent rendering mode\n      // needs to ignore them.\n      // TODO: update how textures are handled by the translucent rendering mode if we start using them on part bodies\n      opacity = sample.a * mix(opacity, 1.0, float(uApplyTranslucentAlphaToAll));\n    }\n\n    vec4 fragColor = vec4(ambient, opacity);\n\n    bool isLit = (dot(diffuse, diffuse) + dot(specular, specular) > 0.0);\n    if (isLit) {\n      vec3 normalDirection = normalize(normal);\n\n      normalDirection *= getNormalSign();\n\n      vec3 lightDiffuse = vec3(0.5, 0.5, 0.5);\n      vec3 lightSpecular = vec3(1.0, 1.0, 1.0);\n      vec3 lightDirection = normalize(vec3(1.0, 1.0, 1.0));\n\n      float diffuseWeight = max(dot(normalDirection, lightDirection), 0.0);\n\n      vec3 eyeDirection = normalize(-vPosition);\n      vec3 halfVector = normalize(lightDirection + eyeDirection);\n      float specularWeight = pow(max(dot(normalDirection, halfVector), 0.0), uShininess);\n\n      fragColor.rgb += diffuseWeight * lightDiffuse * diffuse\n                     + specularWeight * lightSpecular * specular;\n    }\n    if (uOcclusionFactor > 0.0) {\n      vec2 uv = (fragCoord.xy - uViewport.xy) / uViewport.zw;\n      float occlusion = texture2D(uOcclusionMap, uv).r;\n      fragColor.rgb *= pow(1.0 - occlusion, uOcclusionFactor);\n    }\n\n    return fragColor;\n}"},82686:function(e,t){"use strict";t.Z="#ifdef DERIVATIVES_SUPPORTED\n#extension GL_OES_standard_derivatives : enable\n#endif\n\n#ifdef GL_ES\nprecision mediump float;\n#endif\n\n{{{contactVisualizationFunctions}}}\n{{{weightFunctions}}}\n\nvoid main(void) {\n    vec4 contactColor = getContactColorOrDiscard();\n    gl_FragColor = getAccumulationColor(contactColor);\n}\n"},58709:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying vec3 vPosition;\nvarying lowp vec3 vNormal;\nvarying mediump vec2 vTextureCoordinate;\nvarying lowp vec3 vAmbient;\nvarying lowp vec3 vDiffuse;\nvarying lowp vec3 vSpecular;\nvarying lowp float vOpacity;\n\n{{{weightFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n{{{cosmeticThreadFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec3 threadedNormal = getThreadedNormal(vPosition, vNormal);\n    vec4 baseColor = lightFragment(vAmbient, vDiffuse, vSpecular, vOpacity, vPosition, threadedNormal, vTextureCoordinate, gl_FragCoord);\n\n    gl_FragColor = getAccumulationColor(baseColor);\n}"},58296:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{decalFunctions}}}\n{{{weightFunctions}}}\n\nuniform bool uApplyTranslucentAlphaToAll;\nuniform bool uOutsideIsolation;\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec4 color = getDecalColor();\n\n    if (uApplyTranslucentAlphaToAll || uOutsideIsolation) {\n      color.a *= vOpacity;\n    } else if (color.a >= 1.0) {\n      // OIT decal passes only handle transparent fragments\n      discard;\n    }\n\n    gl_FragColor = getAccumulationColor(color);\n}\n"},88081:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying lowp vec4 vColor;\nvarying mediump vec4 vLineStipple;\nvarying mediump float vLineWidth;\nvarying mediump float vDistance;\nvarying highp float vLength;\nvarying highp vec3 vPosition;\n\n{{{weightFunctions}}}\n{{{edgeFragmentUtilityFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n  DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n  vec4 color = edgeColor(vColor, vLineWidth, vDistance);\n  color.a = color.a * getStippleAlphaMultiplier(vLength, vLineStipple);\n  gl_FragColor = getAccumulationColor(color);\n}\n"},74139:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform mediump vec4 uViewport;\n\nvarying lowp vec4 vColor;\nvarying mediump float vLineWidth;\nvarying mediump float vDistance;\nvarying mediump float vLength;\nvarying mediump float vSilhouetteTest;\nvarying highp vec3 vPosition;\nvarying mediump vec4 vLineStipple;\n\n{{{weightFunctions}}}\n{{{edgeFragmentUtilityFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n  if (vSilhouetteTest < 0.0) {\n    discard;\n  }\n\n  DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n  vec4 color = edgeColor(vColor, vLineWidth, vDistance);\n  gl_FragColor = getAccumulationColor(color);\n}\n"},59262:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying vec3 vPosition;\nvarying lowp vec3 vNormal;\nvarying mediump vec2 vTextureCoordinate;\nvarying lowp vec3 vAmbient;\nvarying lowp vec3 vDiffuse;\nvarying lowp vec3 vSpecular;\nvarying lowp float vOpacity;\n\n{{{weightFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec4 baseColor = lightFragment(vAmbient, vDiffuse, vSpecular, vOpacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n    gl_FragColor = getAccumulationColor(baseColor);\n}\n"},49884:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\n/**\n * Compositing for Weighted Blended Order-Independent Transparency. See:\n * - http://jcgt.org/published/0002/02/09/\n * - http://casual-effects.blogspot.com/2014/03/weighted-blended-order-independent.html\n */\n\nuniform sampler2D uAccumulationBuffer;\nuniform sampler2D uRevealageBuffer;\n\nvarying vec2 vTextureCoordinate;\n\nvoid main()\n{\n    vec4 accum = texture2D(uAccumulationBuffer, vTextureCoordinate);\n    float r = texture2D(uRevealageBuffer, vTextureCoordinate).r;\n    vec4 transparent = vec4(vec3((accum.rgb / max(accum.a, 0.0001))), 1.0 - r);\n\n    gl_FragColor = transparent;\n}\n"},21336:function(e,t){"use strict";t.Z="#ifdef DERIVATIVES_SUPPORTED\n#extension GL_OES_standard_derivatives : enable\n#endif\n\n#ifdef GL_ES\nprecision mediump float;\n#endif\n\n{{{contactVisualizationFunctions}}}\n\nvoid main(void) {\n    vec4 contactColor = getContactColorOrDiscard();\n    gl_FragColor = vec4(contactColor.a);\n}\n"},28220:function(e,t){"use strict";t.Z="{{{fs-OITRevealage}}}"},23331:function(e,t){"use strict";t.Z="#ifdef DERIVATIVES_SUPPORTED\n#extension GL_OES_standard_derivatives : enable\n#endif\n\n#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform bool uApplyTranslucentAlphaToAll;\nuniform bool uOutsideIsolation;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{decalFunctions}}}\n{{{weightFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec4 color = getDecalColor();\n\n    float alpha = color.a;\n    if (uApplyTranslucentAlphaToAll || uOutsideIsolation) {\n      alpha *= vOpacity;\n    } else if (color.a >= 1.0) {\n      // OIT decal passes only handle transparent fragments\n      discard;\n    }\n\n    gl_FragColor = vec4(alpha);\n}\n"},68592:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform sampler2D uAmbientTexture;\nuniform float uAmbientTextureFactor;\nuniform bool uApplyTranslucentAlphaToAll;\n\nvarying vec3 vPosition;\nvarying mediump vec2 vTextureCoordinate;\nvarying lowp float vOpacity;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    float opacity = vOpacity;\n\n    if (uAmbientTextureFactor > 0.0) {\n        vec4 sample = texture2D(uAmbientTexture, vTextureCoordinate);\n        // Since these textures are really only used for labels right now, the translucent rendering mode\n        // needs to ignore them.\n        // TODO: update how textures are handled by the translucent rendering mode if we start using them on part bodies\n        opacity = sample.a * mix(opacity, 1.0, float(uApplyTranslucentAlphaToAll));\n    }\n\n    gl_FragColor = vec4(opacity);\n}\n"},99660:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform vec4 uLineColor;\n\nvarying vec3 vNonOffsetPosition;\nvarying float vClampedNdotV;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    if (vClampedNdotV == 0.0) {\n      discard;\n    }\n\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vNonOffsetPosition);\n\n    gl_FragColor = uLineColor;\n}\n"},64148:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\nvarying vec2 vTextureCoordinate;\n\nuniform sampler2D uTexture;\n\n// based on the multiplier used in vs-endcapMask-faces.glsl\n#define COLOR_TOLERANCE 0.001\n\nvoid main(void) {\n    vec4 sample = abs(texture2D(uTexture, vTextureCoordinate));\n    if (sample.r > COLOR_TOLERANCE || sample.g > COLOR_TOLERANCE || sample.b > COLOR_TOLERANCE) {\n      gl_FragColor = vec4(1.0, 0.0, 0.0, 1.0);\n    } else {\n      gl_FragColor = vec4(0.0, 0.0, 0.0, 0.0);\n    }\n}\n"},66750:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying vec2 vTextureCoordinate;\n\nuniform sampler2D uOverBufferPass;\nuniform float uBlend;\n\nvoid main(void) {\n  vec4 overSample = texture2D(uOverBufferPass, vTextureCoordinate);\n\n  gl_FragColor = overSample;\n  gl_FragColor.a = uBlend;\n}\n"},17612:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision highp float;\n#endif\n\nvarying vec2 vTextureCoordinate;\n\nuniform sampler2D uPickBuffer;\n\n// Smooth HSV to RGB conversion\n// Copyright 2014 Inigo Quilez\n// Used under MIT License\n// See https://www.shadertoy.com/view/MsS3Wc\nvec3 hsv2rgb_smooth( in vec3 c )\n{\n    vec3 rgb = clamp( abs(mod(c.x*6.0+vec3(0.0,4.0,2.0),6.0)-3.0)-1.0, 0.0, 1.0 );\n\n    rgb = rgb*rgb*(3.0-2.0*rgb); // cubic smoothing\n\n    return c.z * mix( vec3(1.0), rgb, c.y);\n}\n\nvec4 hashColor(vec4 pickColor) {\n    // Add the components of the pick id to get a number in the range 0-4\n    float index = pickColor.r + pickColor.g + pickColor.b + pickColor.a;\n    if (index == 0.0) {\n      return vec4(0.0, 0.0, 0.0, 1.0);\n    }\n\n#define modulus 64.0\n\n    // Spread out the range of possible values from 0-4 to a larger range, then mod it to differentiate the number from\n    // other values that were close to it in the 0-4 range.\n    float hashed = mod(index * 12312.0, modulus);\n\n    // Finally, put the hashed number into a 0-1 range and use it for the hue channel in a hsv->rgb function\n    vec3 rgb = hsv2rgb_smooth(vec3(hashed / modulus, 1.0, 1.0));\n    return vec4(rgb, 1.0);\n}\n\nvoid main(void) {\n    vec4 color = texture2D(uPickBuffer, vTextureCoordinate);\n    gl_FragColor = hashColor(color);\n}\n"},13679:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying vec3 vPositionForSection;\n\n#ifdef GL_FRAGMENT_PRECISION_HIGH\n//We want to take advantage of high precision, when available, to avoid losing fidelity in depth;\nvarying highp vec2 vPositionZW;\n#else\nvarying mediump vec2 vPositionZW;\n#endif\n\n{{{depthNormalFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPositionForSection);\n\n    gl_FragColor = packDepthIntoRGBA(vPositionZW[0], vPositionZW[1]);\n}"},20584:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying vec3 vPositionForSection;\n\n#ifdef GL_FRAGMENT_PRECISION_HIGH\n//We want to take advantage of high precision, when available, to avoid losing fidelity in depth;\nvarying highp vec2 vPositionZW;\n#else\nvarying mediump vec2 vPositionZW;\n#endif\n\n{{{depthNormalFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPositionForSection);\n\n    gl_FragColor = packDepthIntoRGBA(vPositionZW[0], vPositionZW[1]);\n}"},71442:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying vec3 vPositionForSection;\n\n#ifdef GL_FRAGMENT_PRECISION_HIGH\n//We want to take advantage of high precision, when available, to avoid losing fidelity in depth;\nvarying highp vec2 vPositionZW;\n#else\nvarying mediump vec2 vPositionZW;\n#endif\n\n{{{depthNormalFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPositionForSection);\n\n    gl_FragColor = packDepthIntoRGBA(vPositionZW[0], vPositionZW[1]);\n}"},53216:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform vec3 uPullDirection;\n\nvarying vec3 vModelNormal;\nvarying vec3 vCameraPosition;\n\n{{{constants}}}\n{{{depthNormalFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vCameraPosition);\n\n    float angle = acos(dot(normalize(vModelNormal), uPullDirection)); // in range [0, pi]\n    angle /= PI;\n    gl_FragColor = packNormalizedFloatIntoRGBA(angle);\n}\n"},68732:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying highp vec3 vPosition;\n\nvoid main(void) {\n    gl_FragColor = vec4(gl_FragCoord.z, gl_FragCoord.z, 0.0, 1.0);\n}\n"},58802:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\n#ifndef DRAFT_TOLERANCE\n#define DRAFT_TOLERANCE 0.0001\n#endif\n\nvarying highp vec3 vPosition;\nvarying highp vec3 vWorldPosition;\nvarying lowp vec3 vNormal;\nvarying mediump vec2 vTextureCoordinate;\nvarying lowp vec3 vAmbient;\nvarying lowp vec3 vDiffuse;\nvarying lowp vec3 vSpecular;\nvarying lowp float vOpacity;\n\nuniform mediump vec3 uDraftAnalysisDirection;\nuniform mediump float uMinimumDraftAngle;\nuniform mediump int uDoDraftAnalysis;\n\nuniform sampler2D uDraftShadowMap;\nuniform mediump mat4 uPMVMatrixWith;\nuniform mediump mat4 uPMVMatrixAgainst;\nuniform mediump float uDraftShadowMapPixelWidth;\nuniform mediump float uDraftShadowMapPixelHeight;\n\nuniform mediump vec4 uSteepDraftColor;\nuniform int uShowUndercut;\nuniform mediump vec4 uUndercutColor;\nuniform mediump vec4 uWithDirectionColor;\nuniform mediump vec4 uAgainstDirectionColor;\n\n{{{constants}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n\n// Returns vec4(normalized x position in [0, 1], normalized y position in [0, 1], depth of this fragment)\nvec3 sampleLocation(mat4 matrix) {\n    vec4 position = matrix * vec4(vWorldPosition, 1.0);\n    vec3 positionInNdcSpace = (1.0 / position.w) * vec3(position);\n    return 0.5 * positionInNdcSpace + 0.5;\n}\n\n\nfloat getCenterUndercutColorWeightSteep(float normalDotDraftDirection) {\n// Apply a larger sampling radius on steep fragments, since there tend to be more areas on them\n#define FILTER_RADIUS 3.0\n// Since there are more errors on such fragments, we have a fairly large sample bias factor to increase the number\n// of samples that need to be considered undercut before shading them as such\n#define SAMPLE_BIAS_FACTOR 0.75\n{{{undercutWeightFunction}}}\n}\n\nfloat getCenterUndercutColorWeight(float normalDotDraftDirection) {\n#undef FILTER_RADIUS\n#undef SAMPLE_BIAS_FACTOR\n// We use a smaller radius for oblique fragments in order to increase rendering efficiency\n#define FILTER_RADIUS 1.0\n// We can use also use a lower sample bias threshold\n#define SAMPLE_BIAS_FACTOR 0.5\n{{{undercutWeightFunction}}}\n}\n\n// If the fragment is steeper than this value relative to the pull direction, than we will take more samples to\n// apply a large filter around the fragment location.  This is needed because there could be a large amount of\n// variance between samples that are orthogonal to the cut direction.  (See BEL-75539, BEL-76191, for example)\n// 0.0871557 = cos(85 degrees)\n#define STEEP_UNDERCUT_THRESHOLD  0.0871557\n\nfloat getUndercutColorWeight(vec3 normal) {\n  float normalDotDraftDirection = abs(dot(uDraftAnalysisDirection, normal));\n  if (normalDotDraftDirection < STEEP_UNDERCUT_THRESHOLD) {\n    return getCenterUndercutColorWeightSteep(normalDotDraftDirection);\n  } else {\n    return getCenterUndercutColorWeight(normalDotDraftDirection);\n  }\n}\n\nvec4 getDraftColor(vec3 normal) {\n  float draft = acos(dot(uDraftAnalysisDirection, normal));\n  bool passesDraft = !(PI_2 + DRAFT_TOLERANCE - uMinimumDraftAngle < draft && draft < PI_2 - DRAFT_TOLERANCE + uMinimumDraftAngle);\n  if (!passesDraft) {\n    return uSteepDraftColor;\n  } else if (draft - DRAFT_TOLERANCE < PI_2) {\n    return uWithDirectionColor;\n  } else {\n    return uAgainstDirectionColor;\n  }\n}\n\nvec4 getLitColor() {\n  return lightFragment(vAmbient, vDiffuse, vSpecular, vOpacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    if (uDoDraftAnalysis == 0) {\n      gl_FragColor = getLitColor();\n    } else {\n      vec3 normal = normalize(vNormal);\n      vec4 color = getDraftColor(normal * getNormalSign());\n      if (uShowUndercut != 0) {\n        color = mix(color, uUndercutColor, getUndercutColorWeight(normal));\n      }\n      gl_FragColor = color;\n    }\n}\n"},85847:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying lowp vec4 vColor;\nvarying mediump vec4 vLineStipple;\nvarying mediump float vLineWidth;\nvarying mediump float vDistance;\nvarying highp float vLength;\nvarying highp vec3 vPosition;\n\n{{{utilityFunctions}}}\n{{{edgeFragmentUtilityFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n  DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n  gl_FragColor = edgeColor(vColor, vLineWidth, vDistance);\n  gl_FragColor.a = gl_FragColor.a * getStippleAlphaMultiplier(vLength, vLineStipple);\n}\n"},89330:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform vec4 uViewport;\nuniform sampler2D uEndcapMaskTexture;\nuniform sampler2D uEdgeDetectTexture;\nuniform vec4 uPlaneSelector;\n\nvarying vec3 vPosition;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{depthNormalFunctions}}}\n{{{sectionPlaneEndcapMedianFilter}}}\n\nvec2 maskTextureCoordinates(vec2 screenCoordinates) {\n    vec2 ndc;\n    ndc.x = screenCoordinates.x / uViewport.z;\n    ndc.y = screenCoordinates.y / uViewport.w;\n    return ndc;\n}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_ALL_BUT_ONE_SECTION_PLANE_CLIPPING_TEST(vPosition, uPlaneSelector);\n\n    vec4 sample0 = texture2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy + vec2(-1.0, 0.0)));\n    vec4 sample1 = texture2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy));\n    vec4 sample2 = texture2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy + vec2(1.0, 0.0)));\n\n    vec4 selectedSample = medianFilterEndcapSamples(sample0, sample1, sample2);\n    float edgeAlpha = texture2D(uEdgeDetectTexture, maskTextureCoordinates(gl_FragCoord.xy)).a;\n\n    // This test uses a soft threshold to deal with possible numerical imprecision where adding and subtracting\n    // the same values doesn't result in a zero. The threshold value is chosen to be an invisible alpha level.\n    if (selectedSample.a < 0.001) {\n        if (edgeAlpha > 0.01) {\n            gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0);\n        } else {\n            discard;\n        }\n    } else {\n        gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0);\n    }\n}\n"},96670:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform vec4 uViewport;\nuniform sampler2D uEndcapMaskTexture;\nuniform sampler2D uEdgeDetectTexture;\nuniform float uDiscardPatternBackground;\nuniform vec4 uPlaneSelector;\n\nvarying vec3 vPosition;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{sectionPlaneEndcapPatternFunctions}}}\n{{{sectionPlaneEndcapMedianFilter}}}\n\nvec2 maskTextureCoordinates(vec2 screenCoordinates) {\n    vec2 ndc;\n    ndc.x = screenCoordinates.x / uViewport.z;\n    ndc.y = screenCoordinates.y / uViewport.w;\n    return ndc;\n}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_ALL_BUT_ONE_SECTION_PLANE_CLIPPING_TEST(vPosition, uPlaneSelector);\n\n    vec4 sample0 = texture2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy + vec2(-1.0, 0.0)));\n    vec4 sample1 = texture2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy));\n    vec4 sample2 = texture2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy + vec2(1.0, 0.0)));\n\n    vec4 selectedSample = medianFilterEndcapSamples(sample0, sample1, sample2);\n    float edgeAlpha = texture2D(uEdgeDetectTexture, maskTextureCoordinates(gl_FragCoord.xy)).a;\n\n    float hatchingOpacity;\n    vec4 patternColor = getSectionPlaneColor(uPlaneSelector, vPosition, selectedSample, hatchingOpacity);\n\n    // This test uses a soft threshold to deal with possible numerical imprecision where adding and subtracting\n    // the same values doesn't result in a zero. The threshold value is chosen to be an invisible alpha level.\n    if (selectedSample.a < 0.001 || (uDiscardPatternBackground > 0.0 && hatchingOpacity < 0.01)) {\n        if (edgeAlpha > 0.01) {\n            gl_FragColor = vec4(0.0, 0.0, 0.0, edgeAlpha);\n        } else {\n            discard;\n        }\n    } else {\n        gl_FragColor = mix(patternColor, vec4(0.0, 0.0, 0.0, 1.0), edgeAlpha);\n    }\n}\n"},60619:function(e,t){"use strict";t.Z="#ifdef DERIVATIVES_SUPPORTED\n#extension GL_OES_standard_derivatives : enable\n#endif\n\n#ifdef GL_ES\nprecision mediump float;\n#endif\n\n{{{contactVisualizationFunctions}}}\n\nvoid main(void) {\n    gl_FragColor = getContactColorOrDiscard();\n}\n"},62164:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying highp vec3 vPosition;\nvarying lowp vec3 vNormal;\nvarying mediump vec2 vTextureCoordinate;\nvarying lowp vec3 vAmbient;\nvarying lowp vec3 vDiffuse;\nvarying lowp vec3 vSpecular;\nvarying lowp float vOpacity;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n{{{cosmeticThreadFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec3 threadedNormal = getThreadedNormal(vPosition, vNormal);\n\n    gl_FragColor = lightFragment(vAmbient, vDiffuse, vSpecular, vOpacity, vPosition, threadedNormal, vTextureCoordinate, gl_FragCoord);\n}"},66466:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform bool uOutsideIsolation;\nuniform float uIsolateTranslucentAlpha;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{decalFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec4 color = getDecalColor();\n\n    if (uIsolateTranslucentAlpha < 1.0) {\n      // This entire occurrence is translucent and will be handled by the order-indepent transparency (OIT) passes\n      discard;\n    } else if (uOutsideIsolation) {\n      // If the decal is being used for isolated context, we need to apply the transparency factor.\n      color.a *= vOpacity;\n    } else {\n      // Transparent decal fragments are blended with the order-indepent transparency (OIT) passes\n      if (color.a < 1.0) {\n        discard;\n      }\n    }\n\n    gl_FragColor = color;\n}\n"},19360:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform float uScalarOutputMax;\nuniform float uScalarOutputMagnitude;\nuniform float uScalarOutputMagnitudeInverse;\n\nuniform bool uMakeUnsigned;\n\nvarying highp vec3 vPosition;\n\n// Shaded faces\nvarying lowp vec3 vAmbient;\nvarying lowp vec3 vDiffuse;\nvarying lowp vec3 vNormal;\nvarying lowp float vOpacity;\nvarying lowp vec3 vSpecular;\nvarying highp vec2 vTextureCoordinate;\n\nuniform bool uOutsideIsolation;\nuniform highp float uIsolateContextOpacity;\n\n// Flags for whether or not to enable highlight regions\nuniform bool uUseMinColor;\nuniform bool uUseMaxColor;\nuniform bool uUseDimColor;\n\n// Highlight region colors\nuniform lowp vec4 uMinColor;\nuniform lowp vec4 uMaxColor;\nuniform lowp vec4 uDimColor;\n\nuniform lowp float uHighlightRegionBlendDistance;\nuniform lowp float uHighlightRegionBlendDistanceInverse;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n\nvec4 sampleBackgroundColor(float value, vec4 normalColor) {\n  vec4 outColor = normalColor;\n  if (uUseMinColor && value < 0.0) {\n    outColor = uMinColor;\n  } else if (uUseMaxColor && 1.0 < value) {\n    outColor = uMaxColor;\n  }\n  return outColor;\n}\n\nvec4 sampleBlendedHighlightColor(float value, vec4 normalColor) {\n  float blendDistance = 0.0;\n\n  // Convert blend distance to absolute distance\n  float blendMaxDistance = uHighlightRegionBlendDistance * uScalarOutputMagnitudeInverse;\n  vec4 outColor = normalColor;\n\n  // Use a highlight color if a given value is within `uHighlightRegionBlendDistance` of its\n  // target value. If it's within `uHighlightRegionBlendDistance`, but outside of the true range,\n  // then we calculate what percent of the way it is towards the true value, then use that to\n  // blend between the background color and the highlight color.\n  if (uUseMinColor && value < blendMaxDistance) {\n    // Min region (-Inf, 0.0 + blendDistance)\n    blendDistance = max(0.0, value);\n    outColor = uMinColor;\n  } else if (uUseMaxColor && 1.0 < value + blendMaxDistance) {\n    // Max region (1.0 - blendDistance, Inf)\n    blendDistance = max(0.0, 1.0 - value);\n    outColor = uMaxColor;\n  }\n\n  if (blendDistance > 0.0) {\n    float blendMaxWidthInverse = uHighlightRegionBlendDistanceInverse * uScalarOutputMagnitude;\n    float blendProgress = min(blendDistance * blendMaxWidthInverse, 1.0);\n\n    // Use `sampleBackgroundColor` here to ensure that we blend from one highlight region to\n    // another if they are adjacent, rather than relying on the potentially incorrect normal color.\n    vec4 backgroundColor = sampleBackgroundColor(value, normalColor);\n    vec4 blendedColor = mix(outColor, backgroundColor, blendProgress);\n    return blendedColor;\n  }\n\n  return outColor;\n}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    float toBeVisualized = vTextureCoordinate[0];\n    // By default we don't visualize. Instead, set the color as we would in the shaded mode.\n    // The toBeVisualized should only be 0.0 (not visualized) or 1.0 (visualized).  However,\n    // there are some precision issues that arise on nvidia drivers in perspective mode (BEL-193801),\n    // hence we make the comparison more tolerant by not directly comparing to those values.\n    if (toBeVisualized < 0.5) {\n      gl_FragColor = lightFragment(vAmbient, vDiffuse, vSpecular, vOpacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n      return;\n    }\n\n    float scalarValue = vTextureCoordinate[1];\n    if (uMakeUnsigned) {\n      scalarValue *= sign(scalarValue);\n    }\n\n    // Here we map the vertex's scalar value (stored in the texture coordinate) to a texture coordinate\n    // value mapped to 0-1.  This mapping is based on the scalar output range, which can be dynamically adjusted\n    // by the user.\n    float normalizedValue = (uScalarOutputMax - scalarValue) * uScalarOutputMagnitudeInverse;\n    vec2 shiftedCoordinate = vec2(0.0, clamp(normalizedValue, 0.0, 1.0));\n\n    vec4 color = uUseDimColor ? uDimColor : texture2D(uAmbientTexture, shiftedCoordinate);\n    vec4 blendedColor = sampleBlendedHighlightColor(1.0 - normalizedValue, color);\n\n    if (uOutsideIsolation) {\n      blendedColor.a *= uIsolateContextOpacity;\n    }\n\n    gl_FragColor = blendedColor;\n}\n"},21080:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying highp vec3 vPosition;\nvarying lowp vec3 vNormal;\nvarying mediump vec2 vTextureCoordinate;\nvarying lowp vec3 vAmbient;\nvarying lowp vec3 vDiffuse;\nvarying lowp vec3 vSpecular;\nvarying lowp float vOpacity;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    gl_FragColor = lightFragment(vAmbient, vDiffuse, vSpecular, vOpacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n}\n"},42407:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying lowp vec4 vColor;\n\nuniform lowp vec4 uBackgroundColor;\n\n{{{pointFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    gl_FragColor = getPointColor(vColor, uBackgroundColor);\n}\n"},95831:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying highp vec3 vPosition;\nvarying highp float vProjectedError;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n// The ideal error we are looking for, in pixels\n#define BEST_ERROR 1.0\n\n// An amount of error that we consider to look bad, in pixels\n#define BAD_ERROR 10.0\n\n#define OPTIMAL_COLOR vec4(0.0, 1.0, 0.0, 1.0)\n#define OVER_REFINED_COLOR vec4(0.0, 0.0, 1.0, 1.0)\n#define BAD_COLOR vec4(1.0, 0.0, 0.0, 1.0)\n\n    if (vProjectedError < BEST_ERROR) {\n      float overRefinementRatio = (BEST_ERROR - vProjectedError);\n      gl_FragColor = mix(OPTIMAL_COLOR, OVER_REFINED_COLOR, overRefinementRatio);\n    } else {\n      float errorRatio = (vProjectedError - BEST_ERROR) / BAD_ERROR;\n      gl_FragColor = mix(OPTIMAL_COLOR, BAD_COLOR, errorRatio);\n    }\n}\n"},29671:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform mediump vec4 uViewport;\n\nvarying lowp vec4 vColor;\nvarying mediump float vLineWidth;\nvarying mediump float vDistance;\nvarying mediump float vLength;\nvarying mediump float vSilhouetteTest;\nvarying highp vec3 vPosition;\n\n{{{utilityFunctions}}}\n{{{edgeFragmentUtilityFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n  if (vSilhouetteTest < 0.0) {\n    discard;\n  }\n\n  DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n  gl_FragColor = edgeColor(vColor, vLineWidth, vDistance);\n}\n"},78851:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying highp vec3 vPosition;\nvarying lowp vec3 vNormal;\nvarying mediump vec2 vTextureCoordinate;\nvarying lowp float vIsolateOverrideOpacity;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n{{{fragmentCurvatureUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    gl_FragColor = vec4(zebraStripeFragment(vPosition, vNormal).rgb, vIsolateOverrideOpacity);\n}\n"},9623:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\nvarying vec2 vTextureCoordinate;\n\nuniform sampler2D uTexture;\n\nvoid main(void) {\n    gl_FragColor = texture2D(uTexture, vTextureCoordinate);\n}"},39155:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\nvarying vec2 vTextureCoordinate;\n\nuniform sampler2D uSourceBuffer;\nuniform vec2 uPixelScale;\nuniform float uDoEdgeDetection;\n\n#define THRESHOLD 0.001\n#define MINIMUM_DIFFERENT 2\n#define TOO_MANY_DIFFERENT 7\n\nvec4 getTap(int x, int y) {\n    return texture2D(uSourceBuffer, vTextureCoordinate + vec2(x, y) * uPixelScale);\n}\n\nint isDifferent(int x, int y, vec4 centersample) {\n    return int(length(getTap(x, y) - centersample) > THRESHOLD);\n}\n\nvoid main(void) {\n    vec4 centersample = getTap(0, 0);\n    int acc = isDifferent(-1, -1, centersample) +\n              isDifferent(-1, 0, centersample) +\n              isDifferent(-1, 1, centersample) +\n              isDifferent(0, -1, centersample) +\n              isDifferent(0, 1, centersample) +\n              isDifferent(1, -1, centersample) +\n              isDifferent(1, 0, centersample) +\n              isDifferent(1, 1, centersample);\n    gl_FragColor = vec4(0.0, 0.0, 0.0, uDoEdgeDetection * float(acc >= MINIMUM_DIFFERENT && acc < TOO_MANY_DIFFERENT));\n}\n"},75941:function(e,t){"use strict";t.Z="{{{fs-endcapMask-faces}}}\n"},39799:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying vec3 vPosition;\nvarying mediump vec4 vVertexColor;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_NORMAL_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    gl_FragColor = (gl_FrontFacing) ? vVertexColor : vVertexColor * -1.0;\n}\n"},68197:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\nvarying vec2 vTextureCoordinate;\n\nuniform sampler2D uSourceBuffer;\nuniform vec2 uPixelScale;\nuniform vec2 uDirection;\n\nvec4 getTap(int i) {\n    return texture2D(uSourceBuffer, vTextureCoordinate + uDirection * vec2(i, i) * uPixelScale);\n}\n\nvoid main(void) {\n    vec4 accumulate = vec4(0.0, 0.0, 0.0, 0.0);\n\n    accumulate += getTap(-2) * 0.07;\n    accumulate += getTap(-1) * 0.2;\n    accumulate += getTap(0)  * 0.7;\n    accumulate += getTap(1)  * 0.2;\n    accumulate += getTap(2)  * 0.07;\n\n    gl_FragColor = accumulate;\n}\n"},45912:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying lowp vec3 vHighlightIndexInstanceId;\n\nvoid main(void) {\n  // The color will take on the index of the highlight\n  gl_FragColor.rgb = vHighlightIndexInstanceId;\n  // Increment the count in the alpha buffer by one\n  gl_FragColor.a = 1.0 / 255.0;\n}\n"},58777:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying lowp vec4 vColor;\nvarying mediump float vOffset;\nvarying mediump vec4 vLineStipple;\nvarying mediump float vLength;\n\n#ifndef SKIP_SECTION_PLANES\nvarying vec3 vPositionForSection;\n#endif\n\nuniform float uHighlightBorderOpacity;\n\n{{{utilityFunctions}}}\n{{{edgeFragmentUtilityFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n  DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPositionForSection);\n\n  float radiusFraction = abs(vOffset);\n\n  // blend between highlight and contrast colors\n  gl_FragColor = vec4(vColor.rgb, mix(vColor.a, uHighlightBorderOpacity, smoothstep(0.4, 0.75, radiusFraction)));\n\n  // fade at the outside edges\n  gl_FragColor.a *= (1.0 - smoothstep(0.85, 1.0, radiusFraction));\n  gl_FragColor.a *= getStippleAlphaMultiplier(vLength, vLineStipple);\n}\n"},60343:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying lowp vec4 vColor;\nvarying mediump vec2 vOffset;  // screen offset from the point center in multiples of radius\n\n#ifndef SKIP_SECTION_PLANES\nvarying vec3 vPositionForSection;\n#endif\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPositionForSection);\n\n    float radius = length(vOffset);\n\n    // blend between highlight and contrast colors\n    gl_FragColor = vec4(vColor.rgb, mix(vColor.a, 1.0, smoothstep(0.2, 1.0, radius)));\n\n    // fade at the outside edges\n    gl_FragColor.a *= (1.0 - smoothstep(0.85, 1.0, radius));\n}\n"},78440:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform vec4 uViewport;\n\nvarying vec2 vTextureCoordinate;\n\nuniform sampler2D uHighlightBuffer;\nuniform sampler2D uHighlightMask;\nuniform vec4 uHighlightColor1;\nuniform vec4 uHighlightColor2;\nuniform vec4 uHighlightColorBorder;\nuniform float uInteriorHighlightOpacity;\nuniform int uOutlineOverlappingInteriorRegions;\n\n// Indicates whether or not the interior parts of the selection should be hidden.\nuniform int uHideSelectionInterior;\n\n// The total number of samples in the neighborhood:\n#define TOTAL_SAMPLES 4\n\n// A distance that is outside of the neighborhood of samples\n#define DISTANCE_BEYOND_NEIGHBORHOOD 10000.0\n\n// Highlight ids are not decoded exactly.  Hence we need to compare them with some tolerance.\n#define COMPARE_TOLERANCE .01\n\n{{{utilityFunctions}}}\n\n// Take the information from the highlight buffer sample to reconstruct an id for the highlight.  The goal is to\n// wind up with the same id for fragments that have been touched by the same combinations of highlights.\nfloat getSampleId(vec4 sample) {\n  // We need to divide by the number of crossings so that the same highlight that accumulated its same id several\n  // times will be equivalent to an adjacent highlight that is the same, but crossed a different number of times.\n  // Some samples will have zero crossings - so we will set those samples to divide by the minimum number of crossings\n  // a highlight can have (other than zero).\n  return (16.0 * sample[1] + sample[2]) / max(ONE_255, sample[3]);\n}\n\nbool isNumberWhole(float number) {\n  return abs(floor(number + 0.5) - number) < COMPARE_TOLERANCE;\n}\n\nvoid main(void) {\n\n  // Sample locations contains the x, y offset from the center of the pixel.  The z-component contains the length\n  // of the offset.  This is pre-computed for efficiency's sake.\n  vec3 sampleLocations[TOTAL_SAMPLES];\n  sampleLocations[0] = vec3(-1.0, -1.0, 1.41421356237);\n  sampleLocations[1] = vec3(-1.0, 1.0, 1.41421356237);\n  sampleLocations[2] = vec3(1.0, -1.0, 1.41421356237);\n  sampleLocations[3] = vec3(1.0, 1.0, 1.41421356237);\n\n  // Get the highlight index (r channel), id (g, b channels) and count (a channel) from the highlight buffer\n  vec4 centralSample = texture2D(uHighlightBuffer, vTextureCoordinate);\n\n  // By default the color will be totally transparent, unless the pixel is near or on a highlight\n  gl_FragColor = vec4(uHighlightColor1.rgb, 0.0);\n\n  // Sample within a radius of this pixel to determine if we're near the edge of the highlight\n  float distance = DISTANCE_BEYOND_NEIGHBORHOOD;\n  float centralId =  getSampleId(centralSample);\n  bool centralWhole = isNumberWhole(centralId);\n  for (int i = 0; i < TOTAL_SAMPLES; ++i) {\n    vec2 offset = sampleLocations[i].xy / uViewport.zw;\n    vec2 uv = vTextureCoordinate.xy + offset;\n    vec4 sample = texture2D(uHighlightBuffer, uv);\n    float sampleId =  getSampleId(sample);\n    // Put the border on fragments that are on the outside of highlighted regions.  We can find the outsides by\n    // comparing the number of crossings (in the alpha channel).  We also want to put a border around highlights\n    // with different ids - so we will compare the id channels to see if they are different.\n    if (!compareWithTolerance(centralId, sampleId, COMPARE_TOLERANCE) &&\n       (centralWhole || isNumberWhole(sampleId) || uOutlineOverlappingInteriorRegions != 0)) {\n      distance = min(distance, sampleLocations[i][2]);\n    }\n  }\n\n  // Color the interior of the highlight if it is not set to be hidden.\n  if (centralSample[3] > 0.0 && uHideSelectionInterior != 1) {\n    // The mask value will be zero if the highlight is occluded, 1.0 otherwise. If the fragment  is not occluded,\n    // we can color the fragment based on how many highlights are in this fragment.\n    float occlusionMask = texture2D(uHighlightMask, vTextureCoordinate).r;\n    float count = centralSample[3] * 255.0;\n\n    gl_FragColor = vec4(uHighlightColor1.rgb, uHighlightColor1.a * uInteriorHighlightOpacity);\n\n    gl_FragColor.a = mix(0.0, gl_FragColor.a, occlusionMask);\n  }\n\n  // If this fragment is near the border of the highlight, draw a line\n  if (distance < DISTANCE_BEYOND_NEIGHBORHOOD) {\n    gl_FragColor = uHighlightColorBorder;\n  }\n}\n"},6206:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying lowp float vHighlighted;\nvarying highp vec3 vPosition;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    // The value of the fragment should take on the highlight value of the primitive.  The last fragment to pass\n    // the depth test will determine if a highlight was visible, or not.\n    gl_FragColor = vec4(vHighlighted, vHighlighted, vHighlighted, 1.0);\n}\n"},4530:function(e,t){"use strict";t.Z="#ifdef GL_FRAGMENT_PRECISION_HIGH\nprecision highp float;\n#else\nprecision mediump float;\n#endif\n\nuniform mat4 uPMatrix_fs;\n\nvarying vec3 vPosition;\nvarying vec3 vNormal;\n#ifdef GL_FRAGMENT_PRECISION_HIGH\nvarying highp float vDepth;\n#else\nvarying float vDepth;\n#endif\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{depthNormalFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    gl_FragColor.xy = encodeNormal(flipNormalTowardViewer(vNormal, vPosition, uPMatrix_fs));\n    gl_FragColor.zw = encodeDepth(vDepth);\n}\n"},54031:function(e,t){"use strict";t.Z='#ifdef GL_ES\n#ifdef GL_FRAGMENT_PRECISION_HIGH\nprecision highp float;\n#else\nprecision mediump float;\n#endif\n#endif\n\nuniform vec4 uViewport;\nuniform sampler2D uNormalDepthTexture;\n\n{{{depthNormalFunctions}}}\n\n// Median operations based on: http://graphics.cs.williams.edu/papers/MedianShaderX6/\n// Copyright notice:\n// Copyright (c) Morgan McGuire and Williams College, 2006\n// All rights reserved.\n//\n// Redistribution and use in source and binary forms, with or without\n// modification, are permitted provided that the following conditions are\n// met:\n//\n// Redistributions of source code must retain the above copyright notice,\n// this list of conditions and the following disclaimer.\n//\n// Redistributions in binary form must reproduce the above copyright\n// notice, this list of conditions and the following disclaimer in the\n// documentation and/or other materials provided with the distribution.\n//\n// THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS\n// "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT\n// LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR\n// A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT\n// HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,\n// SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT\n// LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,\n// DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY\n// THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n// (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\n// OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n\n#define s2(a, b)                tempD = d[a]; d[a] = min(d[a], d[b]); d[b] = max(tempD, d[b]); tempN = n[a]; n[a] = min(n[a], n[b]); n[b] = max(tempN, n[b]);\n#define mn3(a, b, c)            s2(a, b); s2(a, c);\n#define mx3(a, b, c)            s2(b, c); s2(a, c);\n\n#define mnmx3(a, b, c)          mx3(a, b, c); s2(a, b);                                    // 3 exchanges\n#define mnmx4(a, b, c, d)       s2(a, b); s2(c, d); s2(a, c); s2(b, d);                    // 4 exchanges\n#define mnmx5(a, b, c, d, e)    s2(a, b); s2(c, d); mn3(a, c, e); mx3(b, d, e);            // 6 exchanges\n#define mnmx6(a, b, c, d, e, f) s2(a, d); s2(b, e); s2(c, f); mn3(a, b, c); mx3(d, e, f);  // 7 exchanges\n\n/**\n * Decodes depth and normal for adjacent pixels then find the median of them and re-encodes the median in the\n * returned value.\n */\nvec4 median() {\n  vec3 n[9];  // normals\n  float d[9]; // depths\n\n  for(int dX = -1; dX <= 1; ++dX) {\n    for(int dY = -1; dY <= 1; ++dY) {\n      vec2 offset = vec2(dX, dY);\n      vec2 uv = (gl_FragCoord.xy + offset - uViewport.xy) / uViewport.zw;\n      vec4 sample = texture2D(uNormalDepthTexture, uv);\n      n[(dX + 1) * 3 + (dY + 1)] = decodeNormal(sample.xy);\n      d[(dX + 1) * 3 + (dY + 1)] = decodeDepth(sample.zw);\n    }\n  }\n\n  vec3 tempN;\n  float tempD;\n\n  mnmx6(0, 1, 2, 3, 4, 5);\n  mnmx5(1, 2, 3, 4, 6);\n  mnmx4(2, 3, 4, 7);\n  mnmx3(3, 4, 8);\n\n  vec4 result;\n  result.xy = encodeNormal(n[4]);\n  result.zw = encodeDepth(d[4]);\n\n  return result;\n}\n\nvoid main(void) {\n  gl_FragColor = median();\n}\n\n'},43503:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying vec3 vPosition;\n\n{{{normalDepthWithMaskFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    discardIfDepthMatchesMask();\n\n    gl_FragColor = encodeDepthWithZeroNormalColor();\n}\n\n"},3922:function(e,t){"use strict";t.Z="#ifdef GL_FRAGMENT_PRECISION_HIGH\nprecision highp float;\n#else\nprecision mediump float;\n#endif\n\nuniform mat4 uPMatrix_fs;\nvarying vec3 vPosition;\nvarying vec3 vNormal;\n\n{{{normalDepthWithMaskFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec3 facingNormal = flipNormalTowardViewer(vNormal, vPosition, uPMatrix_fs);\n    discardIfNormalDepthMatchesMask(facingNormal);\n\n    gl_FragColor = encodeNormalDepthColor(facingNormal);\n}\n\n"},32543:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\n{{{normalDepthWithMaskFunctions}}}\n\nvoid main(void) {\n    discardIfDepthMatchesMask();\n\n    gl_FragColor = encodeDepthWithZeroNormalColor();\n}\n\n"},17073:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision highp float;\n#endif\n\n{{{depthNormalFunctions}}}\n\nuniform mat4 uPMatrix_fs;\nuniform mat4 uPMatrixInv_fs;\n\nuniform vec4 uViewport;\nuniform float uTest;\n\nvarying vec2 vTextureCoordinate;\nvarying vec2 vExtent;  // near distance and depth extent of the object\n\nuniform sampler2D uNormalDepthTexture;\nuniform sampler2D uRandomTexture;\nuniform vec2 uRandomTextureScale;\n\nuniform float uRadiusNear;\nuniform float uRadiusFar;\nuniform float uIntensity;\nuniform float uBias;\nuniform float uScale;\n\n#define nRadial 5  // number of occlusion sample rings\n#define nAngular 5  // number of occlusion samples per ring\n#define minResolution 2e-4  // smallest step in normalized depth\n\nfloat getDepth(vec2 pixel) {\n  vec2 encodedDepth = texture2D(uNormalDepthTexture, (pixel - uViewport.xy) / uViewport.zw).zw;\n  float depth = decodeDepth(encodedDepth);\n  return depth;\n}\n\nvec3 getPosition(vec2 pixel, float depth) {\n  float zView = -(vExtent[0] + vExtent[1] * depth);\n  float w = uPMatrix_fs[2][3] * zView + uPMatrix_fs[3][3];\n  vec3 ndc = 2.0 * vec3(pixel / uViewport.zw, depth) - 1.0;\n  vec4 position = uPMatrixInv_fs * vec4(w * ndc, w);\n  return position.xyz;\n}\n\nvec3 getPosition(vec2 pixel) {\n  float depth = getDepth(pixel);\n  return getPosition(pixel, depth);\n}\n\nfloat getOcclusion(vec2 pixel, vec3 position0, vec3 normal0) {\n  vec3 position = getPosition(pixel);\n  vec3 diff = position - position0;\n  float len = length(diff);\n  float dist = uScale * len / vExtent[1];\n  float occlusion = uIntensity * max(0.0, (dot(normal0, diff) - minResolution * vExtent[1]) / len - uBias) / (1.0 + dist * dist);\n  return occlusion;\n}\n\nvoid main(void) {\n    vec4 normalDepth = texture2D(uNormalDepthTexture, vTextureCoordinate);\n    vec3 normal = decodeNormal(normalDepth.xy);\n    float depth = decodeDepth(normalDepth.zw);\n    vec3 position = getPosition(gl_FragCoord.xy, depth);\n\n    float random = texture2D(uRandomTexture, vTextureCoordinate * uRandomTextureScale).r;\n\n    // loop through samples that define occlusion\n    float occlusion = 0.0;\n    float radiusMax = uRadiusNear + (uRadiusFar - uRadiusNear) * depth;\n    float radiusMin = radiusMax / float(nRadial);\n    float angleStep = 6.2831853 / float(nAngular);\n    float angle = 6.2831853 * random;  // randomly rotate the sampling rings\n    for (int i = 0; i < nRadial; ++i) {\n      float radius = radiusMin * float(i + 1);\n      for (int j = 0; j < nAngular; ++j) {\n        vec2 offset = radius * vec2(cos(angle), sin(angle));\n        occlusion += getOcclusion(gl_FragCoord.xy + offset, position, normal);\n        angle += angleStep;\n      }\n      angle -= angleStep / 2.0;  // ensure we hit the in-between samples in the next ring\n    }\n    occlusion /= float(nRadial * nAngular);\n    occlusion *= float(depth < 1.0);\n\n    gl_FragColor.r = occlusion;\n    gl_FragColor.a = 1.0;\n}\n"},85279:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision highp float;\n#endif\n\nuniform vec4 uViewport;\n\nuniform sampler2D uOcclusionMap;\n\nvoid main(void) {\n    #define uFilterRadius 2\n\n    float occlusion = 0.0;\n    float count = 0.0;\n    for (int x = -uFilterRadius; x <= uFilterRadius; ++x) {\n      for (int y = -uFilterRadius; y <= uFilterRadius; ++y) {\n        vec2 offset = vec2(x, y);\n        vec2 uv = (gl_FragCoord.xy + offset - uViewport.xy) / uViewport.zw;\n        float occlusionSample = texture2D(uOcclusionMap, uv).r;\n        float weight = 1.0 / (1.0 + dot(offset, offset));\n        occlusion += weight * occlusionSample;\n        count += weight;\n      }\n    }\n    occlusion /= count;\n\n    gl_FragColor = vec4(occlusion, 0.0, 0.0, 1.0);\n}\n"},50767:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying lowp vec4 vPickingIndex;\nvarying highp vec3 vPosition;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    gl_FragColor = vPickingIndex;\n}\n"},11610:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying lowp vec4 vPickingIndex;\nvarying mediump float vPrimitiveRestart;\nvarying highp vec3 vPosition;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    if (vPrimitiveRestart != 0.0) {\n        discard;\n    }\n\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    gl_FragColor = vPickingIndex;\n}\n"},31236:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying lowp vec4 vPickingIndex;\nvarying highp vec3 vPosition;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    gl_FragColor = vPickingIndex;\n}\n"},76845:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform vec4 uPickRect;\nuniform vec2 uPickRectScale;\nuniform vec2 uMaskTextureDimensions;\nuniform sampler2D uEndcapMaskTexture;\nuniform vec4 uPlaneSelector;\n\nuniform float uOccurrenceId;\n\nvarying vec3 vPosition;\n\n{{{picking}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{sectionPlaneClippingFunctions}}}\n{{{sectionPlaneEndcapMedianFilter}}}\n{{{sectionPlaneEndcapFunctions}}}\n\nvec2 maskTextureCoordinates(vec2 screenCoordinates) {\n    vec2 ndc;\n    vec2 scaledScreen = screenCoordinates * uPickRectScale;\n    ndc.x = (scaledScreen.x + uPickRect.x) / uMaskTextureDimensions.x;\n    ndc.y = (scaledScreen.y + (uMaskTextureDimensions.y - uPickRect.y - uPickRect.w)) / uMaskTextureDimensions.y;\n    return ndc;\n}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_ALL_BUT_ONE_SECTION_PLANE_CLIPPING_TEST(vPosition, uPlaneSelector);\n\n    vec4 sample0 = texture2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy + vec2(-1.0, 0.0)));\n    vec4 sample1 = texture2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy));\n    vec4 sample2 = texture2D(uEndcapMaskTexture, maskTextureCoordinates(gl_FragCoord.xy + vec2(1.0, 0.0)));\n\n    vec4 selectedSample = medianFilterEndcapSamples(sample0, sample1, sample2);\n\n    // This test uses a soft threshold to deal with possible numerical imprecision where adding and subtracting\n    // the same values doesn't result in a zero. The threshold value is chosen to be an invisible alpha level.\n    if (selectedSample.a < 0.001) {\n        discard;\n    }\n\n    vec2 outsideIsolationCountAndTotalPartCount = getIsolateAndInterferenceInfoFromAlpha(selectedSample.a);\n    if (outsideIsolationCountAndTotalPartCount[0] == outsideIsolationCountAndTotalPartCount[1])\n    {\n        discard;\n    }\n\n    vec4 pickingColor = encodePickingId(uOccurrenceId, vec4(0.0, 0.0, 0.0, 1.0));\n    gl_FragColor = pickingColor;\n}\n"},21582:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying lowp vec4 vPickingIndex;\nvarying highp vec3 vPosition;\n\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    gl_FragColor = vPickingIndex;\n}\n"},81461:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying lowp vec4 vPickingIndex;\n\nvoid main(void) {\n    gl_FragColor = vPickingIndex;\n}\n"},75756:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform vec4 uViewport;\nuniform int uDoSetTest;\nuniform sampler2D uPlaneIdSetBuffer;\n\nvarying vec3 vPositionForSection;\nvarying vec4 vVertexColor;\n\n{{{planeIdFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPositionForSection);\n\n    if (uDoSetTest > 0) {\n        vec4 compareSample = texture2D(uPlaneIdSetBuffer, (gl_FragCoord.xy - uViewport.xy) / uViewport.zw);\n        if (!isPlaneInSet(vVertexColor, compareSample)) {\n            discard;\n        }\n    }\n\n    gl_FragColor = vVertexColor;\n}"},18896:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nvarying vec2 vTextureCoordinate;\n\nuniform sampler2D uBaseTexture;\nuniform sampler2D uPreviewTexture;\nuniform float uPreviewAlpha;\n\nvoid main(void) {\n    gl_FragColor = mix(texture2D(uBaseTexture, vTextureCoordinate), texture2D(uPreviewTexture, vTextureCoordinate), uPreviewAlpha);\n}\n"},21925:function(e,t){"use strict";t.Z="#ifdef GL_ES\n#ifdef GL_FRAGMENT_PRECISION_HIGH\nprecision highp float;\n#else\nprecision mediump float;\n#endif\n#endif\n\nvarying vec3 vCameraPosition;\nvarying highp float vToBeVisualized;\nvarying highp float vScalarValue;\n\nuniform bool uMakeUnsigned;\n\nuniform float uScalarInputMax;\nuniform float uScalarInputMagnitudeInverse;\n\n{{{depthNormalFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n    float scalarValue = vScalarValue;\n    if (uMakeUnsigned) {\n      scalarValue *= sign(scalarValue);\n    }\n\n    // Map the scalar value into the 0-1 range based on the range of values in the input scalar data.  It will\n    // be mapped back to the full range after being decoded.\n    float normalizedValue = clamp((uScalarInputMax - scalarValue) * uScalarInputMagnitudeInverse, 0.0, 1.0);\n\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vCameraPosition);\n    vec4 color = packNormalizedFloatIntoRGBA(normalizedValue);\n    color.a = clamp(vToBeVisualized, 0.0, 1.0);\n    gl_FragColor = color;\n}\n"},18325:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform vec4 uViewport;\nuniform vec3 uTintColor;\nuniform vec3 uMatchesCompareColor;\n\nuniform sampler2D uCompareBuffer;\n\nvarying lowp vec4 vColor;\nvarying mediump vec4 vLineStipple;\nvarying mediump float vLineWidth;\nvarying mediump float vDistance;\nvarying mediump float vLength;\nvarying highp vec3 vPosition;\n#ifdef GL_FRAGMENT_PRECISION_HIGH\nvarying highp float vDepth;\n#else\nvarying float vDepth;\n#endif\n\n{{{utilityFunctions}}}\n{{{depthNormalFunctions}}}\n{{{compareFunctions}}}\n{{{edgeFragmentUtilityFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n\nvoid main(void) {\n  DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n  discardIfIsGap(vLength, vLineStipple);\n\n  float opacityScale = smoothstep(0.0, uLineFilterWidth, 0.5 * (vLineWidth + uLineFilterWidth) - abs(vDistance));\n  vec4 color = vec4(uMatchesCompareColor, 1.0);\n  if (opacityScale > 0.3) {\n    vec4 compareSample = texture2D(uCompareBuffer, (gl_FragCoord.xy - uViewport.xy) / uViewport.zw);\n    float compareDepth = decodeDepth(compareSample.zw);\n    if (!isSameDepth(vDepth, compareDepth)) {\n      color = vec4(uTintColor, 1.0);\n    }\n  }\n\n  color = mix(color, uBackgroundColor, uBackgroundMixProportion);\n  color.a *= opacityScale;\n\n  gl_FragColor = color;\n}\n"},59080:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform vec4 uViewport;\nuniform vec3 uTintColor;\nuniform vec3 uMatchesCompareColor;\n\nuniform sampler2D uCompareBuffer;\n\nvarying lowp vec4 vColor;\n#ifdef GL_FRAGMENT_PRECISION_HIGH\nvarying highp float vDepth;\n#else\nvarying float vDepth;\n#endif\n\n{{{pointFragmentUtilityFunctions}}}\n{{{depthNormalFunctions}}}\n{{{compareFunctions}}}\n\nvoid main(void) {\n  vec4 color = vec4(uTintColor, 1.0);\n\n  vec4 compareSample = texture2D(uCompareBuffer, (gl_FragCoord.xy - uViewport.xy) / uViewport.zw);\n  float compareDepth = decodeDepth(compareSample.zw);\n\n  if (isSameDepth(vDepth, compareDepth)) {\n    color = vec4(uMatchesCompareColor, 1.0);\n  }\n\n  vec4 backgroundColor = vec4(1, 1, 1, 1);\n  gl_FragColor = getPointColor(color, backgroundColor);\n}\n\n\n"},35693:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform vec3 uSpecular;\nuniform float uColorAmbientFactor;  //Determines how much of the vertex-specified color to use in the ambient term\nuniform float uColorDiffuseFactor;  //Determines how much of the vertex-specified color to use in the diffuse term\nuniform vec3 uTintColor;\nuniform vec3 uMatchesCompareColor;\n\nuniform sampler2D uCompareBuffer;\n\nvarying vec3 vPosition;\nvarying lowp vec3 vNormal;\nvarying mediump vec2 vTextureCoordinate;\nvarying mediump float vOpacity;\n#ifdef GL_FRAGMENT_PRECISION_HIGH\nvarying highp float vDepth;\n#else\nvarying float vDepth;\n#endif\n\n{{{depthNormalFunctions}}}\n{{{compareFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n{{{cosmeticThreadFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec4 compareSample = texture2D(uCompareBuffer, (gl_FragCoord.xy - uViewport.xy) / uViewport.zw);\n    vec3 compareNormal = decodeNormal(compareSample.xy);\n    float compareDepth = decodeDepth(compareSample.zw);\n\n    vec3 ambient, diffuse;\n\n    vec3 facingNormal = flipNormalTowardViewer(vNormal, vPosition, uPMatrix_fs);\n\n    if (isSameFace(vDepth, compareDepth, facingNormal, compareNormal)) {\n        ambient = uColorAmbientFactor * uMatchesCompareColor;\n        diffuse = uColorDiffuseFactor * uMatchesCompareColor;\n    } else {\n        ambient = uColorAmbientFactor * uTintColor;\n        diffuse = uColorDiffuseFactor * uTintColor;\n    }\n\n    vec3 threadedNormal = getThreadedNormal(vPosition, vNormal);\n\n    gl_FragColor = lightFragment(ambient, diffuse, uSpecular, vOpacity, vPosition, threadedNormal, vTextureCoordinate, gl_FragCoord);\n}\n"},57877:function(e,t){"use strict";t.Z="{{{fs-draw-faces-decals}}}"},85584:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform vec3 uSpecular;\nuniform float uColorAmbientFactor;  //Determines how much of the vertex-specified color to use in the ambient term\nuniform float uColorDiffuseFactor;  //Determines how much of the vertex-specified color to use in the diffuse term\nuniform vec3 uTintColor;\nuniform vec3 uMatchesCompareColor;\n\nuniform sampler2D uCompareBuffer;\n\nvarying vec3 vPosition;\nvarying lowp vec3 vNormal;\nvarying mediump vec2 vTextureCoordinate;\nvarying mediump float vOpacity;\n#ifdef GL_FRAGMENT_PRECISION_HIGH\nvarying highp float vDepth;\n#else\nvarying float vDepth;\n#endif\n\n{{{depthNormalFunctions}}}\n{{{compareFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec4 compareSample = texture2D(uCompareBuffer, (gl_FragCoord.xy - uViewport.xy) / uViewport.zw);\n    vec3 compareNormal = decodeNormal(compareSample.xy);\n    float compareDepth = decodeDepth(compareSample.zw);\n\n    vec3 ambient, diffuse;\n\n    vec3 facingNormal = flipNormalTowardViewer(vNormal, vPosition, uPMatrix_fs);\n\n    if (isSameFace(vDepth, compareDepth, facingNormal, compareNormal)) {\n        ambient = uColorAmbientFactor * uMatchesCompareColor;\n        diffuse = uColorDiffuseFactor * uMatchesCompareColor;\n    } else {\n        ambient = uColorAmbientFactor * uTintColor;\n        diffuse = uColorDiffuseFactor * uTintColor;\n    }\n\n    gl_FragColor = lightFragment(ambient, diffuse, uSpecular, vOpacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n}\n"},65296:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform vec3 uSpecular;\nuniform float uColorAmbientFactor;  //Determines how much of the vertex-specified color to use in the ambient term\nuniform float uColorDiffuseFactor;  //Determines how much of the vertex-specified color to use in the diffuse term\nuniform vec3 uTintColor;\nuniform float uBlendOverdrawAdjustment;\nuniform vec3 uMatchesCompareColor;\n\nuniform sampler2D uCompareBuffer;\n\nvarying vec3 vPosition;\nvarying lowp vec3 vNormal;\nvarying mediump vec2 vTextureCoordinate;\nvarying mediump float vOpacity;\nvarying mediump vec4 vVertexColor;\n\n{{{planeIdFunctions}}}\n{{{sectionPlaneFragmentUtilityFunctions}}}\n{{{fragmentLightingUtilityFunctions}}}\n\nvoid main(void) {\n    DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(vPosition);\n\n    vec4 compareSample = texture2D(uCompareBuffer, (gl_FragCoord.xy - uViewport.xy) / uViewport.zw);\n    vec3 ambient, diffuse;\n    float opacity = vOpacity;\n\n    if (isPlaneInSet(vVertexColor, compareSample)) {\n        ambient = uColorAmbientFactor * uMatchesCompareColor;\n        diffuse = uColorDiffuseFactor * uMatchesCompareColor;\n        opacity *= uBlendOverdrawAdjustment;\n    } else {\n        ambient = uColorAmbientFactor * uTintColor;\n        diffuse = uColorDiffuseFactor * uTintColor;\n    }\n\n    gl_FragColor = lightFragment(ambient, diffuse, uSpecular, opacity, vPosition, vNormal, vTextureCoordinate, gl_FragCoord);\n}\n"},4041:function(e,t){"use strict";t.Z="/**\n * Will return a sign to flip the normal if it is pointing away from the camera. This is useful for illuminating back\n * faces as though they are pointed at the camera.\n */\nfloat getNormalSign() {\n  float signPerspective = sign(dot(vNormal, -vPosition));\n  float signOrthographic = sign(vNormal.z);\n  return uPMatrix_fs[3][3] * signOrthographic - uPMatrix_fs[2][3] * signPerspective;\n}\n"},40844:function(e,t){"use strict";t.Z="uniform float uActiveHighlightIndex;\n#ifdef USE_VERTEX_HIGHLIGHT_TEXTURE\nuniform sampler2D uHighlightColorTexture;\nuniform float uHighlightColorTextureWidth;\n#endif\n\n// Indicates whether or not the interior parts of the selection should be hidden.\nuniform int uHideSelectionInterior;\n\nbool entityHasHighlight(float flags) {\n  return IS_BIT_1_SET(flags);\n}\n\nbool isHighlightTypeActive(float encodedHighlightType) {\n  return (abs(uActiveHighlightIndex - encodedHighlightType * 255.0) < 0.5);\n}\n\nbool isHighlighted(float flags, bool occurrenceHasHighlight) {\n  // Highlight if the per-vertex highlight flag is set, or if the uniform override is set and this vertex is visible\n  return occurrenceHasHighlight || entityHasHighlight(flags);\n}\n\nbool isHighlightedForIndex(float flags, float entityHighlightType, float occurrenceHighlightType) {\n  // Highlight if the per-vertex highlight flag is set, or if the uniform override is set and this vertex is visible,\n  // and if the highlight matches the index of the highlight type being blended.\n  return isHighlightTypeActive(occurrenceHighlightType) ||\n         (isHighlightTypeActive(entityHighlightType) && entityHasHighlight(flags));\n}\n\n#ifdef USE_VERTEX_HIGHLIGHT_TEXTURE\n\nvec4 getColorModifiedByHighlight(vec4 highlightId, vec4 vertexColor) {\n  if (uHideSelectionInterior > 0) {\n    return vertexColor;\n  }\n\n  vec4 finalColor = vertexColor;\n  if (!interiorHighlightIsSuppressed(aHighlightId.a) && IS_BIT_1_SET(aHighlightId.a)) {\n    float index = highlightId.r * 255.0;\n    vec4 highlightColor = texture2D(uHighlightColorTexture, vec2((0.5 + index) / uHighlightColorTextureWidth, 0.5));\n    vec3 entityHighlight = mix(vertexColor.rgb, highlightColor.rgb, highlightColor.a);\n    finalColor = vec4(entityHighlight, highlightColor.a);\n  }\n\n  return finalColor;\n}\n\n#else\n\n// If highlight texture reads are not supported in the vertex shader, we leave the color changes to the overlay pass\nvec4 getColorModifiedByHighlight(vec4 highlightId, vec4 vertexColor) {\n  return vertexColor;\n}\n\n#endif\n"},72203:function(e,t){"use strict";t.Z="uniform float uUseMask;\nuniform sampler2D uMask;\nuniform vec2 uMaskWidthHeight;\n\n#ifdef GL_FRAGMENT_PRECISION_HIGH\nvarying highp float vDepth;\n#else\nvarying float vDepth;\n#endif\n\n{{{compareFunctions}}}\n{{{depthNormalFunctions}}}\n\nvoid discardIfDepthMatchesMask() {\n    if (uUseMask > 0.0) {\n        vec4 maskSample = texture2D(uMask, gl_FragCoord.xy / uMaskWidthHeight);\n        float maskDepth = decodeDepth(maskSample.zw);\n        if (!isSameDepth(vDepth, maskDepth)) {\n            discard;\n        }\n    }\n}\n\nvoid discardIfNormalDepthMatchesMask(vec3 normal) {\n    if (uUseMask > 0.0) {\n        vec4 maskSample = texture2D(uMask, gl_FragCoord.xy / uMaskWidthHeight);\n        vec3 maskNormal = decodeNormal(maskSample.xy);\n        float maskDepth = decodeDepth(maskSample.zw);\n        if (!isSameFace(vDepth, maskDepth, normal, maskNormal)) {\n            discard;\n        }\n    }\n}\n\nvec4 encodeDepthWithZeroNormalColor() {\n    vec4 color = vec4(0.0);\n    color.zw = encodeDepth(vDepth);\n    return color;\n}\n\nvec4 encodeNormalDepthColor(vec3 normal) {\n    vec4 color;\n    color.xy = encodeNormal(normal);\n    color.zw = encodeDepth(vDepth);\n    return color;\n}\n\n"},78793:function(e,t){"use strict";t.Z="uniform float uPickPassIteration;\n\n{{{utilityFunctions}}}\n\n#define IDS_PER_OCCURRENCE_SLICE 4096.0\n\nvec4 encodePickingId(float occurrenceId, vec4 pickId) {\n  vec4 occurrenceIdEncoded = vec4(0.0, 0.0, 0.0, 0.0);\n\n  // The occurrence id gets 12 bits to encode its id.  First we must figure out the value of the slice of the whole\n  // id which is being encoded.\n  float divided = occurrenceId / IDS_PER_OCCURRENCE_SLICE;\n  float whole = 0.0;\n  float fraction = modf(divided, whole);\n  // If the pick pass iteration is 0, take the bits of less signficance.  If it is 1, take the bits of higher significance.\n  // For all other passes, we will not support an encoding of the occurrence id, since we only have 24 bits for the\n  // whole id.  If the pick pass iteration is something other than 0 or 1, this should evaluate to 0, since there\n  // should be no data needed from the occurrence id in subsequent passes.\n  float occurrenceSlice = (fraction * IDS_PER_OCCURRENCE_SLICE * float(uPickPassIteration == 0.0)) +\n    (whole * float(uPickPassIteration == 1.0));\n\n  // Now we must encode the 12 bits into a color value.  The 8 most-significant bits go into the red channel.  The\n  // 4 least-significant bits go into the the 4 most-significant bits of the green channel.\n  divided = occurrenceSlice / 16.0;  // 16 = 2^4.  This division should result in values between 0 and 255.9375\n  fraction = modf(divided, whole);\n  occurrenceIdEncoded.r = whole / 255.0;\n  occurrenceIdEncoded.g = fraction * BYTE_FRACTION_TO_NORMALIZED_FLOAT;  // This should result in values between 0 and 240, with all component bits occupying the 4 most-significant spots\n\n  return occurrenceIdEncoded + pickId;\n}\n"},63877:function(e,t){"use strict";t.Z="{{{utilityFunctions}}}\n\n// Returns true if left and right share any bits\nbool anyBitsSetInBoth(float left, float right) {\n    float multiplier = 2.0;\n    bool hasAny = false;\n    for (int i = 0; i < 8; ++i) {\n        hasAny = hasAny || (isBitSet(left, 255.0 / multiplier) && isBitSet(right, 255.0 / multiplier));\n        multiplier *= 2.0;\n    }\n    return hasAny;\n}\n\nbool isPlaneInSet(vec4 planeId, vec4 setBitfield) {\n    return anyBitsSetInBoth(setBitfield.r, planeId.r) || anyBitsSetInBoth(setBitfield.g, planeId.g) ||\n           anyBitsSetInBoth(setBitfield.b, planeId.b) || anyBitsSetInBoth(setBitfield.a, planeId.a);\n}\n"},12078:function(e,t){"use strict";t.Z="uniform mediump float uPointFilterWidth;\n\nvarying mediump vec2 vOffset;  // screen offset from the point center in multiples of radius\nvarying mediump vec3 vPointFont;  // x: radial divisions (0=off, 1=circle, 2=ring, 3=ring+dot), y: angular divisions (0=off, 2=minus, 4=plus, 6=asterisk), z: boldness of radial divisions 0-100 representing % of circle occupied by rings\nvarying mediump float vPointRadius;\n\n{{{utilityFunctions}}}\n\nvec4 getPointColor(vec4 pointColor, vec4 bgColor) {\n    // properties of this fragment in relation to point center\n    vec2 offset = vOffset;\n    float angularSegmentWidth = 0.33 * vPointRadius;\n    float distance = length(offset);\n    float angle = atan(offset.y, offset.x);\n\n    // the style determines the number of radial and angular segments (rounding needed due to precision weirdness)\n    float radialSegmentCount = round(vPointFont[0]);\n    float angularSegmentCount = round(vPointFont[1]);\n\n    // determines thickness of rings\n    float ringFont = clamp(vPointFont[2] / 100.0, 0.0, 1.0);\n\n    // radial pattern\n    float radialOpacity = 0.0;\n    float radialColorMix = 0.0;\n    if (radialSegmentCount > 0.0)\n    {\n        // snap to the closest radial segment\n        float radialStep = vPointRadius / radialSegmentCount;\n        float closestIndex = round(distance / radialStep);\n        // enforce no transitions at center and farther than the perimeter\n        closestIndex = clamp(closestIndex, 1.0, radialSegmentCount);\n        // find the boundary where opacity transition will happen\n        float closestBoundary = closestIndex * radialStep;\n        // flip the order of transitions for even segments (counting from the outside)\n        float flip = 2.0 * mod(radialSegmentCount - closestIndex, 2.0) - 1.0;\n        // find the adjustment for the font (size of each ring * (2x - 1))\n        float fontAdjustment = mix(0.0, vPointRadius / max(radialSegmentCount, 1.0) * (ringFont - 0.5) * 2.0, min(radialSegmentCount, 1.0));\n        // smooth out the opacity transitions to appear antialiased\n        float radialValue = smoothstep(-uPointFilterWidth, uPointFilterWidth, 2.0 * (flip * (distance - closestBoundary) + fontAdjustment));\n        // calculate whether the fragment is inside or outside the outermost ring\n        float isInside = clamp(radialSegmentCount - closestIndex, 0.0, 1.0);\n        // blend with opacity outside glyph, blend with color inside glyph\n        // mix is used with a boolean for faster branching\n        radialOpacity = mix(radialValue, 1.0, isInside);\n        radialColorMix = mix(1.0, radialValue, isInside);\n    }\n\n    // angular pattern\n    float angularOpacity = 0.0;\n    if (angularSegmentCount > 0.0)\n    {\n        //remove color mixing effect from inside rings when an angular pattern is used\n        radialOpacity = min(radialOpacity, radialColorMix);\n        radialColorMix = 1.0;\n\n        // snap to the closest angular segment\n        float angleStep = TAU / angularSegmentCount;\n        float closestAngle = round(angle / angleStep) * angleStep;\n        // opacity will change in the direction perpendicular to the closest angle diameter\n        vec2 perpendicularDirection = vec2(-sin(closestAngle), cos(closestAngle));\n        float perpendicularDistance = abs(dot(offset, perpendicularDirection));\n        // smooth out the opacity transitions to appear antialiased\n        angularOpacity = smoothstep(-uPointFilterWidth, uPointFilterWidth, angularSegmentWidth - 2.0 * perpendicularDistance);\n    }\n\n    // fade to transparent at the outer perimeter of the glyph\n    float perimeterOpacity = smoothstep(-uPointFilterWidth, 0.0, vPointRadius - distance);\n\n    // combine the total opacity scale by adding the angular and radial styles, and cropping them with the perimeter\n    float opacityScale = min(perimeterOpacity, max(angularOpacity, radialOpacity));\n\n    // determine the color mix of this fragment based on angular shape and radial ring location\n    float colorScale = max(angularOpacity, radialColorMix);\n\n    // empty style results in a solid rectangle\n    // Note: the isEmpty variable is employed because, on some systems, putting the statement directly in the\n    // max() function will result in an ambiguously overloaded function call.\n    float isEmpty = float(radialSegmentCount + angularSegmentCount == 0.0);\n    opacityScale = max(opacityScale, isEmpty);\n    colorScale = max(colorScale, isEmpty);\n\n    // mix the colors and opacity\n    vec4 mixedColor = mix(bgColor, pointColor, colorScale);\n    mixedColor.a *= clamp(opacityScale, 0.0, 1.0);\n\n    return mixedColor;\n}\n"},69375:function(e,t){"use strict";t.Z="#ifndef SECTION_PLANE_CLIPPING_FUNCTIONS\n\n#define SECTION_PLANE_CLIPPING_FUNCTIONS 1\n\nuniform mediump mat4  uSectionPlaneEquations;\nuniform mediump float uSectionPlaneCount;\nuniform lowp int    uClippedBySectionPlanes;\n\n// This is used to add some tolerance to the clipping tests so that the face that defines the section plane is\n// not clipped itself. This value is provided by the application so that it can be modulated by the model bounds\n// such that large depth ranges will have a large threshold.\nuniform float uEndcapZFightingThreshold;\n\n// BEL-46902: this is a separate value used to add an offset to the equations that test clip planes against each other.\n// They need a higher tolerance and hence are given a separate value.\nuniform float uInterEndcapZFightingThreshold;\n\nvec4 getSectionPlaneEquation(vec4 selector) {\n  return selector * uSectionPlaneEquations;\n}\n\nbool passesSectionPlaneClippingTest(vec3 cameraPosition) {\n  // TODO: is it quicker to early exit with a branch or just always do the matrix multiply?\n  if (uClippedBySectionPlanes == 0 || uSectionPlaneCount < 1.0) {\n    return true;\n  } else {\n    vec4 planeResults = uSectionPlaneEquations * vec4(cameraPosition, 1.0);\n\n    bool passes = (uSectionPlaneCount < 1.0 || planeResults.x > uEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 2.0 || planeResults.y > uEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 3.0 || planeResults.z > uEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 4.0 || planeResults.w > uEndcapZFightingThreshold);\n\n    return passes;\n  }\n}\n\nbool passesNormalSectionPlaneClippingTest(vec3 cameraPosition) {\n  // TODO: is it quicker to early exit with a branch or just always do the matrix multiply?\n  if (uClippedBySectionPlanes == 0 || uSectionPlaneCount < 1.0) {\n    return true;\n  } else {\n    vec4 dotResults = vec4(0.0);\n\n    for (int i = 0; i < 4; i++) {\n      vec4 selector = vec4(0.0);\n      selector[i] = 1.0;\n      vec4 normal = getSectionPlaneEquation(selector);\n      dotResults[i] = normal[2];// equivalent to dot'ing with vec3(0.0, 0.0, 1.0), the camera space look vector\n    }\n\n    vec4 planeResults = uSectionPlaneEquations * vec4(cameraPosition, 1.0);\n\n    bool passes = (uSectionPlaneCount < 1.0 || dotResults[0] > 0.0 || planeResults.x > uEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 2.0 || dotResults[1] > 0.0 || planeResults.y > uEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 3.0 || dotResults[2] > 0.0 || planeResults.z > uEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 4.0 || dotResults[3] > 0.0 || planeResults.w > uEndcapZFightingThreshold);\n\n    return passes;\n  }\n}\n\nbool passesAllButOneSectionPlaneClippingTest(vec3 cameraPosition, vec4 selector) {\n  // TODO: is it quicker to early exit with a branch or just always do the matrix multiply?\n  if (uSectionPlaneCount < 1.0) {\n    return true;\n  } else {\n    vec4 planeResults = uSectionPlaneEquations * vec4(cameraPosition, 1.0);\n\n    bool passes = (uSectionPlaneCount < 1.0 || selector[0] > 0.0 || planeResults.x > uInterEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 2.0 || selector[1] > 0.0 || planeResults.y > uInterEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 3.0 || selector[2] > 0.0 || planeResults.z > uInterEndcapZFightingThreshold);\n    passes = passes && (uSectionPlaneCount < 4.0 || selector[3] > 0.0 || planeResults.w > uInterEndcapZFightingThreshold);\n\n    return passes;\n  }\n}\n\n#endif\n"},24180:function(e,t){"use strict";t.Z="#define outsideIsolationOrder 256.0\n#define partCountOrder 16.0"},66197:function(e,t){"use strict";t.Z="uniform mediump mat4  uSectionPlaneTangents;\nuniform mediump mat4  uSectionPlaneCenters;\n\n{{{sectionPlaneConstants}}}\n{{{sectionPlaneClippingFunctions}}}\n\nvec4 getSectionPlaneTangent(vec4 selector) {\n  return selector * uSectionPlaneTangents;\n}\n\nvec4 getSectionPlaneCenter(vec4 selector) {\n  return selector * uSectionPlaneCenters;\n}\n\nvoid getSectionPlaneFrame(vec4 selector, out vec3 point, out vec3 uAxis, out vec3 vAxis) {\n  vec4 equation = getSectionPlaneEquation(selector);\n  point = getSectionPlaneCenter(selector).xyz;\n\n  uAxis = getSectionPlaneTangent(selector).xyz;\n  vAxis = cross(equation.xyz, -uAxis);\n}\n\n// get the number of parts outside of isolate and number of total parts intersected\nvec2 getIsolateAndInterferenceInfoFromAlpha(float alpha) {\n  float outsideIsolationCount = floor(alpha / outsideIsolationOrder);\n  float higherBits = outsideIsolationCount * outsideIsolationOrder;\n  float partCount = floor((alpha - higherBits) / partCountOrder);\n  return vec2(outsideIsolationCount, partCount);\n}\n"},60872:function(e,t){"use strict";t.Z="vec4 medianFilterEndcapSamples(vec4 sample0, vec4 sample1, vec4 sample2) {\n  sample0 = abs(sample0);\n  sample1 = abs(sample1);\n  sample2 = abs(sample2);\n\n  // Compute the median alpha value. This small median filter is necessary for robustness in the cases of\n  // single-pixel cracks or rasterization errors that can sometimes appear on large assemblies.\n  vec4 selectedSample = sample1;\n  if ((sample1.a <= sample0.a && sample0.a <= sample2.a) ||\n      (sample2.a <= sample0.a && sample0.a <= sample1.a)) {\n    selectedSample = sample0;\n  } else if ((sample0.a <= sample2.a && sample2.a <= sample1.a) ||\n             (sample1.a <= sample2.a && sample2.a <= sample0.a)) {\n    selectedSample = sample2;\n  }\n\n  return selectedSample;\n}\n"},89712:function(e,t){"use strict";t.Z="uniform lowp float uSectionPlanePatternFade;\nuniform lowp float uSectionPlanePatternThickness;\nuniform lowp float uSectionPlanePatternPacingVariation;\nuniform mediump float uSectionPlanePatternScale;\nuniform lowp vec4 uSectionPlaneIntersectingColor;\nuniform lowp vec4 uSectionPlanePreSelectColor;\nuniform lowp vec4 uSectionPlaneSelectColor;\nuniform lowp float uSectionPlanePatternIsBlackAndWhite;\nuniform lowp float uSectionPlaneEndcapAlpha;\nuniform lowp float uSectionPlaneIsPreSelected;\nuniform lowp float uSectionPlaneIsSelected;\nuniform lowp mat4 uSectionPlaneSelectorColor;\nuniform lowp float uSectionPlaneIsolateContextOpacity;\nuniform lowp float uSectionPlaneIntersectingAdditionalAlpha;\n\n#define SECTION_PLANE_SELECTOR_COLOR_MIX 0.1\n\n{{{sectionPlaneEndcapFunctions}}}\n\nfloat getColorHash(vec4 color) {\n  return mod(color.r * 1000.0, 1000.0) + mod(color.g * 1000.0, 1000.0) + mod(color.b + 1000.0, 1000.0);\n}\n\n// Maps the position of the fragment in the section plane to a sawtooth ramp from 0.0 to 1.0.\n// The direction of the hatching is determined by hashing the incoming part color.\nfloat getHatchingCycle(vec2 inPlanePosition, vec4 incomingColor, float pace) {\n  float colorHash = getColorHash(incomingColor);\n  vec2 hatchDirection = vec2(cos(colorHash), sin(colorHash));\n  float hatchDistance = dot(hatchDirection, inPlanePosition);\n  return mod(hatchDistance, uSectionPlanePatternScale * pace) / (uSectionPlanePatternScale * pace);\n}\n\n// Takes the hatching sawtooth function and runs it through a smooth step transfer function\n// that produces a step from 0.0 to 1.0 to 0.0 again. The cycle is scaled by a variable based\n// on the color. The first edge of the smooth step is set by the uSectionPlanePatternThickness.\n// The smoothness is a constant factor of the hatching scale.\nfloat getHatchingSmoothstep(vec2 inPlanePosition, vec4 incomingColor) {\n  float rolloffWidth = min(uSectionPlanePatternThickness / 2.0, 0.1);\n  float interiorWidth = uSectionPlanePatternThickness - rolloffWidth * 2.0;\n\n  float colorMod = mod(getColorHash(incomingColor), 1.0);\n  float variation = uSectionPlanePatternPacingVariation;\n  float cyclePace = mix(1.0, variation * variation, colorMod) / variation;\n\n  float cycle = getHatchingCycle(inPlanePosition, incomingColor, cyclePace);\n\n  float stepWidth = rolloffWidth / cyclePace;\n  float upEdge = 1.0 - stepWidth - interiorWidth / cyclePace;\n  float stepup = smoothstep(upEdge - stepWidth, upEdge, cycle);\n  float stepdown = 1.0 - smoothstep(1.0 - stepWidth, 1.0, cycle);\n  return (cycle < upEdge) ? stepup : stepdown;\n}\n\n// Get the hatching pattern color. If the brightest component of the incoming color is\n// small, the pattern color will be a brighter version of the incoming color, otherwise it\n// will be a darker version.\nvec4 getHatchingColor(vec2 inPlanePosition, vec4 incomingColor, out float smoothedCycle) {\n  const float DARK_THRESHOLD = 0.4;\n  const float BLACK_AND_WHITE_DARK_LEVEL = 0.4;\n\n  vec4 baseColor = mix(incomingColor, vec4(1.0, 1.0, 1.0, 1.0), uSectionPlanePatternIsBlackAndWhite);\n  float patternFade = mix(uSectionPlanePatternFade, BLACK_AND_WHITE_DARK_LEVEL, uSectionPlanePatternIsBlackAndWhite);\n\n  float maxComponent = max(baseColor.r, max(baseColor.g, baseColor.b));\n  bool incomingIsDark = maxComponent < DARK_THRESHOLD;\n\n  smoothedCycle = getHatchingSmoothstep(inPlanePosition, incomingColor);\n\n  if (incomingIsDark) {\n    float brightenAmount = mix(0.0, (1.0 - patternFade) * 2.0, smoothedCycle);\n    vec4 colorWhenIncomingIsBlack = vec4(brightenAmount, brightenAmount, brightenAmount, 1.0);\n    vec4 colorWhenIncomingIsDark = vec4(incomingColor.rgb * (1.0 + brightenAmount), 1.0);\n\n    return mix(colorWhenIncomingIsBlack, colorWhenIncomingIsDark, maxComponent / DARK_THRESHOLD);\n  } else {\n    float darkenAmount = mix(1.0, patternFade, smoothedCycle);\n    return vec4(baseColor.rgb * darkenAmount, 1.0);\n  }\n}\n\nvec4 getSectionPlaneColor(vec4 selector, vec3 position, vec4 incomingColor, out float hatchingOpacity) {\n\n  float alpha = incomingColor.a;\n  vec2 outsideIsolationCountAndTotalPartCount = getIsolateAndInterferenceInfoFromAlpha(alpha);\n  float outsideIsolationCount = outsideIsolationCountAndTotalPartCount[0];\n  float partCount = outsideIsolationCountAndTotalPartCount[1];\n  float higherBits = (outsideIsolationCount * outsideIsolationOrder) + (partCount * partCountOrder);\n  float finalAlphaColor = clamp(alpha - higherBits, 0.0, 1.0);\n  float isolatedCount = partCount - outsideIsolationCount;\n  if (isolatedCount == 0.0)\n  {\n    finalAlphaColor *= uSectionPlaneIsolateContextOpacity;  // If all parts are outside isolation, mute them\n  }\n\n  float isIntersecting = 0.0;\n  if (partCount > 1.0) {\n    isIntersecting = 1.0;\n    finalAlphaColor = clamp(finalAlphaColor + uSectionPlaneIntersectingAdditionalAlpha, 0.0, 1.0);\n  }\n\n  vec3 center, uAxis, vAxis;\n  getSectionPlaneFrame(selector, center, uAxis, vAxis);\n\n  vec3 offset = position - center;\n  vec2 texCoord = vec2(dot(uAxis, offset), dot(vAxis, offset));\n\n  vec4 hatchingColor = getHatchingColor(texCoord, incomingColor, hatchingOpacity);\n  vec4 unselectedColor = mix(hatchingColor, uSectionPlaneIntersectingColor, isIntersecting);\n  unselectedColor = mix(unselectedColor, selector * uSectionPlaneSelectorColor, SECTION_PLANE_SELECTOR_COLOR_MIX);\n\n  vec4 preselectedColor = mix(unselectedColor, uSectionPlanePreSelectColor, uSectionPlaneIsPreSelected * uSectionPlanePreSelectColor.a);\n  vec4 selectedColor = mix(preselectedColor, uSectionPlanePreSelectColor, uSectionPlaneIsSelected * uSectionPlaneSelectColor.a);\n  return vec4(selectedColor.rgb, finalAlphaColor * uSectionPlaneEndcapAlpha);\n}\n"},78415:function(e,t){"use strict";t.Z="{{{sectionPlaneClippingFunctions}}}\n\n#if defined USE_SECTION_PLANES && !defined SKIP_SECTION_PLANES\n\nvoid discardIfPositionFailsSectionPlaneClippingTest(vec3 position) {\n  if (!passesSectionPlaneClippingTest(position)) {\n    discard;\n  }\n}\n\nvoid discardIfPositionFailsNormalSectionPlaneClippingTest(vec3 position) {\n  if (!passesNormalSectionPlaneClippingTest(position)) {\n    discard;\n  }\n}\n\nvoid discardIfPositionFailsAllButOneSectionPlaneClippingTest(vec3 position, vec4 selector) {\n  if (!passesAllButOneSectionPlaneClippingTest(position, selector)) {\n    discard;\n  }\n}\n\n#define DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(x) discardIfPositionFailsSectionPlaneClippingTest(x)\n\n#define DISCARD_IF_POSITION_FAILS_NORMAL_SECTION_PLANE_CLIPPING_TEST(x) discardIfPositionFailsNormalSectionPlaneClippingTest(x)\n\n#define DISCARD_IF_POSITION_FAILS_ALL_BUT_ONE_SECTION_PLANE_CLIPPING_TEST(x, y) discardIfPositionFailsAllButOneSectionPlaneClippingTest(x, y)\n\n#else\n\n#define DISCARD_IF_POSITION_FAILS_SECTION_PLANE_CLIPPING_TEST(x)\n\n#define DISCARD_IF_POSITION_FAILS_NORMAL_SECTION_PLANE_CLIPPING_TEST(x)\n\n#define DISCARD_IF_POSITION_FAILS_ALL_BUT_ONE_SECTION_PLANE_CLIPPING_TEST(x, y)\n\n#endif\n\n\n"},86826:function(e,t){"use strict";t.Z="// These attributes and varyings mimic two mat4 matrices with 4 vec4 varyings.  From the CPU client perspective\n// the attributes are bound the same.  However, some GPU drivers do not appear to handle mat4 attributes and varyings\n// properly.  (See BEL-188540)\nattribute vec4 aContactTraction;\nattribute vec4 aContactTraction1;\nattribute vec4 aContactTraction2;\nattribute vec4 aContactTraction3;\nattribute vec4 aContactPairCoordinate;\nattribute vec4 aContactPairCoordinate1;\nattribute vec4 aContactPairCoordinate2;\nattribute vec4 aContactPairCoordinate3;\n\nvarying vec4 vContactTraction;\nvarying vec4 vContactTraction1;\nvarying vec4 vContactTraction2;\nvarying vec4 vContactTraction3;\nvarying vec4 vContactPairCoordinate;\nvarying vec4 vContactPairCoordinate1;\nvarying vec4 vContactPairCoordinate2;\nvarying vec4 vContactPairCoordinate3;\n\n#define CUSTOM_VARYING_SETTINGS { \\\n  vContactTraction = aContactTraction; \\\n  vContactTraction2 = aContactTraction1; \\\n  vContactTraction2 = aContactTraction2; \\\n  vContactTraction3 = aContactTraction3; \\\n  vContactPairCoordinate = aContactPairCoordinate; \\\n  vContactPairCoordinate1 = aContactPairCoordinate1; \\\n  vContactPairCoordinate2 = aContactPairCoordinate2; \\\n  vContactPairCoordinate3 = aContactPairCoordinate3; \\\n}\n"},64413:function(e,t){"use strict";t.Z='// This file contains the body of a function that can be parameterized with macros.  The function will sample\n// in the neighborhood around the fragment being shaded by fs-draw-draftAnalysis.glsl.  The samples it is taking are\n// whether or not a given location is undercut.  The body will return a weight that can be used to shade the fragment\n// with a corresponding contribution from the undercut color.  The result is akin to doing percentage-closer shadow\n// filtering on a shadow map.\n// The macros that can be configured are:\n//\n//   FILTER_RADIUS - the "radius" of the box filter in each direction of the draft shadow map texture. The total\n//   number of samples in each direction is 2*FILTER_RADIUS + 1\n//\n//   SAMPLE_BIAS_FACTOR - this biases the number of undercut samples in order to negate some sampling errors that result\n//   from aliasing in the shadow map.  For example, a bias of 0.75 means that three quarters of the samples need be\n//   classified as undercut before the fragment is considered to be undercut.  A value of 0.5, is a lower threshold and\n//   only half the samples need to be classified as undercut for the fragment to be considered undercut.  After the\n//   bias is applied, the remainder of the sample magnitude is utilized to provide a smooth transition in weights from\n//   0.0 (no undercut) to 1.0 (full undercut)\n\n  vec3 with = sampleLocation(uPMVMatrixWith);\n  vec3 against = sampleLocation(uPMVMatrixAgainst);\n\n  vec2 withLocation = with.xy;\n  vec2 againstLocation = against.xy;\n  float withDepth = with.z;\n  float againstDepth = against.z;\n\n  float undercutSamples = 0.0;\n\n  float shadowBias = max(0.003 * (1.0 - normalDotDraftDirection), 0.0001);\n\n  float totalSamples = (2.0 * FILTER_RADIUS + 1.0) * (2.0 * FILTER_RADIUS + 1.0);\n  for (float x = -FILTER_RADIUS; x <= FILTER_RADIUS; x += 1.0) {\n    for (float y = -FILTER_RADIUS; y <= FILTER_RADIUS; y += 1.0) {\n      vec4 sample = texture2D(uDraftShadowMap, vec2(withLocation.x + x * uDraftShadowMapPixelWidth, withLocation.y + y * uDraftShadowMapPixelHeight));\n      if (withDepth - shadowBias > sample[0] && againstDepth - shadowBias > sample[1]) {\n        undercutSamples += 1.0;\n      }\n    }\n  }\n\n  float sampleBias = totalSamples * SAMPLE_BIAS_FACTOR;\n  return clamp((undercutSamples - sampleBias) / (totalSamples - sampleBias), 0.0, 1.0);\n'},41277:function(e,t){"use strict";t.Z="// square root of 2\n#define SQRT2 1.41421356237\n\n// full circle in radians\n#define TAU 6.28318530718\n\n// 1.0 / 255.0\n#define ONE_255 0.0039215686\n\n// 0.5 / 255.0\n#define HALF_255 .0019607843\n\n// A constant to convert from a fraction of a byte to a normalized float between 0 and 1.0.  This is useful\n// for creating byte encodings in color channels.  It equates to 256.0 / 255.0\n#define BYTE_FRACTION_TO_NORMALIZED_FLOAT 1.0039215686\n\n// An epsilon value to avoid division by zero.\n#define EPSILON 0.000001\n\n// used in weight functions for faster computation of standard powers\n#define SQUARED(x) ((x)*(x))\n#define CUBED(x) ((x)*(x)*(x))\n#define FOURTH_POWER(x) ((x)*(x)*(x)*(x))\n\nfloat round(float value) {\n  // return the value rounded to the nearest integer\n  return floor(value + 0.5);\n}\n\nfloat impulse(float value, float variable) {\n  // return the Dirac delta function at value for variable (1 iff variable == value, 0 otherwise)\n  return step(value, variable) * step(-value, -variable);\n}\n\n// Slop factor to work around imprecise calculations on some amd cards/drivers.  1 / 256 is the closest a number\n// can be to 0.5 in the isBitSet calculation and still _not_ have the bit set (i.e., the bit field is 0x7F and\n// we are checking to see if bit 8 is set).  For that case, we take half the minimum distance: 0.5 / 255\n#define HALF_256 0.001953125\n\n/**\n * Determines if the given bit is set in the normalizedFlags variable\n * @param normalizedFlags a number in the range 0-1.0 that comes from a normalized 8-bit attribute\n * @param bitShiftMultiplier a constant that will shift the normalized value such that the fractional component can be used to determine if the bit is set\n */\nbool isBitSet(float normalizedFlags, float bitShiftMultiplier) {\n  float shifted = normalizedFlags * bitShiftMultiplier;\n  // If the fractional portion is greater than or equal to 0.5, the bit is set.\n  // We use a greater than comparison with a tolerance to work around precision issues on some AMD drivers.\n  return (shifted - floor(shifted)) > 0.5 - HALF_256;\n}\n\n// Helper macros that setup bit tests for different bits.  For bit N, the multiplier is 255 / 2^N\n#define IS_BIT_1_SET(normalizedFlags) isBitSet(normalizedFlags, 255.0 / 2.0)\n\nbool interiorHighlightIsSuppressed(float normalizedFlags) {\n    return isBitSet(normalizedFlags, 255.0 / 4.0);\n}\n\n/**\n * Compare two numbers with the given tolerance.\n * @return True if the difference between the numbers is less than the tolerance\n */\nbool compareWithTolerance(float number1, float number2, float tolerance) {\n  return abs(number1 - number2) < tolerance;\n}\n\n// Returns a grayscale value for the given rgb color\nvec3 rgbToGrayscale(vec3 rgb) {\n  // Coefficients found here:  http://www.tannerhelland.com/3643/grayscale-image-algorithm-vb6/\n  float gray = rgb.r * 0.299 + rgb.g * 0.587 + rgb.b * 0.114;\n  return vec3(gray, gray, gray);\n}\n\n// Splits the given value into whole and fractional components\nfloat modf(float value, out float whole) {\n  whole = floor(value);\n  return value - whole;\n}\n\nvec2 getNearFar(mat4 uPMatrix) {\n    vec2 nearFar;\n    float a = uPMatrix[2][2];\n    float b = uPMatrix[3][2];\n    float nearOrthographic = (b + 1.0) / a;\n    float farOrthographic = (b - 1.0) / a;\n    float nearPerspective = b / (a - 1.0);\n    float farPerspective = b / (a + 1.0);\n    nearFar.x = uPMatrix[3][3] * nearOrthographic - uPMatrix[2][3] * nearPerspective;\n    nearFar.y = uPMatrix[3][3] * farOrthographic - uPMatrix[2][3] * farPerspective;\n    return nearFar;\n}\n\n// Functions from http://lolengine.net/blog/2013/07/27/rgb-to-hsv-in-glsl\nvec3 rgb2hsv(vec3 c) {\n    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);\n    vec4 p = c.g < c.b ? vec4(c.bg, K.wz) : vec4(c.gb, K.xy);\n    vec4 q = c.r < p.x ? vec4(p.xyw, c.r) : vec4(c.r, p.yzx);\n\n    float d = q.x - min(q.w, q.y);\n    float e = 1.0e-10;\n    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);\n}\n\nvec3 hsv2rgb(vec3 c) {\n    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);\n    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);\n    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);\n}\n\n/**\n * Blends sourceColor on top of destinationColor and returns the result.  This achieves a similar effect to\n * using gl.blendFuncSeparate(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA, gl.ONE, gl.ONE_MINUS_SRC_ALPHA);\n */\nvec4 blendColors(vec4 destinationColor, vec4 sourceColor) {\n    destinationColor.rgb = clamp(destinationColor.rgb * (1.0 - sourceColor.a) + sourceColor.rgb * sourceColor.a, 0.0, 1.0);\n    destinationColor.a = clamp(destinationColor.a * (1.0 - sourceColor.a) + sourceColor.a, 0.0, 1.0);\n    return destinationColor;\n}\n\n// Translates a vector to normal space coords for visualizing direction. This is intended for debug purposes.\nvec3 vecToNormalSpace(vec3 v) {\n    return vec3(.5) + (normalize(v) * .5);\n}"},9063:function(e,t){"use strict";t.Z="\nattribute vec4 aPickId;\n\n{{{picking}}}\n\nvec4 getPickingId() {\n  return encodePickingId(uOccurrenceId, aPickId);\n}\n"},76395:function(e,t){"use strict";t.Z="\nuniform float uOccurrenceId;\n\nuniform bool uOutsideIsolation;\nuniform float uIsolateContextOpacity;\n\n#define OFF_SCREEN_POSITION vec4(5.0, 5.0, 5.0, 1.0)\n\nvec2 ndcToScreen(vec4 ndc, vec4 viewport) {\n  return vec2((ndc.x * 0.5 + 0.5) * viewport[2],\n              (ndc.y * 0.5 + 0.5) * viewport[3]);\n}\n"},4669:function(e,t){"use strict";t.Z="{{{setContactVaryings}}}\n{{{vs-OITAccumulation}}}\n"},8809:function(e,t){"use strict";t.Z="{{{vs-OITAccumulation}}}"},39887:function(e,t){"use strict";t.Z="varying highp vec3 vModelPosition;\n#define CUSTOM_VARYING_SETTINGS vModelPosition = aVertexPosition;\n\n{{{vs-OITAccumulation}}}\n"},24619:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nuniform vec3 uSpecular;\nuniform float uColorAmbientFactor;  //Determines how much of the vertex-specified color to use in the ambient term\nuniform float uColorDiffuseFactor;  //Determines how much of the vertex-specified color to use in the diffuse term\nuniform float uTintFactor;\nuniform vec3 uTintColor;\nuniform bool uApplyTranslucentAlphaToAll;\nuniform float uTranslucentPassAlpha;\nuniform float uIsolateTranslucentAlpha;\n\nuniform float uHighlightSpecularContribution;\n\nattribute vec3 aVertexPosition;\nattribute vec3 aVertexNormal;\nattribute vec2 aTextureCoordinate;\nattribute vec4 aVertexColor;\nattribute vec4 aHighlightId;\n\nvarying vec3 vPosition;\nvarying lowp vec3 vNormal;\nvarying mediump vec2 vTextureCoordinate;\nvarying lowp vec3 vAmbient;\nvarying lowp vec3 vDiffuse;\nvarying lowp vec3 vSpecular;\nvarying lowp float vOpacity;\n\n#ifndef CUSTOM_VARYING_SETTINGS\n#define CUSTOM_VARYING_SETTINGS\n#endif\n\n{{{utilityFunctions}}}\n{{{highlightFunctions}}}\n{{{vertexUtilityFunctions}}}\n\nvoid main(void) {\n  CUSTOM_VARYING_SETTINGS\n\n  vec4 position = uMVMatrix * vec4(aVertexPosition, 1.0);\n  vPosition = position.xyz;\n\n  vNormal = mat3(uMVMatrix) * aVertexNormal;\n  vTextureCoordinate = aTextureCoordinate;\n\n  vec4 highlight = getColorModifiedByHighlight(aHighlightId, aVertexColor);\n\n  bool highlightIsActive = !interiorHighlightIsSuppressed(aHighlightId.a) && IS_BIT_1_SET(aHighlightId.a);\n  float specularContribution = highlightIsActive ? uHighlightSpecularContribution : 1.0;\n\n  vAmbient = uColorAmbientFactor * highlight.rgb;\n  vDiffuse = uColorDiffuseFactor * highlight.rgb;\n\n  vSpecular = uSpecular * (highlight.a > 0.05 ? specularContribution : 1.0);\n\n  if (uOutsideIsolation) {\n      vOpacity = uIsolateTranslucentAlpha;\n  } else {\n      vOpacity = uApplyTranslucentAlphaToAll ? (min(uTranslucentPassAlpha, aVertexColor.a)) : aVertexColor.a;\n  }\n\n  // Tint only affects the ambient (unlit) term of transparent geometry\n  vAmbient = mix(vAmbient, uTintColor*uColorAmbientFactor, uTintFactor);\n\n  gl_Position = uPMatrix * position;\n}\n"},34216:function(e,t){"use strict";t.Z="{{{vs-drawTexture}}}"},99594:function(e,t){"use strict";t.Z="{{{setContactVaryings}}}\n{{{vs-OITRevealage}}}\n"},37606:function(e,t){"use strict";t.Z="{{{vs-OITRevealage}}}"},74897:function(e,t){"use strict";t.Z="varying highp vec3 vModelPosition;\n#define CUSTOM_VARYING_SETTINGS vModelPosition = aVertexPosition;\n\n{{{vs-OITRevealage}}}\n"},15290:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nuniform bool uApplyTranslucentAlphaToAll;\nuniform float uTranslucentPassAlpha;\nuniform float uIsolateTranslucentAlpha;\n\nattribute vec3 aVertexPosition;\nattribute vec2 aTextureCoordinate;\nattribute vec4 aVertexColor;\n\nvarying vec3 vPosition;\nvarying mediump vec2 vTextureCoordinate;\nvarying lowp float vOpacity;\n\n#ifndef CUSTOM_VARYING_SETTINGS\n#define CUSTOM_VARYING_SETTINGS\n#endif\n\n{{{utilityFunctions}}}\n{{{vertexUtilityFunctions}}}\n\nvoid main(void) {\n    CUSTOM_VARYING_SETTINGS\n\n    vec4 position = uMVMatrix * vec4(aVertexPosition, 1.0);\n    vPosition = position.xyz;\n\n    vTextureCoordinate = aTextureCoordinate;\n\n    if (uOutsideIsolation) {\n        vOpacity = uIsolateTranslucentAlpha;\n    } else {\n        vOpacity = uApplyTranslucentAlphaToAll ? (min(uTranslucentPassAlpha, aVertexColor.a)) : aVertexColor.a;\n    }\n\n    gl_Position = uPMatrix * position;\n}\n"},30397:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\nuniform vec4 uViewport;\nuniform float uLineWidth;\nuniform float uSceneDiameter;\n\nuniform mediump float uDevicePixelRatio;\n\nattribute vec3 aVertexPosition;\nattribute vec3 aVertexNormal;\n\nvarying vec3 vNonOffsetPosition;\nvarying float vClampedNdotV;\n\n{{{utilityFunctions}}}\n{{{vertexUtilityFunctions}}}\n\nvoid main(void) {\n  vec3 position = vec3(uMVMatrix * vec4(aVertexPosition, 1.0));\n  vec3 normal = normalize(mat3(uMVMatrix) * aVertexNormal);\n\n  bool isOrthographic = (uPMatrix[3][3] > 0.0);\n  float nDotV = mix(normal.z, dot(-normalize(position), normal), float(!isOrthographic));\n  vClampedNdotV = min(nDotV, 0.0);\n\n  // Offset along the normal by a small amount. TODO: this could perhaps cause issues if the\n  // offsetPosition projects behind the camera in perspective, but testing by pushing the camera through\n  // an object didn't show any problems.\n  vec3 offsetPosition = position + (normal * uSceneDiameter * 0.001);\n\n  vec4 projectedPosition = uPMatrix * vec4(position, 1.0);\n  vec4 projectedOffsetPosition = uPMatrix * vec4(offsetPosition, 1.0);\n\n  vec2 screenPosition = ndcToScreen(projectedPosition / projectedPosition.w, uViewport);\n  vec2 screenOffsetPosition = ndcToScreen(projectedOffsetPosition / projectedOffsetPosition.w, uViewport);\n\n  // Add a small offset to the divisor here to avoid division by zero.\n  float scale = 0.5 * uDevicePixelRatio * uLineWidth / (length(screenPosition - screenOffsetPosition) + EPSILON);\n  // Make sure the scale does not get excessive where the surface normal is close to the camera view\n  // vector. We want the surface offset around the silhouettes, and close to the original surface elsewhere.\n  scale *= (1.0 - abs(nDotV));\n\n  vNonOffsetPosition = position;\n  gl_Position = mix(projectedPosition, projectedOffsetPosition, scale);\n}\n"},1853:function(e,t){"use strict";t.Z="{{{vs-drawTexture}}}\n"},83502:function(e,t){"use strict";t.Z="{{{vs-drawTexture}}}\n"},96225:function(e,t){"use strict";t.Z="{{{vs-drawTexture}}}\n"},63221:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\nuniform mediump vec4 uViewport;\n\n// If set to 1.0, the primitive size in the attribute buffer will be used, otherwise 1.0 will be used.\n// We support both behaviors for the different uses of this shader.  For depth retrieval of a single point, we want\n// to faithfully render the primitives as they were when they were picked.  For depth sampling, we want to minimize\n// the primitives contribution to the depth buffer, since the sample viewport is small.\nuniform float uUsePrimitiveSize;\n\nuniform float uUseHighlightsOnly;\n\nuniform mediump float uDevicePixelRatio;\n\nattribute vec3 aVertexPosition;\nattribute float aPrimitiveSize;\nattribute vec4 aHighlightId;  // R = highlight index, GB = highlight instance id, A = an OR of 0(normal), 1(highlighted)\n\nvarying vec3 vPositionForSection;\n\n#ifdef GL_FRAGMENT_PRECISION_HIGH\n//We want to take advantage of high precision, when available, to avoid losing fidelity in depth;\nvarying highp vec2 vPositionZW;\n#else\nvarying mediump vec2 vPositionZW;\n#endif\n\n{{{utilityFunctions}}}\n{{{vertexUtilityFunctions}}}\n{{{edgeUtilityFunctions}}}\n{{{highlightFunctions}}}\n\nvoid main(void) {\n  vec4 cameraSpacePosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n  vPositionForSection = vec3(cameraSpacePosition);\n\n  // project the vertex position and edge direction\n  gl_Position = uPMatrix * (cameraSpacePosition);\n\n  // offset the projected vertex\n  float lineWidth = mix(1.0, uDevicePixelRatio * aPrimitiveSize, uUsePrimitiveSize);\n  vec2 tangentOffset, normalOffset;\n  computeTangentAndNormalOffsets(uMVMatrix, gl_Position, lineWidth, tangentOffset, normalOffset);\n  gl_Position.xy += tangentOffset + normalOffset;\n\n  //send the vertex outside the clip space if we are using highlights and the vertex is not highlighted\n  float needsDiscard = float(bool(uUseHighlightsOnly) && !entityHasHighlight(aHighlightId.a));\n  gl_Position = mix(gl_Position, OFF_SCREEN_POSITION, needsDiscard);\n\n  vPositionZW = vec2(gl_Position.z, gl_Position.w);\n}\n"},58984:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nuniform float uUseHighlightsOnly;\n\nattribute vec3 aVertexPosition;\nattribute vec4 aHighlightId;  // R = highlight index, GB = highlight instance id, A = an OR of 0(normal), 1(highlighted)\n\nvarying vec3 vPositionForSection;\n\n#ifdef GL_FRAGMENT_PRECISION_HIGH\n//We want to take advantage of high precision, when available, to avoid losing fidelity in depth;\nvarying highp vec2 vPositionZW;\n#else\nvarying mediump vec2 vPositionZW;\n#endif\n\n{{{utilityFunctions}}}\n{{{vertexUtilityFunctions}}}\n{{{highlightFunctions}}}\n\nvoid main(void) {\n    vec4 cameraSpacePosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n    vPositionForSection = vec3(cameraSpacePosition);\n\n    gl_Position = uPMatrix * cameraSpacePosition;\n\n    //send the vertex outside the clip space if we are using highlights and the vertex is not highlighted\n    float needsDiscard = float(bool(uUseHighlightsOnly) && !entityHasHighlight(aHighlightId.a));\n    gl_Position = mix(gl_Position, OFF_SCREEN_POSITION, needsDiscard);\n\n    vPositionZW = vec2(gl_Position.z, gl_Position.w);\n}\n"},83861:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\nuniform vec4 uViewport;\n\n// If set to 1.0, the primitive size in the attribute buffer will be used, otherwise 1.0 will be used.\n// We support both behaviors for the different uses of this shader.  For depth retrieval of a single point, we want\n// to faithfully render the primitives as they were when they were picked.  For depth sampling, we want to minimize\n// the primitives contribution to the depth buffer, since the sample viewport is small.\nuniform float uUsePrimitiveSize;\n\nuniform float uUseHighlightsOnly;\n\nuniform vec3 uBase;\nuniform mediump float uPointFilterWidth;\n\nattribute vec3 aVertexPosition;\nattribute float aPointData;  // corner index: 1=bottom-right, 2=top-right, 3=top-left, 4=bottom-left\nattribute float aPrimitiveSize;\nattribute vec4 aHighlightId;  // R = highlight index, GB = highlight instance id, A = an OR of 0(normal), 1(highlighted)\n\nvarying vec3 vPositionForSection;\n\n#ifdef GL_FRAGMENT_PRECISION_HIGH\n//We want to take advantage of high precision, when available, to avoid losing fidelity in depth;\nvarying highp vec2 vPositionZW;\n#else\nvarying mediump vec2 vPositionZW;\n#endif\n\n{{{utilityFunctions}}}\n{{{vertexUtilityFunctions}}}\n{{{highlightFunctions}}}\n\nvoid main(void) {\n    vec4 cameraSpacePosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n    vPositionForSection = vec3(cameraSpacePosition);\n\n    gl_Position = uPMatrix * cameraSpacePosition;\n\n    float pointRadius = mix(1.0, aPrimitiveSize, uUsePrimitiveSize);\n\n    // make rectangle out of the point\n    vec2 vOffset = impulse(1.0, aPointData) * pointRadius * vec2( 1, -1)\n    + impulse(2.0, aPointData) * pointRadius * vec2( 1,  1)\n    + impulse(3.0, aPointData) * pointRadius * vec2(-1,  1)\n    + impulse(4.0, aPointData) * pointRadius * vec2(-1, -1);\n\n    gl_Position.xy += (2.0 * gl_Position.w) * (vOffset / uViewport.zw);\n\n    //send the vertex outside the clip space if we are using highlights and the vertex is not highlighted\n    float needsDiscard = float(bool(uUseHighlightsOnly) && !entityHasHighlight(aHighlightId.a));\n    gl_Position = mix(gl_Position, OFF_SCREEN_POSITION, needsDiscard);\n\n    vPositionZW = vec2(gl_Position.z, gl_Position.w);\n}\n"},72998:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nattribute vec3 aVertexPosition;\nattribute vec3 aVertexNormal;\n\nvarying vec3 vModelNormal;\nvarying vec3 vCameraPosition;\n\nvoid main(void) {\n    vModelNormal = aVertexNormal;\n    vec4 cameraPosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n    vCameraPosition = cameraPosition.xyz;\n    gl_Position = uPMatrix * cameraPosition;\n}\n"},8079:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nattribute vec3 aVertexPosition;\n\nvarying highp vec3 vPosition;\n\nvoid main(void) {\n    vec4 modelPosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n    vPosition = modelPosition.xyz;\n    gl_Position = uPMatrix * modelPosition;\n}\n"},79810:function(e,t){"use strict";t.Z="varying highp vec3 vWorldPosition;\n\n#define CUSTOM_VARYING_SETTINGS vWorldPosition = aVertexPosition;\n\n{{{vs-draw-faces}}}\n"},81976:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\nuniform mediump vec4 uViewport;\n\nuniform mediump float uLineFilterWidth;\nuniform mediump float uDevicePixelRatio;\n\n#ifdef OIT_SHADER\nuniform float uIsolateTranslucentAlpha;\n#endif\n\nattribute vec3 aVertexPosition;\nattribute vec4 aVertexColor;\nattribute float aPrimitiveSize; //line width\nattribute vec4 aPrimitiveStyle;\n\nvarying lowp vec4 vColor;\nvarying mediump vec4 vLineStipple;\nvarying mediump float vLineWidth;\nvarying mediump float vDistance;  // signed distance from line center in pixels\nvarying highp float vLength;  // edge length at this vertex in pixels\nvarying highp vec3 vPosition; // camera-space fragment position\n#ifdef GL_FRAGMENT_PRECISION_HIGH\n//We want to take advantage of high precision, when available, to avoid losing fidelity in depth;\nvarying highp float vDepth;\n#else\nvarying float vDepth;\n#endif\n\n{{{utilityFunctions}}}\n{{{vertexUtilityFunctions}}}\n{{{edgeUtilityFunctions}}}\n\nvoid main(void) {\n  vColor = aVertexColor;\n  float lineWidth = 0.0;\n  if (uUsePrimitiveLines == 0.0) {\n    vLineStipple = aPrimitiveStyle;\n    // Record the actual line width for use in the fragment shader.\n    vLineWidth = uDevicePixelRatio * aPrimitiveSize;\n\n    // widen the line to encompass enough fragments for edge filtering (even in the worst-case diagonal direction)\n    lineWidth = vLineWidth + uLineFilterWidth * SQRT2;\n  }\n\n  // project the vertex position and edge direction\n  vec4 cameraPosition = (uMVMatrix * vec4(aVertexPosition, 1.0));\n  gl_Position = uPMatrix * cameraPosition;\n\n  vPosition = cameraPosition.xyz;\n\n  if (uUsePrimitiveLines == 0.0) {\n  // compute the signed distance of this vertex from the line center\n  vDistance = 0.5 * lineWidth * edgeNormalDirectionFlag(edgeCornerIndex());\n\n  vec2 nearFar = getNearFar(uPMatrix);\n  vDepth = (-cameraPosition.z - nearFar.x) / (nearFar.y - nearFar.x);\n\n  // compute edge length at this vertex in pixels (used for stippling)\n  float worldToPixel = abs(uPMatrix[0][0] / gl_Position.w) * 0.5 * uViewport.z;\n  vLength = mix(edgeLength() * worldToPixel, 0.0, float(edgeIsInfinite()));  // disable line stipple for infinite lines\n\n  if (uOutsideIsolation) {\n#ifdef OIT_SHADER\n    vColor.a = uIsolateTranslucentAlpha;\n#else\n    vColor.a *= uIsolateContextOpacity;\n#endif\n  }\n\n  vec2 tangentOffset, normalOffset;\n  computeTangentAndNormalOffsets(uMVMatrix, gl_Position, lineWidth, tangentOffset, normalOffset);\n  gl_Position.xy += tangentOffset + normalOffset;\n  }\n}\n"},33207:function(e,t){"use strict";t.Z="{{{vs-draw-endcap}}}\n"},19817:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform mat4 uPMatrix;\nuniform float uSceneDiameter;\nuniform vec4 uPlaneSelector;\n\nattribute vec3 aVertexPosition;\n\nvarying vec3 vPosition;\n\n{{{sectionPlaneEndcapFunctions}}}\n\nvoid main(void) {\n    vec3 point, uAxis, vAxis;\n\n    getSectionPlaneFrame(uPlaneSelector, point, uAxis, vAxis);\n\n    // Scale the points to make sure they are outside the scene bounding box by a comfortable margin\n    uAxis *= uSceneDiameter * 10.0;\n    vAxis *= uSceneDiameter * 10.0;\n\n    vPosition = point + uAxis * aVertexPosition.x + vAxis * aVertexPosition.y;\n\n    gl_Position = uPMatrix * vec4(vPosition, 1.0);\n}\n"},26001:function(e,t){"use strict";t.Z="{{{setContactVaryings}}}\n{{{vs-draw-faces}}}\n"},56064:function(e,t){"use strict";t.Z="{{{vs-draw-faces}}}"},13630:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nattribute vec3 aVertexPosition;\nattribute vec3 aVertexNormal;\n\nvarying highp vec3 vPosition;\nvarying highp vec3 vModelPosition;\nvarying lowp vec3 vNormal;\nvarying lowp float vOpacity;\n\n{{{vertexUtilityFunctions}}}\n\nvoid main(void) {\n  vModelPosition = aVertexPosition;\n\n  vec4 position = uMVMatrix * vec4(aVertexPosition, 1.0);\n  vPosition = position.xyz;\n\n  vNormal = mat3(uMVMatrix) * aVertexNormal;\n\n  vOpacity = 1.0;\n  if (uOutsideIsolation) {\n    vOpacity *= uIsolateContextOpacity;\n  }\n\n  gl_Position = uPMatrix * position;\n}\n"},23335:function(e,t){"use strict";t.Z="uniform float uOffsetFactor;\n\nattribute vec3 aOffsetVector;\n\n#define POSITION_SETTING_ROUTINE vec3 offsetPosition = aVertexPosition + aOffsetVector * uOffsetFactor; vec4 position = uMVMatrix * vec4(offsetPosition, 1.0);\n\n{{{vs-draw-faces}}}\n"},45108:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nuniform vec3 uSpecular;\nuniform float uOpacity;\nuniform float uColorAmbientFactor;  //Determines how much of the vertex-specified color to use in the ambient term\nuniform float uColorDiffuseFactor;  //Determines how much of the vertex-specified color to use in the diffuse term\n\nuniform float uHighlightSpecularContribution;\n\nuniform bool uApplyTranslucentAlphaToAll;\nuniform float uTranslucentPassAlpha;\n\nattribute vec3 aVertexPosition;\nattribute vec3 aVertexNormal;\nattribute vec2 aTextureCoordinate;\nattribute vec4 aVertexColor;\nattribute vec4 aHighlightId;\n\n#ifndef CUSTOM_VARYING_SETTINGS\n#define CUSTOM_VARYING_SETTINGS\n#endif\nvarying highp vec3 vPosition;\nvarying lowp vec3 vNormal;\nvarying mediump vec2 vTextureCoordinate;\nvarying lowp vec3 vAmbient;\nvarying lowp vec3 vDiffuse;\nvarying lowp vec3 vSpecular;\nvarying lowp float vOpacity;\nvarying lowp float vIsolateOverrideOpacity;\nvarying mat4 vMVMatrix;\n\n{{{utilityFunctions}}}\n{{{highlightFunctions}}}\n{{{vertexUtilityFunctions}}}\n\n// This will set the view-space position of the vertex.  This can be overridden to animate the vertex in some fashion\n#ifndef POSITION_SETTING_ROUTINE\n#define POSITION_SETTING_ROUTINE vec4 position = uMVMatrix * vec4(aVertexPosition, 1.0);\n#endif\n\n#ifndef TEXTURE_COORD_SETTING_ROUTINE\n#define TEXTURE_COORD_SETTING_ROUTINE vTextureCoordinate = aTextureCoordinate;\n#endif\n\nvoid main(void) {\n  CUSTOM_VARYING_SETTINGS\n\n  POSITION_SETTING_ROUTINE\n\n  vPosition = position.xyz;\n  vMVMatrix = uMVMatrix;\n\n  vNormal = mat3(uMVMatrix) * aVertexNormal;\n  TEXTURE_COORD_SETTING_ROUTINE\n\n  vec4 highlight = getColorModifiedByHighlight(aHighlightId, aVertexColor);\n\n  bool highlightIsActive = !interiorHighlightIsSuppressed(aHighlightId.a) && IS_BIT_1_SET(aHighlightId.a);\n  float specularContribution = highlightIsActive ? uHighlightSpecularContribution : 1.0;\n\n  vAmbient = uColorAmbientFactor * highlight.rgb;\n  vDiffuse = uColorDiffuseFactor * highlight.rgb;\n\n  // For highlights with no (or very little) interior color, we don't want to modify the specular contribution of the face,\n  // so here we check the opacity of the highlight to determine correct specular behavior.\n  vSpecular = uSpecular * (highlight.a > 0.05 ? specularContribution : 1.0);\n\n  vOpacity = uApplyTranslucentAlphaToAll ? (min(uTranslucentPassAlpha, aVertexColor.a)) : aVertexColor.a;\n  vIsolateOverrideOpacity = 1.0;\n\n  if (uOutsideIsolation) {\n    vOpacity *= uIsolateContextOpacity;\n    vIsolateOverrideOpacity = uIsolateContextOpacity;\n  }\n\n  gl_Position = uPMatrix * position;\n}\n"},99532:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\nuniform mediump vec4 uViewport;\n\nuniform mediump float uPointFilterWidth;\n\nuniform mediump float uDevicePixelRatio;\n\nattribute vec3 aVertexPosition;\nattribute float aPointData;  // corner index: 1=bottom-right, 2=top-right, 3=top-left, 4=bottom-left\nattribute vec4 aVertexColor;\nattribute float aPrimitiveSize;\nattribute vec4 aPrimitiveStyle;\n\nvarying lowp vec4 vColor;\nvarying mediump vec2 vOffset;  // screen offset from the point center in multiples of radius\nvarying mediump vec3 vPointFont;\nvarying mediump float vPointRadius;\n#ifdef GL_FRAGMENT_PRECISION_HIGH\n//We want to take advantage of high precision, when available, to avoid losing fidelity in depth;\nvarying highp float vDepth;\n#else\nvarying float vDepth;\n#endif\n\n{{{utilityFunctions}}}\n{{{vertexUtilityFunctions}}}\n{{{sectionPlaneClippingFunctions}}}\n\nvoid main(void) {\n  vec4 cameraPosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n  if (!passesSectionPlaneClippingTest(cameraPosition.xyz)) {\n    gl_Position = vec4(5.0, 5.0, 5.0, 1.0);  //Put the vertex comfortably outside clip space\n    return;\n  }\n\n  gl_Position = uPMatrix * cameraPosition;\n\n  vec2 nearFar = getNearFar(uPMatrix);\n  vDepth = (-cameraPosition.z - nearFar.x) / (nearFar.y - nearFar.x);\n\n  vColor = aVertexColor;\n\n  if (uOutsideIsolation) {\n    vColor.a *= uIsolateContextOpacity;\n  }\n\n  vPointFont = aPrimitiveStyle.xyz;\n  vPointRadius = uDevicePixelRatio * 0.5 * aPrimitiveSize;\n\n  float pointRadius = vPointRadius + 0.5 * uPointFilterWidth * SQRT2;\n\n  // make rectangle out of the point\n  vOffset = impulse(1.0, aPointData) * pointRadius * vec2( 1, -1)\n          + impulse(2.0, aPointData) * pointRadius * vec2( 1,  1)\n          + impulse(3.0, aPointData) * pointRadius * vec2(-1,  1)\n          + impulse(4.0, aPointData) * pointRadius * vec2(-1, -1);\n\n  gl_Position.xy += (2.0 * gl_Position.w) * (vOffset / uViewport.zw);\n}\n"},64903:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nuniform vec4 uViewport;\nuniform float uChordalTolerance;\n\nattribute vec3 aVertexPosition;\nattribute vec3 aVertexNormal;\nattribute vec2 aTextureCoordinate;\nattribute vec4 aVertexColor;\nattribute vec4 aHighlightId;\n\nvarying highp vec3 vPosition;\nvarying highp float vProjectedError;\n\n{{{vertexUtilityFunctions}}}\n\nvoid main(void) {\n  vec4 position = uMVMatrix * vec4(aVertexPosition, 1.0);\n\n  vPosition = position.xyz;\n\n  gl_Position = uPMatrix * position;\n\n  #define OFFSET_DISTANCE 0.01\n  vec4 offsetPosition = uPMatrix * (position + vec4(OFFSET_DISTANCE, 0.0, 0.0, 0.0));\n\n  vec2 screenPosition = ndcToScreen(gl_Position / gl_Position.w, uViewport);\n  vec2 screenOffsetPosition = ndcToScreen(offsetPosition / offsetPosition.w, uViewport);\n\n  float projectedPixelsPerMeter = length(screenPosition - screenOffsetPosition) / OFFSET_DISTANCE;\n  vProjectedError = uChordalTolerance * projectedPixelsPerMeter;\n}\n"},85220:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\nuniform mediump vec4 uViewport;\n\nuniform mediump float uLineFilterWidth;\n\nuniform mediump float uDevicePixelRatio;\n\nattribute vec3 aVertexPosition;\nattribute vec3 aVertexNormal;\nattribute vec4 aVertexColor;\nattribute vec4 aEdgeData;  // XYZ = direction, abs(W)-1 = length, length(XYZ) = corner index, sign(W) = infinite if negative\nattribute float aPrimitiveSize; //line width\n\nvarying lowp vec4 vColor;\nvarying mediump float vLineWidth;\nvarying mediump float vDistance;  // signed distance from line center in pixels\nvarying mediump float vLength;  // edge length at this vertex in pixels\nvarying mediump float vSilhouetteTest; // the result of the silhouette test (0 if pass, -1 if fail)\nvarying highp vec3 vPosition;\n\n#ifdef OIT_SHADER\nuniform float uIsolateTranslucentAlpha;\n#endif\n\n{{{utilityFunctions}}}\n{{{vertexUtilityFunctions}}}\n\n//#define DEBUG_SILHOUETTES\n\nvoid decodeNormals(vec3 position, vec3 direction, vec3 encodedNormals, out vec3 normal1, out vec3 normal2) {\n  float xyLength = cos(encodedNormals[1]);\n  float x1 = cos(encodedNormals[0]) * xyLength;\n  float y1 = sin(encodedNormals[0]) * xyLength;\n  float z1 = sin(encodedNormals[1]);\n  normal1 = vec3(x1, y1, z1);\n  vec3 binormal = cross(direction, normal1);\n  normal2 = (cos(encodedNormals[2]) * normal1) + (sin(encodedNormals[2]) * binormal);\n}\n\nbool silhouetteTestOrthographic(mat4 pmvMatrix, vec3 normal1, vec3 normal2) {\n  // In orthographic, we just need to rotate the normals and check the z coordinate.\n  float p1z = (pmvMatrix * vec4(normal1, 0.0)).z;\n  float p2z = (pmvMatrix * vec4(normal2, 0.0)).z;\n\n  // If the normals have different signs, then one is pointed into the screen and one is pointed out, and hence\n  // this edge is a silhouette.\n  return p1z * p2z < 0.0;\n}\n\nbool silhouetteTestPerspective(mat4 pmvMatrix, vec3 position, vec3 direction, vec3 normal1, vec3 normal2) {\n  // In perspective things are more complicated. We need to create points that lie in the two normal planes,\n  // project these in-plane points along with the edge position and edge tangent point, then reconstruct\n  // a clip-space normal for each face and test the Z coordinates of those normals.\n  const float SMALL_STEP = 0.0001;\n  vec3 binormal1 = cross(direction, normal1);\n  vec3 binormal2 = cross(direction, normal2);\n\n  vec3 onEdge = position + direction*SMALL_STEP;\n  vec3 inPlane1 = position + binormal1*SMALL_STEP;\n  vec3 inPlane2 = position + binormal2*SMALL_STEP;\n  vec4 projectedPosition = pmvMatrix * vec4(position, 1.0);\n  vec4 projectedOnEdge = pmvMatrix * vec4(onEdge, 1.0);\n  vec4 projectedInPlane1 = pmvMatrix * vec4(inPlane1, 1.0);\n  vec4 projectedInPlane2 = pmvMatrix * vec4(inPlane2, 1.0);\n\n  vec3 clipPosition = projectedPosition.xyz / projectedPosition.w;\n  vec3 clipOnEdge = projectedOnEdge.xyz / projectedOnEdge.w;\n  vec3 clipInPlane1 = projectedInPlane1.xyz / projectedInPlane1.w;\n  vec3 clipInPlane2 = projectedInPlane2.xyz / projectedInPlane2.w;\n\n  vec3 clipTangent = clipOnEdge - clipPosition;\n  vec3 clipBinormal1 = clipInPlane1 - clipPosition;\n  vec3 clipBinormal2 = clipInPlane2 - clipPosition;\n\n  vec3 clipNormal1 = cross(clipBinormal1, clipTangent);\n  vec3 clipNormal2 = cross(clipBinormal2, clipTangent);\n\n  // If the normals have different signs, then one is pointed into the screen and one is pointed out, and hence\n  // this edge is a silhouette.\n  return clipNormal1.z * clipNormal2.z < 0.0;\n}\n\nvoid main(void) {\n    mat4 projectedModelViewMatrix = uPMatrix * uMVMatrix;\n    bool isOrthographic = (uPMatrix[3][3] > 0.0);\n\n    vec3 edgeDirection = normalize(aEdgeData.xyz);\n    float edgeLength = abs(aEdgeData.a) - 1.0;\n    vec3 normal1, normal2;\n    decodeNormals(aVertexPosition, edgeDirection, aVertexNormal, normal1, normal2);\n\n    vec4 cameraPosition = (uMVMatrix * vec4(aVertexPosition, 1.0));\n    gl_Position = uPMatrix * cameraPosition;\n\n    vPosition = cameraPosition.xyz;\n\n    bool isSilhouette = false;\n    if (isOrthographic) {\n      isSilhouette = silhouetteTestOrthographic(projectedModelViewMatrix, normal1, normal2);\n    } else {\n      isSilhouette = silhouetteTestPerspective(projectedModelViewMatrix, aVertexPosition, edgeDirection,\n                                               normal1, normal2);\n    }\n    vSilhouetteTest = 0.0;\n\n#ifdef DEBUG_SILHOUETTES\n    vColor = (isSilhouette) ? vec4(1.0, 0.0, 0.0, 1.0) : vec4(0.0, 0.0, 1.0, 0.5);\n#else\n    if (!isSilhouette) {\n      vSilhouetteTest = -1.0;\n      return;\n    }\n\n    vColor = aVertexColor;\n#ifdef OIT_SHADER\n    if (uOutsideIsolation) {\n      vColor.a = uIsolateTranslucentAlpha;\n    }\n#endif\n\n#endif\n\n    // Record the actual line width for use in the fragment shader.\n    vLineWidth = uDevicePixelRatio * aPrimitiveSize;\n\n    // widen the line to encompass enough fragments for edge filtering (even in the worst-case diagonal direction)\n    float lineWidth = vLineWidth + uLineFilterWidth * SQRT2;\n\n    // edge metadata\n    float cornerIndex = round(length(aEdgeData.xyz));\n    float normalDirectionFlag = -impulse(1.0, cornerIndex) - impulse(2.0, cornerIndex) + impulse(3.0, cornerIndex) + impulse(4.0, cornerIndex);\n    float tangentDirectionFlag = -impulse(1.0, cornerIndex) + impulse(2.0, cornerIndex) + impulse(3.0, cornerIndex) - impulse(4.0, cornerIndex);\n\n    // project the edge direction\n    vec4 projectedDirection = projectedModelViewMatrix * vec4(edgeDirection, 0.0);\n\n    // compute the signed distance of this vertex from the line center\n    vDistance = 0.5 * lineWidth * normalDirectionFlag;\n\n    // compute edge length at this vertex in pixels (used for stippling)\n    float worldToPixel = abs(uPMatrix[0][0] / gl_Position.w) * 0.5 * uViewport.z;\n    vLength = edgeLength * worldToPixel;  // disable line stipple for infinite lines\n\n    // compute tangent and normal offsets that will make the line quad\n    vec2 tangentOffset = vec2(0.0, 0.0);\n    vec2 screenNormal = vec2(0.0, 0.0);\n    if (isOrthographic) {\n      // orthographic projection is simpler\n\n      screenNormal = normalize(uViewport.wz * vec2(-projectedDirection.y, projectedDirection.x));\n    } else {\n      // perspective projection is trickier\n\n      float flip = sign(gl_Position.w + projectedDirection.w);\n      vec4 projectedEnd = gl_Position + flip * projectedDirection;\n      vec2 screenTangent = flip * normalize(uViewport.zw * (projectedEnd.xy / projectedEnd.w - gl_Position.xy / gl_Position.w));\n      screenNormal = vec2(-screenTangent.y, screenTangent.x);\n    }\n\n    // offset the projected vertex\n    vec2 normalOffset = (2.0 * vDistance * gl_Position.w) * (screenNormal / uViewport.zw);\n    gl_Position.xy += tangentOffset + normalOffset;\n}\n"},47989:function(e,t){"use strict";t.Z="{{{vs-draw-faces}}}\n"},97361:function(e,t){"use strict";t.Z="attribute vec3 aVertexPosition;\n\nvarying vec2 vTextureCoordinate;\n\n{{{blitFunctions}}}\n\nvoid main(void) {\n    vTextureCoordinate = blitVertexTextureCoordinate(aVertexPosition);\n    gl_Position = vec4(aVertexPosition, 1.0);\n}\n"},49280:function(e,t){"use strict";t.Z="{{{vs-drawTexture}}}\n"},55167:function(e,t){"use strict";t.Z="uniform float uOffsetFactor;\nuniform float uScalarInputMax;\nuniform float uScalarInputMagnitudeInverse;\nuniform float uScalarOutputMax;\nuniform float uScalarOutputMagnitudeInverse;\n\nattribute vec3 aOffsetVector;\n\n// Here we offset the simulation vertex by its offset direction, the current offset factor.\n#define POSITION_SETTING_ROUTINE vec3 offsetPosition = aVertexPosition + aOffsetVector * uOffsetFactor; vPosition = vec3(uMVMatrix * vec4(offsetPosition, 1.0));\n\n{{{vs-endcapMask-faces}}}\n"},7591:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\n// This can be set to zero to make the hatch direction independent of the occurrence id.  We use the occurrence id to\n// increase variability in similarly-colored parts in the scene.  However, these ids are sensitive to changes, and hence\n// can be non-deterministic, and problematic used for testing.  Hence we have a mechanism to disable their use for\n// this situation.\nuniform float uUseOccurrenceIdForHatchOffset;\n\nuniform float uAddsToSectionMask;\nuniform float uMeshGroupIdHash;\n\nattribute vec3 aVertexPosition;\nattribute vec4 aVertexColor;\n\nvarying vec3 vPosition;\nvarying mediump vec4 vVertexColor;\n\n{{{sectionPlaneConstants}}}\n{{{utilityFunctions}}}\n{{{vertexUtilityFunctions}}}\n\n// This will set the view-space position of the vertex.  This can be overridden to animate the vertex in some fashion\n#ifndef POSITION_SETTING_ROUTINE\n#define POSITION_SETTING_ROUTINE vPosition = vec3(uMVMatrix * vec4(aVertexPosition, 1.0));\n#endif\n\nvoid main(void) {\n  // Offset the color slightly by the occurrence id and mesh ranges groupId to distinguish parts with the same color.\n  float offset = (uMeshGroupIdHash + uOccurrenceId) * uUseOccurrenceIdForHatchOffset;\n  float redOffset = mod(offset, 31.0) * 0.001;\n  float greenOffset = mod(offset, 71.0) * 0.001;\n  float blueOffset = mod(offset, 97.0) * 0.001;\n  vVertexColor = aVertexColor + vec4(redOffset, greenOffset, blueOffset, 0.0);\n\n  vVertexColor.a += partCountOrder; // Always add a constant amount to indicate a part has intersected a fragment\n  if (uOutsideIsolation)\n  {\n    vVertexColor.a += outsideIsolationOrder; // If part is not isolated, then indicate that with more higher order bits\n  }\n\n  // If uAddsToSectionMask is off, nullify its contribution to the mask.\n  vVertexColor *= uAddsToSectionMask;\n\n  POSITION_SETTING_ROUTINE\n  gl_Position = uPMatrix * vec4(vPosition, 1.0);\n}\n"},82302:function(e,t){"use strict";t.Z="{{{vs-drawTexture}}}\n"},13130:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nuniform int uUseHighlightUniform;\nuniform vec3 uHighlightIndexInstanceId;\nuniform float uHighlightCount;\n\nattribute vec3 aVertexPosition;\nattribute vec4 aHighlightId;  // R = highlight index, GB = highlight instance id, A = OR of 0(normal), 1(highlighted)\n\nvarying lowp vec3 vHighlightIndexInstanceId;\n\n{{{utilityFunctions}}}\n{{{highlightFunctions}}}\n{{{vertexUtilityFunctions}}}\n\nvoid main(void) {\n    if (isHighlightTypeActive(aHighlightId.r)) {\n      vHighlightIndexInstanceId = aHighlightId.rgb;\n\n      vec3 position = vec3(uMVMatrix * vec4(aVertexPosition, 1.0));\n      gl_Position = uPMatrix * vec4(position, 1.0);\n    } else {\n      gl_Position = vec4(5.0, 5.0, 5.0, 1.0);  //Put the vertex comfortably outside clip space\n    }\n}\n"},55299:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\nuniform vec4 uViewport;\n\nuniform float uHighlightOpacity;\nuniform vec4 uHighlightLineStipple;\nuniform float uUseHighlightLineStipple;\nuniform float uHighlightLineWidthMin;\nuniform float uHighlightLineWidthScale;\nuniform vec4 uHighlightColor;\nuniform mediump float uDevicePixelRatio;\n\nattribute vec3 aVertexPosition;\nattribute vec4 aVertexColor;\nattribute float aPrimitiveSize;  // line width\nattribute vec4 aHighlightId;  // R = highlight index, GB = highlight instance id, A = an OR of 0(normal), 1(highlighted)\nattribute vec4 aPrimitiveStyle;\n\nvarying lowp vec4 vColor;\nvarying mediump float vOffset;  // offset from line center to line edge in multiples of line radius\nvarying mediump vec4 vLineStipple;\nvarying mediump float vLength;  // edge length at this vertex in pixels\n\n#ifndef SKIP_SECTION_PLANES\nvarying vec3 vPositionForSection;\n#endif\n\n{{{utilityFunctions}}}\n{{{highlightFunctions}}}\n{{{vertexUtilityFunctions}}}\n{{{edgeUtilityFunctions}}}\n\nvoid main(void) {\n  // Only draw highlighted geometry\n  if (!isHighlightedForIndex(aHighlightId.a, aHighlightId.r, -1.0)) {\n    gl_Position = vec4(5.0, 5.0, 5.0, 1.0);  //Put the vertex comfortably outside clip space\n  }\n  else {\n    vLineStipple = mix(aPrimitiveStyle, uHighlightLineStipple, uUseHighlightLineStipple);\n\n    vColor = vec4(uHighlightColor.rgb, uHighlightOpacity);\n\n    // figure out line width, taking in account highlight scale and minimum\n    float lineWidth = max(uDevicePixelRatio * aPrimitiveSize * uHighlightLineWidthScale, uHighlightLineWidthMin);\n\n    vec4 cameraSpacePosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n\n#ifndef SKIP_SECTION_PLANES\n    vPositionForSection = cameraSpacePosition.xyz;\n#endif\n\n    // project the vertex position and edge direction\n    gl_Position = uPMatrix * cameraSpacePosition;\n\n    // compute the signed offset of this vertex from the line center\n    vOffset = edgeNormalDirectionFlag(edgeCornerIndex());\n\n    // compute edge length at this vertex in pixels (used for stippling)\n    float worldToPixel = abs(uPMatrix[0][0] / gl_Position.w) * 0.5 * uViewport.z;\n    vLength = mix(edgeLength() * worldToPixel, 0.0, float(edgeIsInfinite()));  // disable line stipple for infinite lines\n\n    vec2 tangentOffset, normalOffset;\n    computeTangentAndNormalOffsets(uMVMatrix, gl_Position, lineWidth, tangentOffset, normalOffset);\n    gl_Position.xy += tangentOffset + normalOffset;\n  }\n}\n"},59825:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\nuniform vec4 uViewport;\n\nuniform float uHighlightOpacity;\nuniform vec2 uHighlightPointFont;\nuniform float uHighlightPointSizeMin;\nuniform float uHighlightPointSizeScale;\nuniform vec4 uHighlightColor;\n\nuniform mediump float uDevicePixelRatio;\n\nattribute vec3 aVertexPosition;\nattribute float aPointData;  // corner index: 1=bottom-right, 2=top-right, 3=top-left, 4=bottom-left\nattribute float aPrimitiveSize;\nattribute vec4 aHighlightId;  // R = highlight index, GB = highlight instance id, A = an OR of 0(normal), 1(highlighted)\n\nvarying lowp vec4 vColor;\nvarying mediump vec2 vOffset;  // screen offset from the point center in multiples of radius\n#ifndef SKIP_SECTION_PLANES\nvarying vec3 vPositionForSection;\n#endif\n\n{{{utilityFunctions}}}\n{{{highlightFunctions}}}\n{{{vertexUtilityFunctions}}}\n\nvoid main(void) {\n  // Only draw highlighted geometry\n  if (isHighlightedForIndex(aHighlightId.a, aHighlightId.r, -1.0)) {\n    vColor = vec4(uHighlightColor.rgb, uHighlightOpacity);\n    float pointSize = max(uDevicePixelRatio * aPrimitiveSize * uHighlightPointSizeScale, uHighlightPointSizeMin);\n\n    vec4 cameraSpacePosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n\n#ifndef SKIP_SECTION_PLANES\n    vPositionForSection = cameraSpacePosition.xyz;\n#endif\n\n    gl_Position = uPMatrix * cameraSpacePosition;\n\n    // make rectangle out of the point\n    vOffset = impulse(1.0, aPointData) * vec2( 1, -1)\n            + impulse(2.0, aPointData) * vec2( 1,  1)\n            + impulse(3.0, aPointData) * vec2(-1,  1)\n            + impulse(4.0, aPointData) * vec2(-1, -1);\n\n    gl_Position.xy += (gl_Position.w * pointSize) * (vOffset / uViewport.zw);\n  } else {\n    gl_Position = vec4(5.0, 5.0, 5.0, 1.0);  //Put the vertex comfortably outside clip space\n  }\n}\n"},83952:function(e,t){"use strict";t.Z="{{{vs-drawTexture}}}\n"},24434:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nuniform int uUseHighlightColor;\n\nattribute vec3 aVertexPosition;\n\n /*\n    R = highlight index,\n    GB = highlight instance id\n    A = highlight flags created on the client. If the first bit is set, the geometry is highlighted. If the second bit\n        is set, interior highlighting should be visually suppressed. A value of 0 indicates there is no highlighting.\n */\nattribute vec4 aHighlightId;\n\nvarying lowp float vHighlighted;\nvarying highp vec3 vPosition;\n\n{{{utilityFunctions}}}\n{{{highlightFunctions}}}\n{{{vertexUtilityFunctions}}}\n\nvoid main(void) {\n  vPosition = vec3(uMVMatrix * vec4(aVertexPosition, 1.0));\n\n  vHighlighted = interiorHighlightIsSuppressed(aHighlightId.a) ? 0. : float(IS_BIT_1_SET(aHighlightId.a));\n  gl_Position = uPMatrix * vec4(vPosition, 1.0);\n}\n"},75801:function(e,t){"use strict";t.Z="#ifdef GL_FRAGMENT_PRECISION_HIGH\nprecision highp float;\n#else\nprecision mediump float;\n#endif\n\nuniform mat4 uMVMatrix;\n#ifdef GL_FRAGMENT_PRECISION_HIGH\nuniform highp mat4 uPMatrix;\n#else\nuniform mat4 uPMatrix;\n#endif\n\nattribute vec3 aVertexPosition;\nattribute vec3 aVertexNormal;\n\nvarying vec3 vPosition;\nvarying vec3 vNormal;\n#ifdef GL_FRAGMENT_PRECISION_HIGH\nvarying highp float vDepth;\n#else\nvarying float vDepth;\n#endif\n\n{{{utilityFunctions}}}\n{{{vertexUtilityFunctions}}}\n{{{sectionPlaneClippingFunctions}}}\n\nvoid main(void) {\n  vNormal = mat3(uMVMatrix) * aVertexNormal;\n\n  vec2 nearFar = getNearFar(uPMatrix);\n  vec4 position = uMVMatrix * vec4(aVertexPosition, 1.0);\n  vPosition = vec3(position);\n  vDepth = (-position.z - nearFar.x) / (nearFar.y - nearFar.x);\n\n  gl_Position = uPMatrix * position;\n}\n"},58367:function(e,t){"use strict";t.Z="#ifdef GL_ES\n#ifdef GL_FRAGMENT_PRECISION_HIGH\nprecision highp float;\n#else\nprecision mediump float;\n#endif\n#endif\n\nattribute vec3 aVertexPosition;\n\nvoid main(void) {\n    gl_Position = vec4(aVertexPosition, 1.0);\n}\n"},48594:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\nuniform mediump vec4 uViewport;\n\nuniform mediump float uLineFilterWidth;\n\nuniform mediump float uDevicePixelRatio;\n\nattribute vec3 aVertexPosition;\nattribute float aPrimitiveSize;\n\nvarying vec3 vPosition;\n\n#ifdef GL_FRAGMENT_PRECISION_HIGH\n//We want to take advantage of high precision, when available, to avoid losing fidelity in depth;\nvarying highp float vDepth;\n#else\nvarying float vDepth;\n#endif\n\n{{{utilityFunctions}}}\n{{{vertexUtilityFunctions}}}\n{{{edgeUtilityFunctions}}}\n\nvoid main(void) {\n  vec4 cameraSpacePosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n  vPosition = vec3(cameraSpacePosition);\n\n  // project the vertex position and edge direction\n  gl_Position = uPMatrix * (cameraSpacePosition);\n\n  vec2 nearFar = getNearFar(uPMatrix);\n  vDepth = (-cameraSpacePosition.z - nearFar.x) / (nearFar.y - nearFar.x);\n\n  float lineWidth = uDevicePixelRatio * aPrimitiveSize + uLineFilterWidth * SQRT2;\n\n  vec2 tangentOffset, normalOffset;\n  computeTangentAndNormalOffsets(uMVMatrix, gl_Position, lineWidth, tangentOffset, normalOffset);\n  gl_Position.xy += tangentOffset + normalOffset;\n}\n"},24798:function(e,t){"use strict";t.Z="{{{vs-normalDepth-faces}}}\n"},32829:function(e,t){"use strict";t.Z="{{{vs-draw-points}}}\n"},27039:function(e,t){"use strict";t.Z="uniform mat4 uPMatrix;\n\nattribute vec3 aVertexPosition;\n\nvarying vec2 vTextureCoordinate;\nvarying vec2 vExtent;  // near distance and depth extent of the object\n\n{{{blitFunctions}}}\n\nvec2 getExtent() {\n  vec2 extent;\n  float a = uPMatrix[2][2];\n  float b = uPMatrix[3][2];\n  float nearOrthographic = (b + 1.0) / a;\n  float farOrthographic = (b - 1.0) / a;\n  float nearPerspective = b / (a - 1.0);\n  float farPerspective = b / (a + 1.0);\n  extent[0] = uPMatrix[3][3] * nearOrthographic - uPMatrix[2][3] * nearPerspective;\n  extent[1] = uPMatrix[3][3] * farOrthographic - uPMatrix[2][3] * farPerspective;\n  extent[1] -= extent[0];\n  return extent;\n}\n\nvoid main(void) {\n    vExtent = getExtent();\n    vTextureCoordinate = blitVertexTextureCoordinate(aVertexPosition);\n\n    gl_Position = vec4(aVertexPosition, 1.0);\n}\n"},40989:function(e,t){"use strict";t.Z="attribute vec3 aVertexPosition;\n\nvoid main(void) {\n    gl_Position = vec4(aVertexPosition, 1.0);\n}\n"},12187:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\nuniform vec4 uViewport;\n\nattribute vec3 aVertexPosition;\n\n{{{vertexUtilityFunctions}}}\n{{{vertexPicking}}}\n\nvarying lowp vec4 vPickingIndex;\nvarying highp vec3 vPosition;\n\nvoid main(void) {\n    vPickingIndex = getPickingId();\n\n    vec4 cameraPosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n    vPosition = cameraPosition.xyz;\n\n    gl_PointSize = 1.0;\n    gl_Position = uPMatrix * cameraPosition;\n}\n"},22479:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nattribute vec3 aVertexPosition;\nattribute float aPrimitiveRestart;\n\n{{{vertexUtilityFunctions}}}\n{{{vertexPicking}}}\n\nvarying lowp vec4 vPickingIndex;\nvarying mediump float vPrimitiveRestart;\nvarying highp vec3 vPosition;\n\nvoid main(void) {\n  vPrimitiveRestart = aPrimitiveRestart;\n\n  vPickingIndex = getPickingId();\n\n  vec4 cameraPosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n  vPosition = cameraPosition.xyz;\n\n  gl_PointSize = 1.0;  // We set the point size for faces because we also draw points as alternate geometry\n  gl_Position = uPMatrix * cameraPosition;\n}\n"},69671:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\nuniform vec4 uViewport;\n\nattribute vec3 aVertexPosition;\nattribute float aPrimitiveSize;\n\n{{{vertexUtilityFunctions}}}\n{{{vertexPicking}}}\n{{{edgeUtilityFunctions}}}\n\nvarying lowp vec4 vPickingIndex;\nvarying highp vec3 vPosition;\n\nvoid main(void) {\n  vPickingIndex = getPickingId();\n\n  // project the vertex position and edge direction\n  vec4 cameraPosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n  vPosition = cameraPosition.xyz;\n  gl_Position = uPMatrix * cameraPosition;\n\n  vec2 tangentOffset, normalOffset;\n  computeTangentAndNormalOffsets(uMVMatrix, gl_Position, aPrimitiveSize, tangentOffset, normalOffset);\n  gl_Position.xy += tangentOffset + normalOffset;\n}\n"},35873:function(e,t){"use strict";t.Z="#ifdef GL_ES\nprecision mediump float;\n#endif\n\nuniform mat4 uPMatrix;\nuniform float uSceneDiameter;\nuniform lowp vec4 uSectionPlaneIsHiddenFromPick;\nuniform vec4 uPlaneSelector;\n\nattribute vec3 aVertexPosition;\n\nvarying vec3 vPosition;\n\n{{{sectionPlaneEndcapFunctions}}}\n\nfloat getSectionPlaneIsHiddenFromPick(vec4 selector) {\n  return dot(selector, uSectionPlaneIsHiddenFromPick);\n}\n\nvoid main(void) {\n    vec3 point, uAxis, vAxis;\n    float isHidden = getSectionPlaneIsHiddenFromPick(uPlaneSelector);\n    if (isHidden > 0.0) {\n        // Throw the vertex outside of clip space.\n        gl_Position = vec4(5.0, 5.0, 5.0, 1.0);\n        return;\n    }\n\n    getSectionPlaneFrame(uPlaneSelector, point, uAxis, vAxis);\n\n    // Scale the points to make sure they are outside the scene bounding box by a comfortable margin\n    uAxis *= uSceneDiameter * 10.0;\n    vAxis *= uSceneDiameter * 10.0;\n\n    vPosition = point + uAxis * aVertexPosition.x + vAxis * aVertexPosition.y;\n\n    gl_Position = uPMatrix * vec4(vPosition, 1.0);\n}\n"},58264:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nattribute vec3 aVertexPosition;\n\n{{{vertexUtilityFunctions}}}\n{{{vertexPicking}}}\n\nvarying lowp vec4 vPickingIndex;\nvarying highp vec3 vPosition;\n\nvoid main(void) {\n  vPickingIndex = getPickingId();\n  vec4 cameraPosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n  vPosition = cameraPosition.xyz;\n  gl_Position = uPMatrix * cameraPosition;\n}\n"},84294:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\nuniform vec4 uViewport;\n\nattribute vec3 aVertexPosition;\nattribute float aPointData;  // corner index: 1=bottom-right, 2=top-right, 3=top-left, 4=bottom-left\nattribute float aPrimitiveSize;\n\n{{{vertexUtilityFunctions}}}\n{{{vertexPicking}}}\n{{{sectionPlaneClippingFunctions}}}\n\nvarying lowp vec4 vPickingIndex;\n\nvoid main(void) {\n  vec4 cameraPosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n  if (!passesSectionPlaneClippingTest(cameraPosition.xyz)) {\n    gl_Position = vec4(5.0, 5.0, 5.0, 1.0);  //Put the vertex comfortably outside clip space\n    return;\n  }\n\n  gl_Position = uPMatrix * cameraPosition;\n\n  vPickingIndex = getPickingId();\n\n  // make rectangle out of the point\n  vec2 offset = impulse(1.0, aPointData) * vec2( 1, -1)\n              + impulse(2.0, aPointData) * vec2( 1,  1)\n              + impulse(3.0, aPointData) * vec2(-1,  1)\n              + impulse(4.0, aPointData) * vec2(-1, -1);\n  gl_Position.xy += (aPrimitiveSize * gl_Position.w) * (offset / uViewport.zw);\n}\n"},51175:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nattribute vec3 aVertexPosition;\nattribute vec4 aVertexColor;\n\nvarying vec3 vPositionForSection;\nvarying vec4 vVertexColor;\n\n{{{utilityFunctions}}}\n{{{vertexUtilityFunctions}}}\n\nvoid main(void) {\n    vec4 cameraSpacePosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n    vPositionForSection = vec3(cameraSpacePosition);\n    vVertexColor = aVertexColor;\n\n    gl_Position = uPMatrix * cameraSpacePosition;\n}\n"},96438:function(e,t){"use strict";t.Z="{{{vs-drawTexture}}}\n"},82200:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nuniform float uScalarInputMax;\nuniform float uScalarInputMagnitudeInverse;\n\nattribute vec3 aVertexPosition;\nattribute vec2 aTextureCoordinate;\n\nvarying vec3 vCameraPosition;\nvarying float vToBeVisualized;\nvarying float vScalarValue;\n\nvoid main(void) {\n    vec4 cameraPosition = uMVMatrix * vec4(aVertexPosition, 1.0);\n    vCameraPosition = cameraPosition.xyz;\n    vToBeVisualized = aTextureCoordinate[0];\n    vScalarValue = aTextureCoordinate[1];\n    gl_Position = uPMatrix * cameraPosition;\n}\n"},62422:function(e,t){"use strict";t.Z="{{{vs-draw-edges}}}\n"},69397:function(e,t){"use strict";t.Z="{{{vs-draw-points}}}\n"},51877:function(e,t){"use strict";t.Z="{{{vs-tintByNormalDepth-faces}}}"},41586:function(e,t){"use strict";t.Z="{{{vs-draw-faces-decals}}}"},38334:function(e,t){"use strict";t.Z="uniform mat4 uMVMatrix;\nuniform mat4 uPMatrix;\n\nuniform bool uApplyTranslucentAlphaToAll;\nuniform float uTranslucentPassAlpha;\n\nattribute vec3 aVertexPosition;\nattribute vec3 aVertexNormal;\nattribute vec2 aTextureCoordinate;\nattribute vec4 aVertexColor;\n\nvarying vec3 vPosition;\nvarying lowp vec3 vNormal;\nvarying mediump vec2 vTextureCoordinate;\nvarying mediump float vOpacity;\n#ifdef GL_FRAGMENT_PRECISION_HIGH\nvarying highp float vDepth;\n#else\nvarying float vDepth;\n#endif\n\n{{{utilityFunctions}}}\n{{{depthNormalFunctions}}}\n{{{vertexUtilityFunctions}}}\n\n\nvoid main(void) {\n  vec4 position = uMVMatrix * vec4(aVertexPosition, 1.0);\n  vPosition = position.xyz;\n  vNormal = flipNormalTowardViewer(mat3(uMVMatrix) * aVertexNormal, vPosition, uPMatrix);\n  vTextur