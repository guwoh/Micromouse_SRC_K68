in-right"\n              ng-disabled="!$ctrl.canEnableRevertUnchangedRevisionsBtn()"\n              ng-click="$ctrl.revertUnchanged()"\n              data-bs-original-title="{{\'Revert unchanged items to last revision\' | i18next}}"\n            ><os-svg icon="update-now"></os-svg></button>\n          </div>\n        </th>\n        <th class="col column-2">\n          <div class="cell-with-button">\n            <div ng-bind="$ctrl.columnNames.partnumber"></div>\n            <button\n              ng-if="$ctrl.activeWorkflow.checkPartNumberGenerationCurrentlyEnabled()"\n              class="btn btn-sm btn-secondary os-pin-right"\n              ng-disabled="!$ctrl.canEnableGeneratePartNumberBtn()"\n              ng-click="$ctrl.genPartNumbers()"\n              data-bs-original-title="{{\'Generate missing part numbers\' | i18next}}"\n            ><os-svg icon="partnumber"></os-svg></button>\n          </div>\n        </th>\n        <th ng-if="$ctrl.usesExternalPlm" class="col column-3">&nbsp;</th>\n        <th ng-if="!$ctrl.hideMetadataToggle" class="col column-4">&nbsp;</th>\n      </tr>\n    </thead>\n  </table>\n</div>\n<div tabindex="0" class="table-body-wrap" scroll-sync="{targetId: $ctrl.scrollId, syncX: true, twoWay: true}">\n  <table class="releasable-properties-table">\n    <tbody>\n      <tr class="item-row" data-row-id="row-{{item.id}}" ng-repeat="item in $ctrl.items"\n          ng-class="{\'disabled\': !item.getPropertyValueById($ctrl.properties.isinpackage)}">\n        <td colspan="4" ng-show="$ctrl.isVisible({item: item})">\n          <table>\n            <tr class="item-properties" ng-class="{\'has-error-row\': $ctrl.itemHasErrors(item)}">\n              <td class="col column-0" ng-if="::($ctrl.showTransitionArrow)">\n                <div class="os-row" ng-if="!item.readOnly">\n                  <div class="current">\n                    <span\n                      ng-if="::item.getPropertyById($ctrl.properties.previousrevision)"\n                      data-bs-original-title="{{::item.getPropertyValueById($ctrl.properties.previousrevision)}}"\n                      overflow-tooltip="flex">{{::item.getPropertyValueById($ctrl.properties.previousrevision) || \'&nbsp;&nbsp;\'}}</span>\n                    <span ng-if="::!(item.getPropertyById($ctrl.properties.previousrevision))"\n                      data-bs-original-title="{{::(item.getPropertyById($ctrl.properties.revision).initialValue)}}"\n                      overflow-tooltip="flex">{{::(item.getPropertyById($ctrl.properties.revision).initialValue || \'&nbsp;&nbsp;\')}}</span>\n                  </div>\n                  <div class="transition-arrow" ng-if="$ctrl.showTransitionArrowSection(item)">\n                    <span ng-class="{\'invisible\': !$ctrl.showTransitionArrowForItem(item)}">⟶</span>\n                  </div>\n                  <metadata-property\n                    prop="item.getPropertyById($ctrl.properties.revision)"\n                    ctrl="$ctrl"\n                    item="item"\n                    placeholders="$ctrl.placeholders"\n                    metadata-form="$ctrl.formCtrl"\n                    show-label="false"\n                  ></metadata-property>\n                </div>\n                <div class="os-row" ng-if="item.readOnly">\n                  <div>{{::(item.getPropertyValueById($ctrl.properties.revision) || \'&nbsp;&nbsp;\')}}</div>\n                </div>\n              </td>\n              <td class="col column-0" ng-if="::(!$ctrl.showTransitionArrow)">\n                <metadata-property\n                  prop="item.getPropertyById($ctrl.properties.revision)"\n                  ng-if="!item.readOnly"\n                  ctrl="$ctrl"\n                  item="item"\n                  placeholders="$ctrl.placeholders"\n                  metadata-form="$ctrl.formCtrl"\n                  show-label="false"\n                ></metadata-property>\n                <div class="os-row" ng-if="item.readOnly">\n                  <div>{{::(item.getPropertyValueById($ctrl.properties.revision))}}</div>\n                </div>\n              </td>\n              <td class="col column-1">\n                <div class="cell-with-button">\n                  <span class="ellipseOverflowText">{{::(item.getPropertyDisplayValueById($ctrl.properties.state))}}</span>\n                  <div class="unchanged-container os-pin-right" ng-if="$ctrl.changeDetectionEnabled">\n                    <div ng-show="$ctrl.changeDetectionInProgress" class="os-spinner-small os-spinner-spinning unchanged-spinner"></div>\n                    <button\n                      ng-if="$ctrl.shouldShowRevertButtonOnItem(item)"\n                      class="btn btn-sm btn-secondary"\n                      ng-click="$ctrl.revertUnchanged({items: [item]})"\n                      data-bs-original-title="{{\'Revert item to last revision\' | i18next}}"\n                    ><os-svg icon="update-now"></os-svg></button>\n                  </div>\n                </div>\n              </td>\n              <td class="col column-2" ng-if="!item.readOnly">\n                <metadata-property\n                  prop="item.getPropertyById($ctrl.properties.partnumber)"\n                  ctrl="$ctrl"\n                  item="item"\n                  placeholders="$ctrl.placeholders"\n                  metadata-form="$ctrl.formCtrl"\n                  on-change="$ctrl.validate(prop, item)"\n                  is-value-unique="ctrl.isPartNumberUnique(value, scope, prop)"\n                  show-label="false"\n                  val-gen="$ctrl.partNumberValGenConfig"\n                ></metadata-property>\n              </td>\n              <td class="col column-2" ng-if="item.readOnly">\n                 {{::(item.getPropertyValueById($ctrl.properties.partnumber))}}\n              </td>\n              <td class="col column-3" ng-if="$ctrl.usesExternalPlm">\n                <button class="os-button plm-open-item-button" ng-if="item.syncedWithPLM" ng-click="$ctrl.onSyncedItemLinkBtnClick(item)"\n                  ng-disabled="$ctrl.isGetPLMUrlsInProgress" data-bs-original-title="{{ \'tooltips:::Open in __pLMName__\' | i18next:{ pLMName: $ctrl.activeWorkflow.pLMName } }}">\n                  <os-svg icon="arena-open-item-button"></os-svg>\n                </button>\n              </td>\n              <td class="col column-4" ng-if="!$ctrl.hideMetadataToggle">\n                  <button class="os-button" type="button" ng-if="!item.readOnly" data-bs-original-title="{{\'Edit properties\' | i18next}}"\n                    data-bs-placement="top" ng-class="{\'has-required-hidden-props\': item.editableRequiredPropertyError}"\n                    ng-click="$ctrl.loadPropertySheet(item)">\n                    <div class="button-content">\n                      <os-svg icon="properties-builtin" class="button-icon"></os-svg>\n                    </div>\n                  </button>\n\n                  <button ng-if="$ctrl.canShowDiffFor(item)" class="os-button" type="button"\n                    data-bs-original-title="{{::\'Compare revisions\' | i18next}}" data-bs-placement="top"\n                    ng-class="{\'os-active\': $ctrl.isComparing(item)}" ng-click="$ctrl.toggleComparision(item)">\n                    <div class="button-content">\n                      <os-svg icon="compare-versions-button" class="button-icon"></os-svg>\n                    </div>\n                  </button>\n\n                  <button class="os-button" type="button" ng-if="$ctrl.canExportItem(item)"\n                    data-bs-original-title="{{$ctrl.exportOrDownloadText(item)}}" data-bs-placement="top"\n                    ng-click="$ctrl.exportOrDownload(item)">\n                    <div class="button-content">\n                      <os-svg icon="export-button" class="button-icon"></os-svg>\n                    </div>\n                  </button>\n              </td>\n            </tr>\n            <tr class="errors ng-hide" ng-show="$ctrl.itemHasErrors(item)">\n              <td colspan="4">\n                <div class="os-row">\n                  <release-item-errors\n                    item="::item"\n                    form-ctrl="::$ctrl.formCtrl"\n                    error-names="::$ctrl.errorMessages"\n                    has-editable-required-metadata-props="::item.editableRequiredPropertyError"\n                    view-metadata-props="::$ctrl.loadPropertySheet(item)"\n                  ></release-item-errors>\n                </div>\n              </td>\n            </tr>\n            <tr class="image-diff" ng-if="$ctrl.isComparing(item)">\n              <td colspan="4">\n                <label class="diff-header show-2d-compare">\n                  <input type="checkbox" ng-model="$ctrl.diffDetails[item.id].show2d"> {{::\'Only show differences\' | i18next}}\n                </label>\n                <div class="image-diff-wrapper">\n                  <release-diff\n                    visual-diff-source="$ctrl.diffDetails[item.id].source"\n                    from-version="{{$ctrl.diffDetails[item.id].fromVersion}}"\n                    to-version="{{$ctrl.diffDetails[item.id].toVersion}}"\n                    show-hlr-compare="$ctrl.diffDetails[item.id].show2d"></release-diff>\n                  </div>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </tbody>\n  </table>\n</div>\n')}]),e.exports=n},73868:function(e,t,i){var n="/project/web/ts/release-management/release-dialog.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="modal-header" data-id="{{ctrl.candidate.id}}" resizable-modal="{{modalSizeConfig}}">\n  <div class="release-title os-row ellipseOverflowText">\n    <h3 class="modal-title ellipseOverflowText" data-bs-original-title="{{ctrl.getReleaseName()}}" overflow-tooltip="true">{{ctrl.getTitle()}}</h3>\n    <button class="btn btn-sm btn-secondary refresh-button" type="button"\n            ng-if="ctrl.shouldShowRefreshButton()"\n            data-bs-original-title="{{\'Refresh\' | i18next}}" data-bs-placement="left"\n            ng-click="ctrl.refreshRelease(false)"\n    >\n      <div class="button-content">\n        <os-svg icon="refresh-release-button" class="button-icon"></os-svg>\n      </div>\n    </button>\n    <button class="btn btn-sm btn-secondary copy-release-button overflow" type="button"\n            ng-if="ctrl.shouldShowCopyReleaseLinkButton()"\n            data-bs-original-title="{{ctrl.getCopyLinkButtonTooltip()}}"\n            data-bs-placement="bottom"\n            ng-click="ctrl.handleCopyReleaseLink()"\n    >\n      <div class="button-content">\n        <os-svg icon="document-links" class="button-icon"></os-svg>\n      </div>\n    </button>\n  </div>\n  <div class="plm-change-container os-row" ng-if="ctrl.canShowPLMChangeSearch()">\n    <span data-bs-original-title="{{ctrl.plmSearchBtnTooltip}}" data-bs-placement="left">\n      <button class="btn btn-sm btn-secondary plm-search-button" type="button"\n        ng-class="{\'change-required\': ctrl.candidate && !ctrl.candidate.selectedPLMChange && !ctrl.isLoadingPLMChangeInfo}"\n        ng-disabled="!ctrl.candidate.workflow.isSetup || ctrl.isSpinnerRunning() || !ctrl.plmReleasePackageSyncConfig.syncEnabled"\n        ng-click="ctrl.togglePLMSearch()">\n        <div class="button-content">\n          <os-svg icon="arena-square-full-color" class="button-icon"></os-svg>\n        </div>\n      </button>\n    </span>\n    <div class="os-spinner-small os-spinner-spinning plm-loading-spinner" ng-if="ctrl.isLoadingPLMChangeInfo"></div>\n    <a ng-click="ctrl.goToPLMChange()" class="plm-change-selected ellipseOverflowText" ng-if="ctrl.candidate.selectedPLMChange && !ctrl.showPLMChangeSearchBox">\n      <span>{{ ctrl.candidate.selectedPLMChange.name }}</span>\n    </a>\n    <plm-change-order-search\n      ng-if="ctrl.showPLMChangeSearchBox"\n      company-id="ctrl.companyId"\n      on-select-change-order="ctrl.onSelectPLMChangeOrder(plmChangeOrder)"\n      selected-change-order="ctrl.candidate.selectedPLMChange">\n    </plm-change-order-search>\n  </div>\n  <div class="link-container os-pin-right">\n    <span ng-hide="ctrl.isAddingItems" ng-if="ctrl.errorFilterManager.hasErrors">{{ctrl.getErrorFilterLabel()}}</span>\n    <button\n      type="button"\n      class="btn btn-small btn-secondary error-filter"\n      ng-class="{ \'os-active\': ctrl.errorFilterManager.active }"\n      ng-if="ctrl.errorFilterManager.hasErrors || ctrl.errorFilterManager.active"\n      ng-hide="ctrl.isAddingItems"\n      ng-click="ctrl.toggleErrorFilter()"\n      data-bs-original-title="{{\'Show only items that need attention\' | i18next}}"\n    ><os-svg icon="list-error-inside"></os-svg></button>\x3c!-- prevent whitespace\n    --\x3e<button type="button" class="btn btn-sm btn-secondary overflow" data-bs-toggle="dropdown">\n      <os-svg icon="overflow"></os-svg>\n    </button>\n    <ul class="dropdown-menu dropdown-menu-end" menu-width="none">\n      <li><button class="btn dropdown-item" type="button" ng-click="ctrl.openAuditLogInNewTab()">{{\'View audit log\' |\n          i18next}}</button></li>\n      <li><button class="btn dropdown-item" type="button" ng-click="toggleWorkflowDiagram($event)"\n          ng-if="!ctrl.candidate.workflow.isDiscarded && workflowDefinition">{{\'View workflow\' | i18next}}</button></li>\n    </ul>\n  </div>\n  <span class="is-discarded badge badge-secondary rounded-pill" ng-if="ctrl.candidate.workflow.isDiscarded">{{\'Discarded\' | i18next}}</span>\n</div>\n<form name="releaseForm" class="release-form" autocomplete="off" novalidate="novalidate" ng-model-options="{updateOn: \'default blur\', debounce: {\'default\': 300, \'blur\': 0} }" ng-class="{\'editing-release\': !ctrl.editingAllProperties, \'is-setup\': ctrl.candidate.isSetup}">\n  <os-spinner ng-class="{\'loading-metadata\': spinner.show}" spinner="spinner" min-duration="200"></os-spinner>\n  \x3c!-- root, contains top and bottom --\x3e\n  <os-layout os-axis="y" resize-last="true" os-disabled="{{panels.root.disabled}}" class="layout-root">\n    \x3c!-- top contains left and right --\x3e\n    <os-layout class="top-row" os-axis="x" os-disabled="{{panels.top.disabled}}" on-resize="onResize()" os-min-size="150" os-size="false">\n      \x3c!-- trees when comments aren\'t visible --\x3e\n      <os-layout class="metadata-item-selector" ng-if="ctrl.doShowTree()" os-hidden="{{panels.trees.hidden}}" os-min-size="280" os-size="32%" storage-id="{{panels.trees.storageId}}">\n        <div class="os-col os-grow" ng-class="{\'no-scroll\': !ctrl.editingAllProperties && !ctrl.isAddingItems}">\n          <div class="os-control-container search-controls">\n            <div class="os-control-row" ng-if="showSearchUi">\n              <div class="os-search-box-container os-field os-grow">\n                <input\n                  type="text"\n                  class="os-search-box-input os-grow"\n                  ng-change="onSearchTextChange()"\n                  ng-model-options="{debounce: 300}"\n                  ng-model="filters.searchText"\n                  ng-disabled="ctrl.errorFilterManager.active || ctrl.editorMode === 0 && ctrl.isFormInvalid(releaseForm)"\n                  placeholder="{{\'Search\' | i18next}}"\n                >\n                <a class="os-search-box-clear-button" ng-show="!!filters.searchText" ng-click="clearSearch()" data-bs-original-title="{{\'Clear search\' | i18next}}">\n                  <os-svg icon="clear-field-button"></os-svg>\n                </a>\n              </div>\n              <button type="button"\n                      class="toggle-filters os-button os-clear os-pin-center"\n                      ng-show="itemTypes.all.length > 1"\n                      ng-click="toggleFilters()"\n                      ng-class="{\'os-active\': filtersVisible}"\n                      data-bs-original-title="{{\'Toggle filters\' | i18next}}"\n                      data-bs-placement="top">\n                <div class="button-content" ng-if="!filtersActive() || filtersVisible">\n                  <os-svg icon="filter-results-button" class="os-icon wide-icon"></os-svg>\n                </div>\n                <div class="button-content" ng-if="!filtersVisible && filtersActive()">\n                  <os-svg icon="filter-collapsed-button" class="os-icon wide-icon"></os-svg>\n                </div>\n              </button>\n              <div class="add-to-release-spacer" ng-if="itemTypes.all.length > 1 && ctrl.canAddItems()"></div>\n              <button type="button"\n                      class="os-button os-clear add-all-drawings-btn"\n                      ng-if="!ctrl.isAddingItems && ctrl.canAddItems() && ctrl.addAllDrawingsEnabled && ctrl.workspaceId"\n                      ng-click="ctrl.handleAddDrawingsClick()"\n                      ng-class="{\'os-active\': ctrl.candidate.addAllDrawingsActive}"\n                      ng-disabled="ctrl.changeDetectionInProgress"\n                      data-bs-original-title="{{\'Include associated drawings from current workspace\' | i18next}}"\n              >\n                <os-svg icon="release-drawings"></os-svg>\n              </button>\n              <button type="button"\n                      class="os-button os-clear add-items-btn"\n                      ng-if="!ctrl.isAddingItems && ctrl.canAddItems()"\n                      ng-click="ctrl.showAddItems()"\n                      data-bs-original-title="{{ctrl.getPlusButtonTooltip()}}"\n              >\n                <os-svg icon="plus-button"></os-svg>\n              </button>\n            </div>\n            <div class="os-row os-wrap search-filters" ng-show="filtersVisible && itemTypes.all.length > 1 && !isFilteredSelection()">\n              <div class="os-control-row os-grow">\n                <div class="os-row os-grow os-wrap filter-buttons">\n                  <button type="button"\n                          ng-repeat="type in itemTypes.all"\n                          ng-class="{\'os-active\': (type.active)}"\n                          ng-click="toggleTypeFilter(type.label)"\n                          class="os-button os-clear"\n                          data-bs-original-title="{{type.label}}"\n                          ng-disabled="ctrl.errorFilterManager.active || ctrl.editorMode === 0 && ctrl.isFormInvalid(releaseForm)"\n                          data-bs-placement="bottom">\n                    <div class="button-content">\n                      <os-svg icon="{{type.iconUrl}}" class="button-icon" alt="{{type.label}}"></os-svg>\n                    </div>\n                  </button>\n                </div>\n                <button type="button"\n                        ng-click="clearFilter()"\n                        ng-disabled="!filters.active.length || ctrl.editorMode === 0 && ctrl.isFormInvalid(releaseForm)"\n                        class="btn btn-sm btn-secondary me-2">\n                  <span>{{::(\'Clear\' | i18next)}}</span>\n                </button>\n              </div>\n            </div>\n          </div>\n          <div class="tree-container os-col">\n            <release-tree\n              nodes="ctrl.candidate.items"\n              can-item-be-removed="ctrl.candidate.canItemBeRemoved(node)"\n              active-workflow="ctrl.activeWorkflow"\n              should-show-item-version-icon="ctrl.shouldShowItemVersionIcon(node)"\n              filters="filters"\n              disabled="ctrl.editorMode === 0 && ctrl.isFormInvalid(releaseForm)"\n              is-selectable="ctrl.editingAllProperties"\n              form-ctrl="releaseForm"\n              inner-tmpl-url="\'/project/web/ts/release-management/inner-node.html\'"\n              clear-all="clearAll()"\n              get-more="ctrl.getMore(item)"\n              tree-ready="ctrl.onTreeReady()"\n              no-deselect-all="ctrl.requireSelection"\n              remove-node="ctrl.removeItem(node, true)"\n              class="document-tab-list tab-tree"\n              rebuild-event="rebuildMetadataTree"\n              has-config-tooltips="ctrl.hasConfigurationParams"\n              should-highlight-item="ctrl.shouldHighlightItem(item)"\n              style="margin-right: -{{scrollbarWidth}}px"\n              scroll-sync="{selector: \'releasable-property-sheet .table-body-wrap\', syncY: true, twoWay: true, disabled: ctrl.editingAllProperties}"\n              is-obsoletion-workflow="ctrl.isObsoletionWorkflow"\n            ></release-tree>\n          </div>\n        </div>\n      </os-layout>\n\n      <os-layout os-hidden="{{panels.selectItem.hidden}}" os-size="400px">\n        <div class="insert-item-container" ng-show="ctrl.isAddingItems">\n          <div class="insert-item-holder"></div>\n        </div>\n      </os-layout>\n\n      \x3c!-- property sheets --\x3e\n      <os-layout\n        os-hidden="{{panels.sheets.hidden}}"\n        os-min-size="25%"\n        os-size="false"\n        data-layout-id="property-sheet-panel"\n      >\n        <releasable-property-sheet\n          ng-if="!ctrl.editingAllProperties"\n          class="releasable-metadata-panel"\n          items="ctrl.selected.releaseItems"\n          editor="ctrl.editor"\n          placeholders="placeholders"\n          form-ctrl="releaseForm"\n          is-visible="ctrl.isItemVisible(item)"\n          on-change="ctrl.onPropertyChange(propertyId, value, itemId, modifyPreviousUpdate)"\n          validate="ctrl.validate(propertyId, value, itemId)"\n          hide-metadata-toggle="ctrl.isObsoletionWorkflow"\n          show-transition-arrow="!ctrl.isObsoletionWorkflow"\n          change-detection-enabled="ctrl.changeDetectionEnabled()"\n          change-detection-in-progress="ctrl.changeDetectionInProgress"\n          revert-unchanged="ctrl.revertUnchanged(items)"\n          part-number-val-gen-config="ctrl.partNumberGenConfig"\n          active-workflow="ctrl.activeWorkflow"\n          gen-part-nums="ctrl.genPartNumbers(items, skip)"\n          is-setup="ctrl.candidate.isSetup"\n          ordering="ctrl.ordering"\n          column-names="ctrl.columnNames"\n          should-highlight-item="ctrl.shouldHighlightItem(item)"\n          drawing-can-duplicate-part-number="ctrl.drawingCanDuplicatePartNumber"\n          company-policies="ctrl.companyPolicies"\n          uses-external-plm="ctrl.candidate.workflow.usesExternalPlm"\n          company-id="ctrl.companyId"\n          is-obsoletion-workflow="ctrl.isObsoletionWorkflow"\n        >\n        </releasable-property-sheet>\n        <metadata-property-sheet\n          ng-if="ctrl.editingAllProperties"\n          property-editable="ctrl.isItemPropertyEditable(prop)"\n          selected="ctrl.selected"\n          editor="ctrl.editor"\n          on-btn-click="ctrl.onPropertySheetBackBtn()"\n          btn-disabled="ctrl.isFormInvalid(form)"\n          icon-name="back-tab"\n          show-btn="true"\n          show-edit-path="true"\n          btn-title="\'Back to Release properties\' | i18next"\n          form-ctrl="releaseForm"\n          placeholders="placeholders"\n          skip-props="ctrl.propsToExclude"\n          on-change="ctrl.onPropertyChange(propertyId, value)"\n          has-load-failure="ctrl.failedToRetrieveMetadataProperties"\n          company-id="ctrl.companyId"\n          document-id="ctrl.documentId"\n          is-version="!ctrl.candidate.workspaceId"\n          wv-id="ctrl.candidate.workspaceId ? ctrl.candidate.workspaceId : ctrl.candidate.versionId"\n          fetch-computed="ctrl.loadComputed()"\n        ></metadata-property-sheet>\n      </os-layout>\n\n      <os-layout ng-if="!panels.selectItem.hidden" os-disabled="true" class="select-item-column">\n        <selected-item ng-if="ctrl.isAddingItems" additions="ctrl.additions.additions" deselect="ctrl.additions.deselect(item)" os-disabled="true"></selected-item>\n      </os-layout>\n\n      <os-layout ng-if="!panels.comments.hidden">\n        <div class="release-comments-view">\n          \x3c!-- The metadata-edit-path class has css for a header with a back button --\x3e\n          <div class="metadata-edit-path">\n            <h4>\n              <button class="os-button" ng-click="ctrl.setShowingComments(false)" data-bs-original-title="{{\'Back to Release properties\' | i18next}}">\n                <os-svg icon="back-tab"></os-svg>\n              </button>\n              <span>&nbsp;{{\'Comments\' | i18next}}</span>\n            </h4>\n          </div>\n          <div class="release-comments">\n            <metadata-property\n              prop="ctrl.getCommentProp()"\n              item="ctrl.candidate"\n              ctrl="ctrl.commentCtrl"\n              metadata-form="::releaseForm"\n            ></metadata-property>\n            <comment-list\n              comments="ctrl.candidate.comments"\n              readonly="true"\n              no-replies="true"\n            ></comment-list>\n            <os-disclosure class="parent-comments" ng-repeat="parent in ctrl.candidate.parentComments">\n              <os-disclosure-title>\n                <div class="parent-comments-header">\n                  <div class="parent-comments-title">{{ "Comments from __parentName__" | i18next:{parentName: parent.rpName} }}</div>\n                  <button class="btn btn-link parent-comments-link" ng-click="ctrl.changeToRelease(parent.rpId)">{{ "View release" | i18next }}</button>\n                </div>\n              </os-disclosure-title>\n              <os-disclosure-content>\n                <comment-list\n                  comments="parent.comments"\n                  readonly="true"\n                  no-replies="true"\n                >\n                </comment-list>\n              </os-disclosure-content>\n            </os-disclosure>\n          </div>\n        </div>\n      </os-layout>\n    </os-layout>\n\n    <os-layout\n      os-hidden="{{panels.bottom.hidden}}"\n      os-size="180px"\n      os-min-size="150px"\n      storage-id="{{panels.bottom.storageId}}"\n    > \x3c!-- bottom half  os-size="168px" --\x3e\n      <div class="release-package-panel">\n        <release-package-property-sheet\n          class="container-fluid"\n          form-ctrl="releaseForm"\n          placeholders="placeholders"\n          candidate="ctrl.selected.candidate"\n          on-change="ctrl.onPropertyChange(propertyId, value, itemId)"\n          opened-for-setup="ctrl.candidate.isSetup"\n          ng-if="ctrl.selected.candidate"\n          show-full-comments="ctrl.toggleComments"\n        >\n        </release-package-property-sheet>\n      </div>\n    </os-layout>\n  </os-layout>\n\n  <div class="modal-footer">\n    <div ng-if="!ctrl.isAddingItems" class="os-row footer-row flex-fill">\n      <div class="undo-redo">\n        <button class="os-button" type="button" ng-disabled="ctrl.isSpinnerRunning() || !ctrl.hasUndo()" data-bs-original-title="{{\'Undo\' | i18next}}" ng-click="ctrl.undo()">\n          <os-svg icon="undo-button"></os-svg>\n        </button>\n        <button class="os-button" type="button" ng-disabled="ctrl.isSpinnerRunning() || !ctrl.hasRedo()" data-bs-original-title="{{\'Redo\' | i18next}}" ng-click="ctrl.redo()">\n          <os-svg icon="redo-button"></os-svg>\n        </button>\n        <button\n          ng-if="ctrl.canShowSaveBtn() && !ctrl.canShowDeleteBtn()"\n          class="btn btn-secondary save-draft-btn"\n          ng-disabled="ctrl.canNotSaveDraft(releaseForm)"\n          ng-click="ctrl.saveDraft()"\n          data-original-tooltip="{{\'Save draft release package\' | i18next}}"\n        >{{\'Save draft\' | i18next}}</button>\n        <div ng-if="ctrl.canShowSaveBtn() && ctrl.canShowDeleteBtn()" class="btn-group dropup action-buttons">\n          <button class="btn btn-secondary save-draft-btn" type="button"\n            ng-disabled="ctrl.canNotSaveDraft(releaseForm)" ng-click="ctrl.saveDraft()"\n            data-original-tooltip="{{\'Save draft release package\' | i18next}}"\n          >{{"Save draft" | i18next}}</button><button type="button" class="btn btn-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><span class="visually-hidden">Toggle Dropdown</span></button>\n          <ul class="dropdown-menu release-draft-dropdown-menu dropdown-menu-end" menu-width="none" os-append-to-body="{backdrop: false, up: true, right: true, adjustTop: -2}">\n            <li><button class="btn os-button os-clear" type="button" ng-disabled="ctrl.canNotSaveDraft(releaseForm)" ng-click="ctrl.saveDraft()" data-original-tooltip="{{\'Save draft release\' | i18next}}">{{"Save draft" | i18next}}</button></li>\n            <li><button class="btn os-button os-clear" type="button" ng-disabled="ctrl.canNotDeleteDraft(releaseForm)" ng-click="ctrl.confirmDelete()" data-original-tooltip="{{\'Delete draft release\' | i18next}}">{{"Delete draft" | i18next}}</button></li>\n          </ul>\n        </div>\n      </div>\n      <div class="os-row footer-right">\n        <div ng-if="ctrl.candidate.areAnyRequiredPropertiesBlank() && ctrl.editorMode !== 0" class="missing-fields">\n          <span  data-bs-original-title="{{ctrl.requiredPropBlankMessage}}" overflow-tooltip="true">{{ctrl.requiredPropBlankMessage}}</span>\n          <required-props-message props="ctrl.candidate.getPropsRequiredForActions()"></required-props-message>\n        </div>\n        <div class="os-row actions">\n          <button ng-if="ctrl.canShowApplyBtn()" class="btn btn-primary" type="button" ng-disabled="ctrl.isFormPristineOrInvalid(releaseForm)" ng-click="ctrl.apply()" data-original-tooltip="{{\'Apply metadata changes\' | i18next}}">{{"Apply" | i18next}}</button>\n          <div ng-repeat="hint in ctrl.candidate.uiHints" ng-if="ctrl.shouldShowWorkflowActions()">\n            <button\n              ng-if="ctrl.candidate.actionsByUiHint[hint].length === 1"\n              class="btn btn-{{hint}}"\n              type="button"\n              ng-disabled="ctrl.isSpinnerRunning() || ctrl.shouldDisableWorkflowAction(ctrl.candidate.actionsByUiHint[hint][0], releaseForm) || !(ctrl.candidate.actionsByUiHint[hint][0].allowIfApprovers && ctrl.candidate.hasApprovers() || ctrl.candidate.actionsByUiHint[hint][0].allowIfNoApprovers && !ctrl.candidate.hasApprovers())"\n              ng-click="ctrl.exec(ctrl.candidate.actionsByUiHint[hint][0], releaseForm)"\n              data-release-action="{{ctrl.candidate.actionsByUiHint[hint][0].label}}"\n              data-original-tooltip="{{ctrl.candidate.actionsByUiHint[hint][0].tooltip}}">{{ctrl.candidate.actionsByUiHint[hint][0].label}}</button>\n            <div ng-if="ctrl.candidate.actionsByUiHint[hint].length > 1" class="btn-group dropup action-buttons">\n              <button\n                class="btn btn-{{::hint}}"\n                type="button"\n                ng-disabled="ctrl.isSpinnerRunning() || ctrl.shouldDisableWorkflowAction(ctrl.candidate.actionsByUiHint[hint][0], releaseForm) || !(ctrl.candidate.actionsByUiHint[hint][0].allowIfApprovers && ctrl.candidate.hasApprovers() || ctrl.candidate.actionsByUiHint[hint][0].allowIfNoApprovers && !ctrl.candidate.hasApprovers())"\n                ng-click="ctrl.exec(ctrl.candidate.actionsByUiHint[hint][0], releaseForm)"\n                data-original-tooltip="{{ctrl.candidate.actionsByUiHint[hint][0].tooltip}}">{{ctrl.candidate.actionsByUiHint[hint][0].label}}</button>\n                <button\n                  type="button"\n                  class="btn btn-{{hint}} dropdown-toggle dropdown-toggle-split"\n                  data-bs-toggle="dropdown"\n                  aria-haspopup="true"\n                  aria-expanded="false"><span class="visually-hidden">Toggle Dropdown</span></button>\n                <ul class="dropdown-menu release-dropdown-menu dropdown-menu-end" menu-width="none" os-append-to-body="{backdrop: false, up: true, right: true, adjustTop: -2}">\n                  <li ng-repeat="action in ctrl.candidate.actionsByUiHint[hint]">\n                    <button\n                      class="btn os-button os-clear hint-{{::hint}}"\n                      type="button"\n                      ng-disabled="ctrl.isSpinnerRunning() || ctrl.shouldDisableWorkflowAction(action, releaseForm) || !(action.allowIfApprovers && ctrl.candidate.hasApprovers() || action.allowIfNoApprovers && !ctrl.candidate.hasApprovers())"\n                      ng-click="ctrl.exec(action, releaseForm)"\n                      data-release-action="{{::action.label}}"\n                      data-original-tooltip="{{::action.tooltip}}">{{::action.label}}</button>\n                  </li>\n                </ul>\n            </div>\n          </div>\n          <button class="btn btn-primary clone-button" type="button"\n                  ng-if="ctrl.shouldShowCloneButton()"\n                  data-bs-original-title="{{\'Recreate Release from the current workspace\' | i18next}}"\n                  ng-click="ctrl.refreshRelease(true)"\n                  ng-disabled="ctrl.isSpinnerRunning()"\n          >{{"Clone" | i18next}}</button>\n          <button class="btn btn-secondary button-cancel" type="button" ng-click="ctrl.close(\'DISCARD_CHANGES\')" ng-if="ctrl.editorMode !== 0">{{"Close" | i18next}}</button>\n          <button class="btn btn-secondary" type="button" ng-click="ctrl.onPropertySheetBackBtn()" ng-disabled="ctrl.isFormInvalid(releaseForm) || ctrl.isSpinnerRunning()" data-bs-original-title="{{\'Back to Release properties\' | i18next}}" ng-if="ctrl.editorMode === 0">{{"Go back" | i18next}}</button>\n        </div>\n      </div>\n    </div>\n    <div ng-if="ctrl.isAddingItems">\n      <button class="btn btn-primary" type="button" ng-disabled="ctrl.isAddItemsButtonDisabled()" ng-click="ctrl.addSelectedItems()" data-bs-original-title="{{ctrl.getFooterAddButtonTooltip()}}">{{\'Add\' | i18next}}</button>\n      <button class="btn btn-secondary button-cancel" type="button" ng-click="ctrl.cancelAddItems()" ng-disabled="ctrl.isSpinnerRunning()" data-bs-original-title="{{ctrl.getFooterCancelButtonTooltip()}}">{{\'Cancel\' | i18next}}</button>\n    </div>\n  </div>\n</form>\n')}]),e.exports=n},72805:function(e,t,i){var n="/project/web/ts/release-management/revision-history-dialog.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="modal-header no-border">\n  <h3 class="modal-title">{{ "Revision history" | i18next}}</h3>\n  <button type="button" class="btn-close" ng-click="ctrl.close()" aria-hidden="true"></button>\n</div>\n<div class="modal-body">\n  <h4 class="m-0" data-bs-original-title="{{ partNumber }}">{{ partNumber }}</h4>\n  <os-spinner spinner="spinner"></os-spinner>\n  <div ng-if="!spinner.show" class="revision-history-view">\n    <part-history\n      message="message"\n      revisions="revisions"\n      compact="false"\n      row-class="\'revision-details-row\'"\n      revision-title-class="\'revision-details-title\'"\n      revision-subtitle-class="\'revision-details-subtitle\'"\n      on-view-btn-click="ctrl.showPackage(packageId, highlightItems)"\n      on-obsolete-btn-click="ctrl.obsoleteRevision(rev)">\n    </part-history>\n  </div>\n\n  <div class="modal-footer no-border revision-history-footer">\n    <button class="btn btn-secondary button-cancel" type="button" ng-click="ctrl.close()">{{"Close" | i18next}}</button>\n  </div>\n</div>\n')}]),e.exports=n},76554:function(e,t,i){var n="/project/web/ts/requestInvite/requestInvite.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="os-content-scroll-container">\n  <div class="os-brand-logo-container">\n    <img src="/images/logo-onshape-gray-green_medium.svg" alt="Onshape Brand" />\n  </div>\n  <div class="os-centered-form-container-narrow">\n    <os-form os-controller-name="RequestInviteController">\n      <h3>{{ "Create Free account" | i18next}}</h3>\n      <div class="os-form-group">\n        <os-form-field>\n          <input placeholder="{{\'Email\' | i18next}}" class="form-control" name="email" ng-model="RequestInviteController.user.email" type="text" required os-email spellcheck="false" />\n          <os-form-validation-list os-field-name="email">\n            <os-form-validation-item os-error-criteria="osForm.email.$invalid" os-message="{{\'Valid email required\' | i18next}}"></os-form-validation-item>\n          </os-form-validation-list>\n        </os-form-field>\n      </div>\n      <div class="os-form-group">\n        <h4>{{\'Name\' | i18next}}</h4>\n        <os-form-field class="os-form-field-half-width">\n          <input placeholder="{{\'First name\' | i18next}}" type="text" class="form-control" name="firstName" ng-model="RequestInviteController.user.firstName" ng-maxlength="64" spellcheck="false" required>\n          <os-form-validation-list os-field-name="firstName">\n            <os-form-validation-item os-error-criteria="osForm.firstName.$error.maxlength" os-message="{{\'64 character maximum\' | i18next}}"></os-form-validation-item>\n          </os-form-validation-list>\n        </os-form-field>\n        <os-form-field class="os-form-field-half-width">\n          <input placeholder="{{\'Last name\' | i18next}}" type="text" class="form-control" name="lastName" ng-model="RequestInviteController.user.lastName" ng-maxlength="64" spellcheck="false" required>\n          <os-form-validation-list os-field-name="lastName">\n            <os-form-validation-item os-error-criteria="osForm.lastName.$error.maxlength" os-message="{{\'64 character maximum\' | i18next}}"></os-form-validation-item>\n          </os-form-validation-list>\n        </os-form-field>\n        <div class="clearfix"></div>\n      </div>\n      <div class="os-form-group">\n        <h4>{{\'Role\' | i18next}}</h4>\n        <select class="form-control" ng-model="RequestInviteController.selectedRole.content" ng-options="userRole as userRole.label for userRole in RequestInviteController.userRoles">\n          <option value="" disabled>{{\'Choose your role:\' | i18next}}</option>\n        </select>\n      </div>\n      <div class="os-form-group">\n        <h4>{{\'Company\' | i18next}}</h4>\n        <os-form-field>\n          <input placeholder="{{\'Company name (optional)\' | i18next}}" type="text" name="defaultCompanyName" class="form-control" ng-model="RequestInviteController.user.defaultCompanyName" ng-maxlength="64" spellcheck="false">\n        </os-form-field>\n        <div>\n          <os-form-validation-list os-field-name="defaultCompanyName">\n            <os-form-validation-item os-error-criteria="osForm.defaultCompanyName.$error.maxlength" os-message="{{\'64 character maximum\' | i18next}}"></os-form-validation-item>\n          </os-form-validation-list>\n        </div>\n      </div>\n      <div class="os-form-field-container">\n        <input type="checkbox" id="EULA" name="EULA" ng-model="RequestInviteController.user.eulaAccepted">\n        <label for="EULA">{{ \'I agree to the\' | i18next}}</label>\n        <a ng-href="https://www.onshape.com/legal" target="_blank" class="add-space-left">{{\'Onshape Terms & Privacy\' | i18next}}</a>\n      </div>\n      <div class="os-form-btn-container">\n        <button type="submit" class="btn btn-primary" ng-disabled="!RequestInviteController.user.eulaAccepted || RequestInviteController.selectedRole.content.code < 1">{{ "Create Free account" | i18next}}</button>\n      </div>\n      <div class="os-form-footer" ng-if="!RequestInviteController.mobileBrowserDetected">\n        <a ng-click="RequestInviteController.goToSignIn()" class="os-link-to-sign-in" tabindex="6">{{\'Sign in\' | i18next}}</a>\n      </div>\n    </os-form>\n  </div>\n</div>\n')}]),e.exports=n},14701:function(e,t,i){var n="/project/web/ts/security/confirmPassword.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="modal-header">\n  <h4 class="modal-title">{{ "Confirm your Onshape password" | i18next}}</h4>\n  <button type="button" clas