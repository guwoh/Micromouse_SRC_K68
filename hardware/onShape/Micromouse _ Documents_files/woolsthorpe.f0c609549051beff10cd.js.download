ntReference) || ctrl.isContentLoading || ctrl.type.length === 0" ng-model="ctrl.selectionData.selectedType" ng-options="theType for theType in ctrl.componentType" ng-change="ctrl.onComponentChange()"></select>\n    </div>\n  </div>\n  <div class="standard-content-splittercontainer-row">\n    <div class="standard-content-properties-container">\n      <div ng-if="ctrl.componentError">{{ctrl.componentError}}</div>\n      <div ng-show="ctrl.isComponentLoading" class="ns-select-item-dialog-item-empty">\n        <span>{{"Loading component…" | i18next}}</span>\n      </div>\n      <div ng-if="!ctrl.componentError">\n        <div ng-repeat="parameter in ctrl.componentData.parameters" ng-if="parameter.visible && parameter.isDrivingConfiguration" ng-class="ctrl.canAutoSizeComponent ? \'standard-content-parameternamevalue-display-triple-column\' : \'standard-content-parameternamevalue-display-two-column\'">\n          <label class="standard-content-parametervalue-entry-column-left">{{parameter.displayName}}</label>\n          <select ng-disabled="ctrl.isContentLoading" ng-class="ctrl.canAutoSizeComponent ? \'standard-content-parametervalue-entry-column-center\' : \'standard-content-parametervalue-entry-column-right\'" ng-if="parameter.valueFieldType === ctrl.valueFieldTypes.DROPLIST" ng-model="parameter.defaultValue" ng-options="selection for selection in parameter.parameterValues" ng-change="ctrl.userSelectParameterChange(parameter)"></select>\n          <select ng-disabled="ctrl.isContentLoading" ng-class="ctrl.canAutoSizeComponent ? \'standard-content-parametervalue-entry-column-center\' : \'standard-content-parametervalue-entry-column-right\'" ng-if="parameter.valueFieldType === ctrl.valueFieldTypes.MATERIALLIST" ng-model="parameter.defaultDisplayValue" ng-options="selection for selection in parameter.parameterDisplayValues" ng-change="ctrl.userSelectParameterChange(parameter)"></select>\n          <input ng-disabled="(ctrl.isContentLoading && !ctrl.isEditingProperties) ||