                        <os-svg class="os-help-btn" icon="help-button"></os-svg>\n                            </a>\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div os-min-length="410">\n        <div id="referencerepairdiv" class="canvas-container ref-repair"></div>\n        <div class="left-footer">\n            <button\n                class="os-button os-clear"\n                ng-class="{\'os-active ng-scope\' : referenceRepairController.getIsSynchingView()}"\n                ng-click="referenceRepairController.toggleViewSynching()"\n                data-bs-placement="right"\n                data-bs-original-title="{{ \'Synchronize view\' | i18next }}">\n                    <os-svg icon="lock-rotation" class="os-icon-medium"></os-svg>\n            </button>\n        </div>\n    </div>\n</div>\n\n')}]),e.exports=n},11678:function(e,t,i){var n="/project/web/ts/release-management-settings/edit-watermarks-dialog.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div>\n  <div class="modal-header">\n    <h4 class="modal-title">Watermarks</h4>\n    <button type="button" class="btn-close" ng-click="$dismiss()" aria-hidden="true"></button>\n  </div>\n  <form class="form-horizontal" name="editWatermarksForm" method="post" autocomplete="off" novalidate>\n    <div class="modal-body" ng-if="$ctrl.spinner.show">\n      <os-spinner spinner="$ctrl.spinner"></os-spinner>\n    </div>\n    <div class="modal-body" ng-if="!$ctrl.spinner.show">\n      <div class="row mb-3" ng-repeat="(key, value) in $ctrl.drawingPolicies.stateToWatermark">\n        <label class="control-label text-lg-end col-sm-3 col-form-label">{{ $ctrl.getReleaseStateFromName(key) | i18next }}</label>\n        <div class="col-sm-8">\n          <input name="{{key}}" type="text" class="form-control" ng-disabled="!$ctrl.isAdmin" ng-model="$ctrl.drawingPolicies.stateToWatermark[key]" ng-maxlength="{{$ctrl.WATERMARK_MAX_LENGTH}}">\n          <span class="text-danger ng-hide" ng-show="editWatermarksForm.{{key}}.$error.maxlength">{{ \'Length must not exceed __maxLength__ characters.\' | i18next:{maxLength: $ctrl.WATERMARK_MAX_LENGTH} }}</span>\n        </div>\n      </div>\n    </div>\n    <div class="modal-footer">\n      <button class="btn btn-primary" type="button" ng-disabled="$ctrl.isSaveWatermarksDisabled()" ng-click="$ctrl.saveWatermarks()">{{ "Save changes" | i18next }}</button>\n      <button class="btn btn-secondary button-cancel" type="button" ng-click="$dismiss()">{{ "Cancel" | i18next }}</button>\n    </div>\n  </form>\n</div>\n')}]),e.exports=n},63466:function(e,t,i){var n="/project/web/ts/release-management-settings/release-management-settings.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<form class="form-horizontal" name="companyReleaseSettingsForm" novalidate>\n  <div class="os-form-group">\n    <fieldset ng-disabled="!$ctrl.isAdmin">\n      <div class="os-form-group-indent">\n        <b>{{ "Release management settings for objects in documents owned by __companyName__." | i18next:{companyName: $ctrl.companyName} }}</b>\n      </div>\n      <br/>\n      <div class="os-form-group-indent">\n        <button\n          ng-disabled="$ctrl.isSaveDisabled()"\n          type="button"\n          class="btn btn-primary"\n          ng-click="$ctrl.updateCompanyReleaseSettings()"\n          id="btn-top-company-release-settings-save"\n        >{{ "Save release settings" | i18next }}\n        </button>\n        <div ng-if="$ctrl.showArenaSyncState">\n          <div class="alert alert-info" ng-bind="$ctrl.arenaSyncInfoText"></div>\n        </div>\n      </div>\n    </fieldset>\n    <div class="os-profile-vertical-list">\n      \x3c!-- Workflow --\x3e\n      <fieldset ng-disabled="!$ctrl.isAdmin">\n        <div class="user-settings-section-header">\n          <h4 class="os-user-preference-inline-heading">{{ "Workflows" | i18next }}</h4>\n          <div class="os-user-preference-info popover-container">\n          <span class="os-question-mark"\n                popover-trigger="\'mouseenter\'"\n                popover-append-to-body="true"\n                uib-popover="{{ \'Choose whether to release your designs by manually creating versions and updating revision properties, or by using Onshape\\\'s managed workflows to create and approve Release candidates\' | i18next }}"\n                popover-placement="right">\n          </span>\n          </div>\n        </div>\n        <div class="user-settings">\n          <div class="workflows-enabled-container" ng-if="$ctrl.initialLoadComplete">\n            <label>\n              <input type="checkbox"\n                     id="workflow-enabled-checkbox"\n                     ng-model="$ctrl.workflowsEnabled"\n                     ng-disabled="!$ctrl.isAdmin"\n                     ng-change="$ctrl.onWorkflowsEnabledStateChanged()"\n              >\n              <span class="os-radio-or-checkbox-text">{{ "Enable managed workflows" | i18next }}</span>\n            </label>\n          </div>\n          <workflow-manager-types ng-if="!$ctrl.isCustomTaskWorkflowsEnabled && $ctrl.initialLoadComplete && !$ctrl.isUsingManualWorkflow()"\n                                  editable="::$ctrl.isAdmin"\n                                  initial-release-workflow="::$ctrl.company.releaseProcess.releaseWorkflowId"\n                                  initial-obsoletion-workflow="::$ctrl.company.releaseProcess.obsoletionWorkflowId"\n                                  on-workflows-changed="$ctrl.onActiveWorkflowsChanged({releaseWorkflows, obsoletionWorkflows})"\n                                  on-workflow-manager-loaded="$ctrl.onPublishedWorkflowsLoaded({publishedWorkflows})"\n                                  on-selected-workflow-type-changed="$ctrl.onWorkflowTypeChanged({workflowType})"\n                                  on-workflow-unpublished="$ctrl.onWorkflowUnpublished({workflow})"\n                                  is-enterprise="::$ctrl.isEnterprise"\n                                  revision-sync-enabled="$ctrl.revisionSyncEnabled"\n          ></workflow-manager-types>\n          <osx-workflow-manager-types ng-if="$ctrl.isCustomTaskWorkflowsEnabled && $ctrl.initialLoadComplete && !$ctrl.isUsingManualWorkflow()"\n                                  [initial-workflow-ids]="$ctrl.initialWorkflowIds"\n                                  [workflow-type-options]="$ctrl.workflowTypeOptions"\n                                  (on-workflows-changed)="$ctrl.onActiveWorkflowsChanged($event)"\n                                  (on-workflow-manager-loaded)="$ctrl.onPublishedWorkflowsLoaded($event)"\n                                  (on-selected-workflow-type-changed)="$ctrl.onWorkflowTypeChanged($event)"\n                                  (on-workflow-unpublished)="$ctrl.onWorkflowUnpublished($event)"\n                                  [is-enterprise]="$ctrl.isEnterprise"\n                                  [revision-sync-enabled]="$ctrl.revisionSyncEnabled"\n          ></osx-workflow-manager-types>\n        </div>\n      </fieldset>\n\n      <div ng-if="!$ctrl.isUsingManualWorkflow()">\n        <fieldset ng-disabled="!$ctrl.isAdmin">\n          \x3c!-- Revisions and part numbers --\x3e\n          <div class="user-profile-section-header">\n            <h4>{{ "Revisions and part numbers" | i18next }}</h4>\n          </div>\n          <div class="user-settings">\n            <revision-scheme-picker ng-if="!$ctrl.isUsingManualWorkflow()"\n                                    company-id="$ctrl.companyId"\n                                    original-revision-scheme-id="$ctrl.companyPolicies.revisionSchemeId"\n                                    editable="$ctrl.isAdmin"\n            ></revision-scheme-picker>\n            <div class="os-form-container">\n              <div>\n                <label>\n                  <span>{{ "Unreleased revision suffix:" | i18next }}</span>\n                  <input type="text" name="revisionSuffix" ng-model="$ctrl.company.releaseProcess.revisionSuffix" ng-trim="false" class="form-control">\n                </label>\n              </div>\n            </div>\n            <div class="os-form-container">\n              <properties-table-template-list\n                company-id="$ctrl.companyId"\n                template-type="$ctrl.templateType"\n              ></properties-table-template-list>\n            </div>\n            <div>\n              <a ng-href="{{$ctrl.numberingSchemeSettingsLink}}">{{ \'Click here to go to release management part number generation settings\' | i18next }}</a>\n            </div>\n          </div>\n\n          \x3c!-- Access --\x3e\n          <div class="user-profile-section-header">\n            <h4>{{ "Access" | i18next }}</h4>\n          </div>\n          <div class="user-settings">\n            <div class="os-form-container">\n              <div class="wide-form-group">\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.onlyAdminsCanEditPropertiesOfReleasedObjects" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Only administrators can edit the properties of released objects" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.onlyAdminsCanMarkObjectsAsNotRevisionManaged" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Only administrators can mark objects as not revision-managed" | i18next }}</span>\n                  </label>\n                </div>\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.onlyAdminsCanDeleteDocumentsContainingReleasedObjects" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Only administrators can delete documents containing released objects" | i18next }}</span>\n                  </label>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          \x3c!-- Actions --\x3e\n          <div class="user-profile-section-header">\n            <h4>{{ "Actions" | i18next }}</h4>\n          </div>\n          <div class="user-settings">\n            <div class="os-form-container">\n              <div class="wide-form-group">\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.treatMetadataChangesAsChanges"\n                           ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Require a new revision when an item\'s properties have changed" | i18next }}</span>\n                  </label>\n                </div>\n              </div>\n            </div>\n          </div>\n        </fieldset>\n\n        \x3c!-- Watermarks --\x3e\n        <fieldset ng-disabled="!$ctrl.isAdmin">\n          <div class="user-profile-section-header">\n            <h4>{{ "Watermarks" | i18next }}</h4>\n          </div>\n          <div class="user-settings">\n            <div class="os-form-container">\n              <div class="wide-form-group">\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.actionShowDrawingsWatermark"\n                           ng-disabled="$ctrl.isUsingManualWorkflow()" ng-change="$ctrl.onToggleShowDrawingsWatermark()">\n                    <span class="os-radio-or-checkbox-text">{{ "Show watermark for drawings" | i18next }}</span>\n                  </label>\n                </div>\n                <div ng-if="!$ctrl.isUsingManualWorkflow