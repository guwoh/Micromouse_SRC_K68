roller="VariableTablePaneController as variableTableController"\n     oncontextmenu="return false;">\n  <div class="os-col os-full-height">\n    \x3c!-- Pane title. --\x3e\n    <div class="right-pane-header-tabs" os-parameter="variableTableController.titleTabParameter"></div>\n\n    <div class="tables-container-wrapper"\n         ng-include="\'/project/web/ts/variables/variableTables.html\'"></div>\n\n    <div class="content-footer os-row">\n      <div class="button-container">\n        <div ng-if="variableTableController.getShouldShowVariableStudioReferenceButtons()"\n            class="btn-group dropup">\n          <button type="button"\n                  class="btn btn-secondary create-variable-studio-button"\n                  ng-click="variableTableController.createAndReferenceVariableStudio()"\n                  data-bs-original-title="{{ \'Create Variable Studio\' | i18next }}"\n                  data-bs-placement="left"\n                  ng-if="!variableTableController.getDocumentHasVariableStudios()">\n            <os-svg icon="add-variablestudio-button"></os-svg>\n            <span class="os-tool-command-name">\n              {{"Create Variable Studio" | i18next}}\n            </span>\n          </button>\n          <button type="button"\n                  class="btn btn-secondary insert-variable-studio-button"\n                  ng-click="variableTableController.openVariableStudioInsertDialog()"\n                  data-bs-original-title="{{ \'Insert Variable Studio\' | i18next }}"\n                  data-bs-placement="left"\n                  ng-if="variableTableController.getDocumentHasVariableStudios()">\n            <os-svg icon="insert-variable-button"></os-svg>\n            <span class="os-tool-command-name">\n              {{"Insert Variable Studio" | i18next}}\n            </span>\n          </button>\n          <button type="button"\n                  data-bs-toggle="dropdown"\n                  class="btn btn-secondary dropdown-toggle dropdown-t