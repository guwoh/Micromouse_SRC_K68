Workflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Require the release of parts and assemblies in a drawing when releasing the drawing" | i18next }}</span>\n                  </label>\n                </div>\n                \x3c!-- TODO - Raj enable after we can support it BEL-83540 --\x3e\n                <div ng-hide="true">\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.requireBasePartReleaseWithDerivedPart" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Require the release of the base part when releasing a derived part" | i18next }}</span>\n                  </label>\n                </div>\n                \x3c!-- TODO - Raj enable after we can support it BEL-85924 --\x3e\n                <div ng-hide="true">\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.requireImageReleaseWithDrawing" ng-disabled="$ctrl.isUsingManualWorkflow()">\n                    <span class="os-radio-or-checkbox-text">{{ "Require the release of images in a Drawing when releasing the drawing" | i18next }}</span>\n                  </label>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          \x3c!-- Release conditions --\x3e\n          <div class="user-profile-section-header">\n            <h4>{{ "Release conditions" | i18next }} <small style="margin-left: 15px; display: inline-block; color: var(--os-text-secondary)">{{ "Selected conditions will prevent a Release from being created" | i18next }}</small></h4>\n          </div>\n          <div class="user-settings">\n            <div class="os-form-container">\n              <div class="wide-form-group">\n                <div>\n                  <label>\n                    <input type="checkbox" ng-model="$ctrl.company.releaseProcess.errorOnFeatureListErrorsDuringRelease" ng-disabled=