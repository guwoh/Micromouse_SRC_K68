 align-items-center">\n        <div class="right-margin">{{\'Controlled by\' | i18next}}</div>\n        <div class="dropdown select-container-wrapper" data-bs-original-title={{$ctrl.getControlledByButtonText()}} data-bs-placement="right">\n          <button data-bs-toggle="dropdown" class="dropdown-toggle simple-select max-width-limit ellipseOverflowText"\n            ng-init="parameterOpened = false" ng-blur="parameterOpened = true"\n            ng-class="{\'invalid-input\': parameterOpened && condition.configParam === null, \'valid-input\': !parameterOpened || condition.configParam !== null}"\n            ng-disabled="$ctrl.isReadOnly">\n            <div class="max-width-limit ellipseOverflowText">{{$ctrl.getControlledByButtonText()}}</div>\n          </button>\n          <ul class="os-select-choices os-select-choices-content os-select-dropdown dropdown-menu" role="menu">\n            <li class="clickable-input max-width-limit"\n              ng-if="$ctrl.getConfigParamsForSettingVisibilityCondition({parameterId: $ctrl.configParam.getParameterId(), conditionIndex: $ctrl.conditionIndex}).length === 0">\n              <a class="dropdown-item ellipseOverflowText" href="#">{{\'Select input\' | i18next}}</a>\n            </li>\n            <li class="clickable-input max-width-limit ellipseOverflowText"\n              ng-repeat="configParamControl in $ctrl.getConfigParamsForSettingVisibilityCondition({parameterId: $ctrl.configParam.getParameterId(), conditionIndex: $ctrl.conditionIndex})"\n              ng-click="$ctrl.handleConfigParamSelection(configParamControl)" data-bs-original-title={{configParamControl.getDisplayName()}} data-bs-placement="right">\n              <a class="dropdown-item ellipseOverflowText" ng-class="{ selected: condition.configParam.getParameterId() === configParamControl.getParameterId() }" href="#">\n                {{configParamControl.getDisplayName()}}\n              </a>\n            </li>\n          </ul>\n        </div>\n      </div>\n   