" os-parameter="configurationPaneController.configurationTabParameter"></div>\n  <div class="configuration-pane-content"\n       ng-if="configurationPaneController.getActiveTab() === \'configurations-tab\'">\n    <div ng-if="configurationPaneController.getCanCreateNewConfigurationForUnconfiguredPS()"\n         class="header-button-container">\n      \x3c!-- Show the create configurations button if not configured --\x3e\n      <div class="btn-group">\n        <button type="button"\n            class="btn btn-secondary add-configuration-button"\n            ng-click="configurationPaneController.addBasicConfigurationTable()"\n            data-bs-original-title="{{ configurationPaneController.getConfigureElementButtonTooltip() }}"\n            data-bs-placement="left">\n          <os-svg icon="configuration-list-button"></os-svg>&ensp;{{configurationPaneController.buttonLabel()}}\n        </button>\n        <button type="button"\n                data-bs-toggle="dropdown"\n                class="btn btn-secondary dropdown-toggle dropdown-toggle-split caret-button"\n                >\n        </button>\n        <ul class="dropdown-menu dropdown-menu-end">\n          <li>\n            <a class="dropdown-item" ng-click="configurationPaneController.addListInput()"><os-svg icon="configuration-list-button"></os-svg>&ensp;{{ "List" | i18next}}</a>\n          </li>\n          <li>\n            <a class="dropdown-item" ng-click="configurationPaneController.addBooleanInput()"><os-svg icon="configuration-checkbox-button"></os-svg>&ensp;{{ "Checkbox" | i18next}}</a>\n          </li>\n          <li>\n            <a class="dropdown-item" ng-click="configurationPaneController.addVariableInput()"><os-svg icon="configuration-variable-button"></os-svg>&ensp;{{ "Configuration variable" | i18next}}</a>\n          </li>\n          <li ng-if="configurationPaneController.hasCopiedConfigurationInputs()">\n            <a class="dropdown-item" ng-click="configurationPaneController.pasteConfigurationInput()"><os-svg icon="paste-command"></os-svg>&ensp;{{ "Paste inputs" | i18next}}</a>\n          </li>\n        </ul>\n      </div>\n    </div>\n    <osc-zero-state-screen\n      ng-if="!configurationPaneController.getIsElementConfigured()"\n      class="zero-state-screen-container"\n      icon="configuration-panel-empty"\n      message="{{configurationPaneController.getZeroStateMessage()}}"\n      linkurl="{{configurationPaneController.getHelpUrl()}}"\n      linktext="{{configurationPaneController.getHelpUrlLabel()}}">\n    </osc-zero-state-screen>\n  </div>\n  <configuration-tables class="tables-container-wrapper" ng-if="configurationPaneController.getActiveTab() === \'configurations-tab\' && configurationPaneController.getIsElementConfigured()"></configuration-tables>\n  <configured-part-properties class="tables-container-wrapper configured-part-properties-table-container" ng-if="configurationPaneController.getActiveTab() === \'configured-part-properties-tab\' && configurationPaneController.showPartPropertiesTab()"></configured-part-properties>\n  <configured-element-properties class="tables-container-wrapper configured-part-properties-table-container" ng-if="configurationPaneController.getActiveTab() === \'configured-element-properties-tab\' && configurationPaneController.showElementPropertiesTab()"></configured-element-properties>\n  <div class="content-footer os-row"\n       ng-if="configurationPaneController.getActiveTab() === \'configurations-tab\'">\n    <div class="button-container">\n      <div ng-if="configurationPaneController.getCanCreateNewConfiguration()"\n           class="btn-group dropup">\n        <button type="button"\n                class="btn btn-secondary add-configuration-button"\n                ng-click="configurationPaneController.addListInput()"\n                data-bs-original-title="{{ configurationPaneController.getConfigureElementButtonTooltip() }}"\n                data-bs-placement="left">\n          <os-svg icon="configuration-list-button"></os-svg>&ensp;{{"Add configuration input" | i18next}}\n        </button>\n        <button type="button"\n                data-bs-toggle="dropdown"\n                class="btn btn-secondary dropdown-toggle dropdown-toggle-split caret-button">\n        </button>\n\n        <ul class="dropdown-menu dropdown-menu-end">\n          <li>\n            <a class="dropdown-item" ng-click="configurationPaneController.addListInput()"><os-svg icon="configuration-list-button"></os-svg>&ensp;{{ "List" | i18next}}</a>\n          </li>\n          <li>\n            <a class="dropdown-item" ng-click="configurationPaneController.addBooleanInput()"><os-svg icon="configuration-checkbox-button"></os-svg>&ensp;{{ "Checkbox" | i18next}}</a>\n          </li>\n          <li>\n            <a class="dropdown-item" ng-click="configurationPaneController.addVariableInput()"><os-svg icon="configuration-variable-button"></os-svg>&ensp;{{ "Configuration variable" | i18next}}</a>\n          </li>\n          <li ng-if="configurationPaneController.hasCopiedConfigurationInputs()">\n            <a class="dropdown-item" ng-click="configurationPaneController.pasteConfigurationInput()"><os-svg icon="paste-command"></os-svg>&ensp;{{ "Paste inputs" | i18next}}</a>\n          </li>\n        </ul>\n      </div>\n    </div>\n\n    \x3c!-- Only show the help button for the main configurations tab, and not the properties tab. --\x3e\n    <div class="right-pane-help-container" ng-if="configurationPaneController.getActiveTab() === \'configurations-tab\'">\n      <os-vue-help-link-component ng-if="configurationPaneController.isInPartStudio() || configurationPaneController.isInVariableStudio()"\n                     v-props="{helpContextKey: \'configurations\'}"></os-vue-help-link-component>\n      <os-vue-help-link-component ng-if="configurationPaneController.isInAssembly()"\n                     v-props="{helpContextKey: \'assembly_configurations\'}"></os-vue-help-link-component>\n    </div>\n  </div>\n</div>\n')}]),e.exports=n},24048:function(e,t,i){var n="/project/web/ts/configurations/configurationParametersVisibilityDialog.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="edit-config-param-visibility-dialog-container">\n  <div class="modal-header d-flex" resizable-modal="{{$ctrl.dialogSizeConfig}}">\n    <div class="d-flex justify-content-between align-items-center w-75">\n      <div class="d-flex align-items-center gap-2">\n        <div class="row mt-2">\n          <h4 class="text-info">{{"Configuration visibility conditions" |  i18next}}</h4>\n        </div>\n        \x3c!-- Menu option for expand/collapse all --\x3e\n        <div ng-if="!$ctrl.currentConfigurationParam && $ctrl.hasMultipleExpandableParams()">\n          <li class="dropdown os-table-more-button-container">\n            <a data-bs-toggle="dropdown"\n                class="os-table-more-button-control"\n                ng-click="$parent.removeContextMenuStyle(true)">\n              <os-svg icon="overflow"></os-svg>\n            </a>\n\n            <ul class="dropdown-menu dropdown-menu-start os-table-more-menu w-auto">\n              <li ng-if="$ctrl.canExpandAllConfigs()">\n                <a class="dropdown-item" ng-click="$ctrl.expandAllConfigurations()">{{"Expand all inputs" | i18next}}</a>\n              </li>\n              <li ng-if="$ctrl.canCollapseAllConfigs()">\n                <a class="dropdown-item" ng-click="$ctrl.collapseAllConfigurations()">{{"Collapse all inputs" | i18next}}</a>\n              </li>\n            </ul>\n          </li>\n        </div>\n      </div>\n      \x3c!-- Filter on configuration parameter --\x3e\n      <div class="dropdown select-container-wrapper">\n        <button data-bs-toggle="dropdown" class="dropdown-toggle simple-select max-width-limit ellipseOverflowText">\n          <div data-bs-original-title={{$ctrl.getCurrentConfigParameterName()}} data-bs-placement="left"\n            class="w-100 text-start ellipseOverflowText">\n            {{$ctrl.getCurrentConfigParameterName()}}\n          </div>\n        </button>\n        <ul class="os-select-choices os-select-choices-content os-select-dropdown dropdown-menu" role="menu">\n          <li class="clickable-input max-width-limit" ng-click="$ctrl.currentConfigurationParam = null">\n            <a class="dropdown-item ellipseOverflowText" ng-class="{ selected: $ctrl.currentConfigurationParam == null }" href="#">\n              {{\'All inputs\' | i18next}}\n            </a>\n          </li>\n          <li class="clickable-input max-width-limit" ng-repeat="configParam in $ctrl.allConfigurationParams"\n            ng-click="$ctrl.setCurrentConfigParameter(configParam)" data-bs-original-title={{configParam.getDisplayName()}} data-bs-placement="right">\n            <a class="dropdown-item ellipseOverflowText" ng-class="{ selected: $ctrl.currentConfigurationParam.getParameterId() === configParam.getParameterId() }" href="#">\n              {{configParam.getDisplayName()}}\n            </a>\n          </li>\n        </ul>\n      </div>\n      <div ng-if="$ctrl.enumOptionAndRangeConditionsEnabled" class="d-flex">\n        <label class="os-param-checkbox-label ellipseOverflowText">\n          <span>{{"Flip enum option visibility logic"}}</span>\n        </label>\n        <input type="checkbox" style="margin: 0px 5px;"\n          ng-model="$ctrl.enumOptionConditionAlternateEvaluation" ng-change="$ctrl.updateParameterVisibilitiesForPreview()"/>\n      </div>\n    </div>\n    <div class="os-row os-pin-right os-align-center">\n      <button type="button" class="btn-close" ng-click="$ctrl.onClose()" aria-hidden="true"></button>\n    </div>\n  </div>\n  <div class="modal-body scroll-y p-0">\n    <div class="d-flex w-100 h-100">\n      \x3c!-- Visibilty condition construction section --\x3e\n      <div class="visibility-conditions-section w-75 scroll-y">\n        <div class="config-param-row" ng-if="$ctrl.shouldShowAlwaysVisibleParams()">\n          <div class="config-param-header config-param-old-border w-100">\n            <div class="d-flex align-items-center justify-content-between w-100">\n              <os-svg ng-if="$ctrl.shouldShowCosmeticIconInTopRow()" class="cosmetic-icon ms-0" icon="configuration-exclude-properties"\n                data-bs-original-title="{{\'tooltips:::Excluded from affecting configured properties\' | i18next}}"></os-svg>\n              <div data-bs-placement="top" class="config-param-name d-block w-95"\n                data-bs-original-title="{{$ctrl.currentConfigurationParam ? $ctrl.currentConfigurationParam.getDisplayName() : $ctrl.getNamesForAlwaysVisibleParams()}}">\n                {{$ctrl.currentConfigurationParam ? $ctrl.currentConfigurationParam.getDisplayName() : $ctrl.getNamesForAlwaysVisibleParams()}}\n              </div>\n              <os-svg class="first-param-info-icon" icon="performance-info"\n                data-bs-original-title="{{\'These configuration inputs will always be visible\' | i18next}}"\n                data-bs-placement="right" />\n            </div>\n          </div>\n        </div>\n        <div ng-repeat="configParam in $ctrl.allConfigurationParams" class="config-param-row"\n          ng-if="$ctrl.shouldShowRowForConfigParam(configParam.getParameterId())"\n          data-automation="visibility-configuration"\n          data-id={{configParam.getParameterId()}}\n          data-label={{configParam.getDisplayName()}}\n        >\n          <div class="config-param-header config-param-old-border w-100">\n            <div class="d-flex align-items-center w-80">\n              <div class="compact-table-row-clickable"\n                ng-click="$ctrl.toggleIsExpanded(configParam.getParameterId())">\n                <os-svg class="os-icon-xsmall" icon="{{$ctrl.getIsExpanded(configParam.getParameterId()) ? \'expanded\' : \'collapsed\'}}"/>\n              </div>\n              <os-svg ng-if="configParam.getIsCosmetic()" class="cosmetic-icon" icon="configuration-exclude-properties"\n                data-bs-original-title="{{\'tooltips:::Excluded from affecting configured properties\' | i18next}}"></os-svg>\n              <div class="config-param-name" data-bs-placement="top" data-bs-original-title="{{configParam.getDisplayName()}}">\n                {{configParam.getDisplayName()}}\n              </div>\n              <os-svg class="param-warn-icon" icon="performance-warning"\n                ng-if="$ctrl.showWarningIcon(configParam.getParameterId())"\n                data-bs-original-title="{{$ctrl.getWarningTextForEnumParam(configParam.getParameterId())}}"\n                data-bs-placement="right" />\n            </div>\n            \x3c!-- Add condition button --\x3e\n            <button type="button" class="btn btn-secondary btn-sm small-secondary-btn os-add-condition-btn ellipseOverflowText"\n              ng-if="$ctrl.enumOptionAndRangeConditionsEnabled && configParam.isEnumParameter()"\n              ng-click="$ctrl.addEnumOptionVisibilityConditionToState(configParam.getParameterId(), true, true)"\n              ng-disabled="$ctrl.isReadOnly"\n              data-bs-original-title="{{\'Add a range based visibility condition to a range of options for this configuration input\' | i18next}}"\n              data-bs-placement="bottom">\n              <os-svg icon="add-button"></os-svg>{{\'Add range based enum option range condition\' | i18next}}</button>\n            <button type="button" class="btn btn-secondary btn-sm small-secondary-btn os-add-condition-btn ellipseOverflowText"\n              ng-if="$ctrl.enumOptionAndRangeConditionsEnabled && configParam.isEnumParameter()"\n              ng-click="$ctrl.addEnumOptionVisibilityConditionToState(configParam.getParameterId(), false, true)"\n              ng-disabled="$ctrl.isReadOnly"\n              data-bs-original-title="{{\'Add a range based visibility condition to a list of options for this configuration input\' | i18next}}"\n              data-bs-placement="bottom">\n              <os-svg icon="add-button"></os-svg>{{\'Add range based enum option list condition\' | i18next}}</button>\n            <button type="button" class="btn btn-secondary btn-sm small-secondary-btn os-add-condition-btn ellipseOverflowText"\n              ng-if="$ctrl.enumOptionAndRangeConditionsEnabled && configParam.isEnumParameter()"\n              ng-click="$ctrl.addEnumOptionVisibilityConditionToState(configParam.getParameterId(), true, false)"\n              ng-disabled="$ctrl.isReadOnly"\n              data-bs-original-title="{{\'Add a visibility condition to a range of options for this configuration input\' | i18next}}"\n              data-bs-placement="bottom">\n              <os-svg icon="add-button"></os-svg>{{\'Add enum option range condition\' | i18next}}</button>\n            <button type="button" class="btn btn-secondary btn-sm small-secondary-btn os-add-condition-btn ellipseOverflowText"\n              ng-if="$ctrl.enumOptionAndRangeConditionsEnabled && configParam.isEnumParameter()"\n              ng-click="$ctrl.addEnumOptionVisibilityConditionToState(configParam.getParameterId(), false, false)"\n              ng-disabled="$ctrl.isReadOnly"\n              data-bs-original-title="{{\'Add a visibility condition to a list of options for this configuration input\' | i18next}}"\n              data-bs-placement="bottom">\n              <os-svg icon="add-button"></os-svg>{{\'Add enum option list condition\' | i18next}}</button>\n            <button type="button" class="btn btn-secondary btn-sm small-secondary-btn os-add-condition-btn ellipseOverflowText"\n              ng-if="$ctrl.enumOptionAndRangeConditionsEnabled"\n              ng-click="$ctrl.addVisibilityConditionToState(configParam.getParameterId(), true)"\n              ng-disabled="$ctrl.isReadOnly || !$ctrl.canAddMoreConditions(configParam.getParameterId())"\n              data-bs-original-title="{{\'Add a range based visibility condition to this configuration input\' | i18next}}"\n              data-bs-placement="bottom">\n              <os-svg icon="add-button"></os-svg>{{\'Add range condition\' | i18next}}</button>\n            <button type="button" class="btn btn-secondary btn-sm small-secondary-btn os-add-condition-btn ellipseOverflowText"\n              ng-click="$ctrl.addVisibilityConditionToState(configParam.getParameterId(), false)"\n              ng-disabled="$ctrl.isReadOnly || !$ctrl.canAddMoreConditions(configParam.getParameterId())"\n              data-bs-original-title="{{\'Add a visibility condition to this configuration input\' | i18next}}"\n              data-bs-placement="bottom">\n              <os-svg icon="add-button"></os-svg>{{\'Add condition\' | i18next}}</button>\n          </div>\n\n          <div ng-if="$ctrl.getIsExpanded(configParam.getParameterId())"\n            ng-repeat="condition in $ctrl.getVisiblityConditionsState(configParam.getParameterId())"\n            class="flex-even-spacing mb-2 left-margin"\n            data-automation="visibility-condition-row"\n            data-row={{$index}}\n          >\n            \x3c!-- Section to build a visibility codition --\x3e\n            <visibility-condition-builder class="w-100" condition="condition" config-param="configParam"\n              get-config-params-for-setting-visibility-condition="$ctrl.getConfigParamsForSettingVisibilityCondition(parameterId, conditionIndex)"\n              are-range-conditions-allowed="$ctrl.enumOptionAndRangeConditionsEnabled" is-read-only="$ctrl.isReadOnly" condition-index="$index"\n              on-user-input="$ctrl.processStateIntoVisibilityConditions(updateShowErrorFlag)">\n            </visibility-condition-builder>\n            <button class="os-button os-clear"\n              ng-disabled="$ctrl.isReadOnly"\n              ng-click="$ctrl.removeVisibilityConditionFromState(configParam.getParameterId(), $index)"\n              data-automation="visibility-condition-remove"\n            >\n              <os-svg icon="close-x"></os-svg>\n            </button>\n          </div>\n          \x3c!-- Enum option visibility conditions --\x3e\n          <div ng-if="$ctrl.getIsExpanded(configParam.getParameterId()) && $ctrl.enumOptionAndRangeConditionsEnabled && configParam.isEnumParameter()" class="w-100 bottom-separator mb-2"></div>\n          <div ng-if="$ctrl.getIsExpanded(configParam.getParameterId()) && $ctrl.enumOptionAndRangeConditionsEnabled && configParam.isEnumParameter()"\n            ng-repeat="enumOptionCondition in $ctrl.getEnumOptionVisibilityConditionsState(configParam.getParameterId())"\n            class="flex-even-spacing mb-2 left-margin">\n            \x3c!-- Enum option condition controls a range of options --\x3e\n            <div ng-if="enumOptionCondition.controlledEnumOptionRange" class="d-flex me-2">\n              <div class="dropdown"\n                data-bs-original-title="{{$ctrl.getRangeStartTooltip(configParam, enumOptionCondition)}}">\n                <button class="btn btn-secondary options dropdown-toggle simple-select small-select" ng-disabled="$ctrl.isReadOnly"\n                  data-bs-toggle="dropdown" type="button"\n                  ng-class="{\'invalid-input\': enumOptionCondition.showError, \'valid-input\': !enumOptionCondition.showError}">\n                  <span class="ellipseOverflowText">{{$ctrl.getRangeStartTooltip(configParam, enumOptionCondition)}}</span>\n                </button>\n                <ul class="os-enum-param-select-choices os-select-choices os-select-choices-content os-select-dropdown dropdown-menu" role="menu">\n                  <li class="enum-param-option-row clickable-input" ng-repeat="enumOption in configParam.getEnumOptions()"\n                    ng-click="$ctrl.setControlledRangeStart(configParam.getParameterId(), $parent.$index, enumOption.option)"\n                    data-bs-original-title={{enumOption.optionName}} data-bs-placement="bottom">\n                    <a class="dropdown-item ellipseOverflowText" href="#"\n                      ng-class="{ selected: condition.start === enumOption.option }">\n                      {{enumOption.optionName}}\n                    </a>\n                  </li>\n                </ul>\n              </div>\n              <div class="dropdown"\n                data-bs-original-title="{{$ctrl.getRangeEndTooltip(configParam, enumOptionCondition)}}">\n                <button class="btn btn-secondary options dropdown-toggle simple-select small-select" ng-disabled="$ctrl.isReadOnly"\n                  data-bs-toggle="dropdown" type="button"\n                  ng-class="{\'invalid-input\': enumOptionCondition.showError, \'valid-input\': !enumOptionCondition.showError}">\n                  <span class="ellipseOverflowText">{{$ctrl.getRangeEndTooltip(configParam, enumOptionCondition)}}</span>\n                </button>\n                <ul class="os-enum-param-select-choices os-select-choices os-select-choices-content os-select-dropdown dropdown-menu" role="menu">\n                  <li class="enum-param-option-row clickable-input" ng-repeat="enumOption in configParam.getEnumOptions()"\n                    ng-click="$ctrl.setControlledRangeEnd(configParam.getParameterId(), $parent.$index, enumOption.option)"\n                    data-bs-original-title={{enumOption.optionName}} data-bs-placement="bottom">\n                    <a class="dropdown-item ellipseOverflowText" href="#"\n                      ng-class="{ selected: condition.end === enumOption.option }">\n                      {{enumOption.optionName}}\n                    </a>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            \x3c!-- Enum option condition controls a list of options --\x3e\n            <div ng-if="!enumOptionCondition.controlledEnumOptionRange" class="dropdown" data-bs-original-title="{{$ctrl.getControlledEnumOptionsTooltip(configParam.getParameterId(), enumOptionCondition)}}">\n              <button class="btn btn-secondary options dropdown-toggle me-2 simple-select" ng-disabled="$ctrl.isReadOnly"\n                data-bs-toggle="dropdown" type="button"\n                ng-class="{\'invalid-input\': enumOptionCondition.showError, \'valid-input\': !enumOptionCondition.showError}">\n                <span class="ellipseOverflowText">{{$ctrl.getControlledEnumOptionSelectionButtonText(configParam.getParameterId(), enumOptionCondition)}}</span>\n              </button>\n              <li class="dropdown-menu">\n                <div class="os-col">\n                  <fieldset class="panel-form-group bottom-separator" ng-click="$event.stopPropagation()">\n                    <label class="checkbox form-check">\n                      <input type="checkbox" class="form-check-input" ng-click="$ctrl.toggleSelectionOfAllEnumOptions(enumOptionCondition)"\n                        ng-checked="$ctrl.areAllEnumOptionsSelected(enumOptionCondition)">\n                      {{"Select all" | i18next}}\n                    </label>\n                  </fieldset>\n                  <fieldset class="panel-form-group" ng-click="$event.stopPropagation()">\n                    <label class="checkbox form-check enum-option-in-dropdown max-width-limit ellipseOverflowText clickable-input" data-bs-placement="right"\n                      data-bs-original-title={{enumOption.optionName}} ng-repeat="enumOption in configParam.getEnumOptions()">\n                      <input type="checkbox" class="form-check-input" ng-change="$ctrl.enumOptionSelectionChanged(enumOptionCondition)"\n                        ng-model="enumOptionCondition.controlledEnumOptionToIsSelected[enumOption.option]">\n                      {{enumOption.optionName}}\n                    </label>\n                  </fieldset>\n                </div>\n              </li>\n            </div>\n            <visibility-condition-builder class="w-95" condition="enumOptionCondition.condition" config-param="configParam"\n              get-config-params-for-setting-visibility-condition="$ctrl.getConfigParamsForSettingEnumOptionVisibilityCondition(parameterId, conditionIndex)"\n              are-range-conditions-allowed="$ctrl.enumOptionAndRangeConditionsEnabled" is-read-only="$ctrl.isReadOnly" condition-index="$index"\n              on-user-input="$ctrl.processStateIntoVisibilityConditions(updateShowErrorFlag)" for-enum-option="true">\n            </visibility-condition-builder>\n            <button class="os-button os-clear" ng-disabled="$ctrl.isReadOnly" ng-click="$ctrl.removeEnumOptionVisibilityConditionFromState(configParam.getParameterId(), $index)">\n              <os-svg icon="close-x"></os-svg>\n            </button>\n          </div>\n\n          \x3c!-- Alert shown if no conditions are present --\x3e\n          <div class="alert-container"\n            ng-if="$index > 0 && $ctrl.shouldShowNoConditionsText(configParam.getParameterId())">\n            <div class="alert alert-info">\n              <span>\n                <strong>{{"No conditions created" | i18next}}</strong>\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n      \x3c!-- Preview of the Configuration --\x3e\n      <div class="w-25" data-automation="configuration-param-preview">\n        <div class="visibility-preview-container">\n          <div class="left-panel-header">\n            <span class="ns-subdialog-title">{{ "Configurations" | i18next }}</span>\n          </div>\n          <div class="preview-wrapper">\n            <div>\n              <div ng-repeat="configParam in $ctrl.allConfigurationParams">\n                \x3c!-- Boolean config param --\x3e\n                <div class="config-param-preview-container"\n                  ng-if="configParam.isBooleanParameter() && !$ctrl.shouldHideInPreview(configParam.getParameterId())"\n                  ng-class="{\'disabled-param\': !$ctrl.getIsVisibleInPreview(configParam.getParameterId())}"\n                  data-automation="configuration-param"\n                  data-id={{configParam.getParameterId()}}\n                  data-type="boolean"\n                  data-label={{configParam.getDisplayName()}}\n                  data-row={{$index}}\n                >\n                  <input type="checkbox" style="margin: 0px 5px;"\n                    ng-checked="$ctrl.getPreviewValue(configParam.getParameterId())"\n                    ng-click="$ctrl.booleanParameterChangedForPreview(configParam.getParameterId())"\n                    data-bs-original-title="{{configParam.getDisplayNameAndDefaultValue()}}"\n                    data-bs-placement="bottom"\n                    ng-disabled="!$ctrl.getIsVisibleInPreview(configParam.getParameterId())"/>\n                  <label class="os-param-checkbox-label ellipseOverflowText" ng-click="$ctrl.booleanParameterChangedForPreview(configParam.getParameterId())"\n                    data-bs-original-title="{{configParam.getDisplayNameAndDefaultValue()}}"\n                    data-bs-placement="bottom">\n                    <span>{{configParam.getDisplayName()}}</span>\n                  </label>\n                  <div class="flex-fill"></div>\n                  <div>\n                    <os-svg ng-if="configParam.getIsCosmetic()" class="cosmetic-icon" icon="configuration-exclude-properties"\n                      data-bs-original-title="{{\'tooltips:::Excluded from affecting configured properties\' | i18next}}"></os-svg>\n                  </div>\n                </div>\n                \x3c!-- Quantity config param --\x3e\n                <div class="config-param-preview-container"\n                  ng-if="configParam.isQuantityParameter() && !$ctrl.shouldHideInPreview(configParam.getParameterId())"\n                  ng-class="{\'disabled-param\': !$ctrl.getIsVisibleInPreview(configParam.getParameterId())}"\n                  data-automation="configuration-param"\n                  data-id={{configParam.getParameterId()}}\n                  data-bs-original-title="{{configParam.getDisplayNameAndDefaultValue()}}"\n                  data-type="quantity"\n                  data-label={{configParam.getDisplayName()}}\n                  data-row={{$index}}\n                >\n                  <label class="os-param-label ellipseOverflowText">\n                    <span>{{configParam.getDisplayName()}}</span>\n                  </label>\n                  <input type="text" ng-disabled="!$ctrl.getIsVisibleInPreview(configParam.getParameterId())"\n                    ng-model="$ctrl.idToConfigurationParameterState.get(configParam.getParameterId()).previewData.value"\n                    class="os-param-number dropdown-source os-param-form-item" ng-change="$ctrl.updateParameterVisibilitiesForPreview()"/>\n                  <div>\n                    <os-svg ng-if="configParam.getIsCosmetic()" class="cosmetic-icon" icon="configuration-exclude-properties"\n                      data-bs-original-title="{{\'tooltips:::Excluded from affecting configured properties\' | i18next}}"></os-svg>\n                  </div>\n                </div>\n                \x3c!-- Enum config param --\x3e\n                <div class="config-param-preview-container"\n                  ng-if="configParam.isEnumParameter() && !$ctrl.shouldHideInPreview(configParam.getParameterId())"\n                  ng-class="{\'disabled-param\': !$ctrl.getIsVisibleInPreview(configParam.getParameterId())}"\n                  data-automation="configuration-param"\n                  data-id={{configParam.getParameterId()}}\n                  data-type="enum"\n                  data-label={{configParam.getDisplayName()}}\n                  data-row={{$index}}\n                >\n                  <label class="os-param-label ellipseOverflowText"><span>{{configParam.getDisplayName()}}</span></label>\n                  <div class="dropdown select-container-wrapper enum-param-container" data-bs-placement="bottom"\n                    data-bs-original-title={{configParam.getDisplayN