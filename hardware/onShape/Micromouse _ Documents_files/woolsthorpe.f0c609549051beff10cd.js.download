ument">{{ "Enter a document description:" | i18next}}</span>\n        <span class="version-or-workspace-dialog-label" ng-if="$ctrl.isPublicationDocument">{{ "Enter a publication description:" | i18next}}</span>\n        (<span>{{ ::$ctrl.getDescriptionLimitInstruction() }}</span>)\n      </p>\n      <textarea id="document-description-input"\n        class="form-control"\n        row="5" cols="40"\n        ng-model="$ctrl.documentProperties.description"\n        bt-focus="true"\n        maxlength="{{$ctrl.descriptionLimit}}"></textarea>\n      <label ng-if="!$ctrl.isPublicationDocument">\n        <input\n          type="checkbox"\n          name="notRevisionManaged"\n          ng-model="$ctrl.documentProperties.notRevisionManaged"\n          ng-disabled="!$ctrl.documentProperties.canToggleNotRevisionManaged"\n          data-bs-original-title="{{::$ctrl.getNotRevisionManagedTooltip()}}"\n        >\n        <span class="os-radio-or-checkbox-text">{{\'Not revision managed\' | i18next}}</span>\n      </label>\n      <label ng-if="$ctrl.isPublicationDocument">\n        <input\n          type="checkbox"\n          name="forceExportRules"\n          ng-model="$ctrl.documentProperties.forceExportRules"\n          ng-disabled="!$ctrl.documentProperties.canToggleForceExportRules"\n        >\n        <span class="os-radio-or-checkbox-text">{{\'Force publication owner export rules\' | i18next}}</span>\n      </label>\n    </div>\n    <div class="modal-footer">\n      <button id="document-properties-dialog-submit" class="btn btn-primary" ng-disabled="docProps.$pristine" type="submit">{{ "Update" | i18next}}</button>\n      <button id="document-properties-dialog-cancel" class="btn btn-secondary button-cancel" type="button" ng-click="$ctrl.cancel()">{{ "Cancel" | i18next}}</button>\n    </div>\n  </form>\n</div>\n')}]),e.exports=n},66032:function(e,t,i){var n="/project/web/woolsthorpe/app/partials/documentVersionsAndHistory.html";i(57229).module("ng").run(["$templateCache",function