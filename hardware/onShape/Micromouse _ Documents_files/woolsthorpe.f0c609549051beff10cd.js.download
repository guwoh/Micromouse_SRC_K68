-\x3e\n  <div ng-if="$ctrl.folders.length" class="os-col structure-view" os-no-splitter="true"  os-default-length="32" os-min-length="32" os-fix-length="true">\n    <div class="section-header">\n      <span class="section-toggle" ng-click="$ctrl.toggleStructureFolderSection()">\n        <os-svg\n          class="os-icon-xsmall open-quick-access"\n          alt="{{\'Disclosure triangle.\' | i18next}}"\n          icon="{{!$ctrl.openStructureFolders ? \'collapsed\' : \'expanded\'}}">\n        </os-svg>\n        {{$ctrl.getContainerSectionHeaderText()}}\n      </span>\n    </div>\n  </div>\n\n  <div id="folder-list-view" ng-if="$ctrl.folders.length && $ctrl.openStructureFolders" class="os-col structure-view" os-min-length="75" os-default-length="125" os-remember-length="true">\n    <div class="section-grid-view" ng-class="{\'folder-list-collapse\': !$ctrl.openStructureFolders, \'bg-fade\': $ctrl.loadingFolder}">\n      <div class="os-documents-grid-wrapper" os-document-grid child-class="os-folder-card" triggers="[\'STRUCTURE_FOLDER_LIST\', \'TOGGLE_FOLDER_LIST\', \'OS_SPLITTER_CONTAINER_RESIZE\']">\n        <os-tree-node-card\n          ng-repeat="treeNode in $ctrl.folders"\n          class="os-card os-folder-card advancedSearch"\n          ng-class="{\'selected\': treeNode.selected, \'openable\': $ctrl.itemCanBeOpened(treeNode)}"\n          os-context-menu="$ctrl.getItemListContextMenu(treeNode)"\n          os-context-menu-class="enterprise-context-menu"\n          os-resource-type="{{treeNode.resourceType}}">\n        </os-tree-node-card>\n      </div>\n      <button ng-if="$ctrl.shouldShowLoadMore()" class="btn btn-primary load-more" ng-click="$ctrl.showMoreContainers()">\n        {{ $ctrl.getLoadMoreButtonText() }}\n      </button>\n    </div>\n  </div>\n\n  \x3c!-- Strcture View List --\x3e\n  <div class="structure-view-list os-col" os-min-length="400">\n    <div class="structure-view">\n      <div ng-if="$ctrl.viewMode === $ctrl.viewModes.FLAT" class="section-header justify-content-between os-row">\n        <span class="d-inline-block text-truncate ps-3">{{\'Components at latest revisions\' | i18next}}</span>\n        <div class="add-column-toggle pe-2">\n          <div class="options add-options">\n            <a class="options" data-bs-toggle="dropdown" data-bs-popper-config=\'{"strategy":"fixed"}\' data-bs-auto-close="outside">\n              <os-svg class="os-icon-small" icon="overflow"></os-svg>\n            </a>\n            <ul class="dropdown-menu add-drop-down w-auto">\n              <li ng-repeat="column in $ctrl.availableColumns">\n                <label class="os-row">\n                  <input type="checkbox" ng-click="$ctrl.toggleColumn(column, $event)"\n                    ng-disabled="column.locked" ng-checked="$ctrl.isColumnAdded(column)"/>\n                  <span>{{column.displayName | i18next}}</span>\n                </label>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n\n      <div ng-if="$ctrl.viewMode === $ctrl.viewModes.FLAT" class="structure-view-alert-container">\n        <div ng-if="!$ctrl.loadingList && !$ctrl.loadingListFailed && $ctrl.items.length === 0" class="error-states alert-info position-absolute start-50 translate-middle-x">\n          <osc-zero-state-screen\n            icon="list-view-empty"\n            message="{{$ctrl.getZeroStateMessage()}}"\n            linkurl="{{$ctrl.getZeroStateLinkUrl()}}"\n            linktext="{{$ctrl.getZeroStateLinkText()}}">\n          </osc-zero-state-screen>\n        </div>\n        \x3c!-- If the request fails during pagination, leave the previously loaded items as is and show just the message bubble.\n        If its first load, display the below message in addition to message bubble.  --\x3e\n        <div ng-if="!$ctrl.loadingList && $ctrl.loadingListFailed && $ctrl.items.length === 0" class="error-states alert-info position-absolute start-50 translate-middle-x">\n          <osc-zero-state-screen\n            icon="list-view-empty"\n            message="{{ \'Failed to get product structure data.\' | i18next }}">\n          </osc-zero-state-screen>\n        </div>\n        <div ng-if="$ctrl.loadingList" class="alert alert-info bt-no-model-alert position-absolute start-50 translate-middle-x w-25">\n          <strong>{{"Loading…" | i18next}}</strong>\n        </div>\n      </div>\n\n    <div ng-if="$ctrl.viewMode === $ctrl.viewModes.FLAT" class="os-documents-table disable-user-select os-row os-grow os-item-table structure-view-list">\n      <div id="document-list-scroll-container"\n        class="os-content-scroll-container"\n        os-on-scroll="$ctrl.setItemStoredScrollData(scrollData)"\n        when-scrolled="$ctrl.doScroll()"\n        ng-click="$ctrl.clearItemSelectionsIfNotFromDocument($event)"\n        os-smart-scroller=".os-document-in-list">\n        <table os-data-table="{ freezeCols: 2, scrollToEnd: true, canMoveColumns: true }" dt-move-menu="$ctrl.moveMenu" dt-on-move="onColumnMove" dt-columns="$ctrl.columnHeaders.length" class="structure-view-table os-documents-list full-width" ng-class="{\'dnd-dragging\': isDragging}">\n          <thead>\n            <tr os-data-table-row>\n              <th class="column-thumbnail" os-data-table-column dt-non-resizable/>\n              <th os-context-menu="$ctrl.moveMenu($index, 1)"os-context-menu-class="enterprise-context-menu" ng-repeat="column in $ctrl.columnHeaders"\n              os-data-table-column ng-attr-class="{{column.css}}" ng-class="{\'sort-header\': $ctrl.shouldAllowItemSort(column.name)}" ng-click="$ctrl.changeItemSort(column.id)">\n                {{column.displayName | i18next}}\n                <span ng-if="$ctrl.shouldAllowItemSort(column.name)" class="document-sort-arrow">&nbsp;{{$ctrl.sortItemArrow(column.id)}}</span>\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n          <tr ng-if="!$ctrl.loadingList" class="os-item-row os-document-in-list" ng-hide="item.deleting"\n            ng-class="{\'selected\':item.selected}" ng-dblclick="$ctrl.openDocumentInNewTab(item)"\n            ng-repeat="item in $ctrl.items" os-on-repeat-finish="$ctrl.setItemListState()"\n            data-id="{{::$ctrl.getSelectorIdForSmartScrollItem(item)}}"\n            os-resource-type="{{::item.resourceType}}"\n            os-context-menu="$ctrl.getItemListContextMenu(item)"\n            os-context-menu-class="enterprise-context-menu" os-data-table-row>\n            <td class="os-documents-thumbnail-column" ng-click="$ctrl.toggleItemSelection(item, $event)">\n              <os-thumbnail\n                has-thumbnail="{{::item.hasThumbnail}}"\n                thumbnail-url="{{::item.thumbnailUrl}}"\n                fallback-image="{{::item.fallbackImage}}">\n              </os-thumbnail>\n            </td>\n            <td class="column-name" ng-click="$ctrl.toggleItemSelection(item, $event)">\n              <div class="document-name-area document-name-align os-row document-name-row">\n                <div class="os-document-icon-container add-space-right os-no-shrink">\n                  <svg class="os-svg-icon os-search-icon-list-view">\n                    <use xlink:href="{{::item.typeIcon}}"/>\n                  </svg>\n                </div>\n                <div class="os-search-highlight-name is-not-document os-no-shrink flex-fill ellipseOverflowText list-view-document-name-container">\n                  <a ng-if="::$ctrl.itemCanBeOpened(item)" class="os-document-display-name open-document-link"\n                    data-html="true" ng-href="{{::item.linkState}}" target="_blank">\n                    <span class="list-view-document-name" aria-label="{{\'Name: __itemName__\' | i18next:{itemName: item.name} }}" ng-bind-html="item.itemName"/>\n                  </a>\n                  <div ng-if="::!$ctrl.itemCanBeOpened(item)" class="os-document-display-name">\n                    <span class="list-view-document-name" ng-bind-html="::item.itemName"/>\n                  </div>\n                </div>\n              </div>\n              <div>\n                <span class="os-documents-icon-column">\n                  <span os-document-icon a-document="item" align-bottom/>\n                </span>\n                <os-item-identifier item="item"/>\n              </div>\n            </td>\n            <td ng-click="$ctrl.toggleItemSelection(item, $event)"\n              ng-class="column.css" ng-repeat="column in $ctrl.columnBody">\n              <div class="os-search-highlight-name is-document os-no-shrink"\n                  data-html="true">\n                <span class="no-select">\n                  <span aria-label="item.description" ng-bind-html="$ctrl.getColumnValue(item, column)"/>\n                </span>\n              </div>\n            </td>\n          </tr>\n          \x3c!-- adding an empty row when displaying loading/empty state so table header is still displayed --\x3e\n          <tr ng-if="$ctrl.loadingList || $ctrl.items.length === 0">\n            <td/>\n          </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <product-structure-tree-component\n      ng-if="!$ctrl.isNewDocumentListEnabled && $ctrl.viewMode === $ctrl.viewModes.TREE" [initial-params]="$ctrl.initialParams">\n    </product-structure-tree-component>\n  </div>\n</div>\n')}]),e.exports=n},73212:function(e,t,i){var n="/project/web/ts/publications/publicationDeleteConfirmationDialog.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div>\n  <form ng-submit="ctrl.ok()">\n    <div class="modal-header">\n      <h4 class="modal-title">{{ "Delete __publicationName__?" | i18next:{publicationName: ctrl.publication.name} }}</h4>\n      <button type="button" class="btn-close" ng-click="ctrl.cancel()" aria-hidden="true"></button>\n    </div>\n    <div class="modal-body">\n      {{ "This will permanently delete the publication." | i18next}}\n    </div>\n    <div class="modal-footer">\n      <button class="btn btn-primary" type="submit">{{ "Delete" | i18next}}</button>\n      <button class="btn btn-secondary button-cancel" type="button" ng-click="ctrl.cancel()">{{ "Cancel" | i18next}}</button>\n    </div>\n  </form>\n</div>\n')}]),e.exports=n},79186:function(e,t,i){var n="/project/web/ts/publications/publicationInsertItemDialog.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="select-item-container-inner ns-dialog-frame"\n     ng-controller="PublicationInsertItemDialogController">\n  <div class="select-item-header-bar ns-dialog-header ns-subdialog-header">\n    <div class="ns-drag-area">\n      <span class="select-item-title">{{dialogTitle}}</span>\n    </div>\n    <button type="button" class="btn-close select-item-close" ng-click="closeDialog()"></button>\n  </div>\n\n  <div class="publication-insert-item-dialog-widget-container"></div>\n</div>\n')}]),e.exports=n},82394:function(e,t,i){var n="/project/web/ts/reference-repair/referenceRepair.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="panel-content-pane" oncontextmenu="return false;" ng-controller="ReferenceRepairController as referenceRepairController">\n    <div os-default-length="7%" os-min-length="70" os-max-length="70" os-remember-length="true">\n        <div id="repair-pane-main" >\n            <div ng-show="!referenceRepairController.newStyleHeaderEnabled">\n                <div class="right-pane-header-tabs" os-parameter="referenceRepairController.titleTabParameter"></div>\n                <div class="reference-label text-truncate" style="white-space: nowrap;">\n                    <span id="repair-pane-description">{{\'Viewing\' | i18next}} {{ referenceRepairController.getVersionDescription() }}\n                    </span>\n                </div>\n                <span class="link-right">\n                    <button class = "header-icon"\n                        ng-click="referenceRepairController.goToMoment()"\n      