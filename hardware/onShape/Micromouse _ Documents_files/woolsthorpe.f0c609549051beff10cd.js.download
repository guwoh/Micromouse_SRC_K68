hapeCompatibilityReport.json" link-text="{{ \'Download report\' | i18next}}" download-method="ctrl.getReport()" ng-if="ctrl.isReportReady()"></os-download-link>\n        </div>\n      </div>\n      <div class="os-check-button-container" ng-if="ctrl.allChecksPassed()">\n        <span class="os-check-goto-button"><a class="btn btn-primary" href="/documents">{{ \'Go to Onshape\' | i18next }}</a></span>\n      </div>\n    </div>\n    <div class="os-filler"></div>\n  </div>\n  <canvas id="testCanvas" data-view-shown="unknown"></canvas>\n</div>\n')}]),e.exports=n},52730:function(e,t,i){var n="/project/web/woolsthorpe/app/partials/confirmDeleteDialog.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="delete-documents-container">\n    <div class="modal-header">\n        <h4 class="modal-title">{{ctrl.messageTitle}}</h4>\n        <button type="button" class="btn-close" aria-hidden="true" ng-click="$dismiss()"></button>\n    </div>\n    <div class="modal-body">\n        <strong>\n            <span class="info-message-margin">{{ ctrl.infoMessageForDeletableItems }}</span>\n        </strong>\n        <a class="btn-link" ng-click="ctrl.toggleShowDetailsOfDeletableItems()" ng-if="!ctrl.isInTrash">\n            <span ng-if="ctrl.hideDetailsOfDeletableItems">{{\'Show details\' |i18next}}</span>\n            <span ng-if="!ctrl.hideDetailsOfDeletableItems">{{\'Hide details\' |i18next}}</span>\n        </a>\n    </div>\n    <div ng-hide="ctrl.hideDetailsOfDeletableItems && !ctrl.isInTrash" class="overflow-documents overflow-documents-border">\n        <div ng-repeat="tempDocument in ctrl.deletableDocuments" class="os-row temp-document-rows">\n            <span ng-if="tempDocument.typeIcon">\n                <svg class="os-svg-icon">\n                <use xlink:href="{{tempDocument.typeIcon}}"></use>\n                </svg>\n            </span>\n            <span ng-if="!tempDocument.typeIcon">\n                <os-svg icon="document"></os-svg>\n        