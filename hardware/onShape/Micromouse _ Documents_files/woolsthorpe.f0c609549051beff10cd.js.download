-row os-document-in-list"\n        ng-if="showArchiveClasses"\n        ng-class="{\'selected\': document.selected}"\n        ng-repeat="document in documentList.lazyRenderItems.classrooms | filter : {\'state\': classroomState.ARCHIVED}"\n        ng-dblclick="openClassroom(document.id)"\n        os-on-repeat-finish="setDocumentListState()"\n        data-id="{{::getSelectorIdForSmartScroll(document)}}"\n        os-resource-type="{{::document.resourceType}}"\n        os-context-menu="getClassroomContextMenu(document)"\n        os-context-menu-class="enterprise-context-menu"\n        os-classroom-tree-node-list-row>\n      </tr>\n      \x3c!-- document list section when not showing search results / quick view and everything when showing them --\x3e\n      <tr class="document-list-header" ng-if="showDocumentsHeader()">\n        <td>{{"Documents" | i18next}}</td>\n        <td></td>\n        <td></td>\n        <td></td>\n        <td ng-if="!isEnterprise"></td>\n        <td class="os-item-actions-icon"></td>\n      </tr>\n      <tr class="os-item-row os-document-in-list" ng-hide="document.deleting"\n        ng-class="{\'selected\':document.selected}" ng-dblclick="recordOpenDocumentClick(document); openDocument(document)"\n        ng-repeat="document in documentList.lazyRenderItems.documents" os-on-repeat-finish="setDocumentListState()"\n        data-id="{{::getSelectorIdForSmartScroll(document)}}"\n        os-resource-type="{{::document.resourceType}}"\n        os-context-menu="getDocumentListContextMenu(document)"\n        os-context-menu-class="enterprise-context-menu"\n        dnd-draggable="document" dnd-dragstart="onItemDragStart(event)" dnd-dragend="onItemsDragEnd(event)" dnd-disable-if="!canShowInThumbnail(document) || !!nameDialog">\n        <td class="os-documents-thumbnail-column document-item" ng-click="toggleSelection(document, $event)">\n          <os-thumbnail\n            has-thumbnail={{::document.hasThumbnail}}\n            document-id="{{::document.id}}"\n            workspace-id="{{::document.workspaceIdForThumbnail}}"\n            version-id="{{::document.versionIdForThumbnail}}"\n            element-id="{{::calculateElementIdForThumbnail(document)}}"\n            part-id="{{::document.partIdForThumbnail}}"\n            ideal-height="170"\n            ideal-width="300"\n            document-thumbnail-stamp="{{::document.thumbnailStamp}}"\n            fallback-image="{{::document.defaultImageForSearchResult}}">\n          </os-thumbnail>\n        </td>\n        <td class="os-document-name document-item" ng-click="toggleSelection(document, $event)">\n          <div class="document-name-area document-name-align os-row document-name-row">\n            <div ng-if="::isOnSearchFilterOnly()" class="os-document-icon-container add-space-right os-no-shrink">\n              <os-svg icon="{{::document.iconName}}"></os-svg>\n            </div>\n            <div class="os-search-highlight-name is-document os-no-shrink" ng-if="::(documentCanBeOpened(document) && (isResultADocument(document) || isResultAPublication(document)))"\n              class="open-document-link"\n              data-bs-custom-class="hide-outside-scroll-area"\n              data-bs-html="true"\n              data-bs-original-title="{{getDocumentOpenTooltip(document)}}">\n              <a class="os-document-display-name no-select"\n                ui-sref="{{::document.linkState}}" ng-click="recordOpenDocumentClick(document)">\n                <span aria-label="{{\'Document name: __documentName__\' | i18next:{documentName: document.resultHighlight} }}" ng-bind-html="document.resultHighlight"></span>\n              </a>\n            </div>\n            <div class="os-search-highlight-name is-not-document os-no-shrink" ng-if="::(documentCanBeOpened(document) && document.resourceType === \'project\')"\n            class="open-document-link">\n              <a class="os-document-display-name no-select" ng-href="{{::document.linkState}}"\n                data-bs-custom-class="hide-outside-scroll-area"\n                data-bs-html="true"\n                ng-click="changeTreeNode(document, $event)"\n                data-bs-original-title=\'{{getDocumentOpenTooltip(document)}}\'\n              >\n                <span aria-label="{{\'Project name: __documentName__\' | i18next:{documentName: document.resultHighlight} }}"\n                  ng-bind-html="document.resultHighlight"></span>\n              </a>\n            </div>\n            <div class="os-search-highlight-name is-not-document os-no-shrink" ng-if="::(documentCanBeOpened(document) && !isResultADocument(document) && !isResultAPublication(document) && document.resourceType !== \'project\')"\n              class="open-document-link"\n              data-bs-custom-class="hide-outside-scroll-area"\n              data-bs-html="true"\n              data-bs-original-title=\'{{getDocumentOpenTooltip(document)}}\'>\n              <a class="os-document-display-name" ng-click="recordOpenDocumentClick(document)"\n                ui-sref="{{::document.linkState}}">\n                <span aria-label="{{\'Document name: __documentName__\' | i18next:{documentName: document.resultHighlight} }}" ng-bind-html="document.resultHighlight"></span>\n              </a>\n            </div>\n            <div class="os-search-highlight-name is-not-document os-no-shrink">\n              <div class="os-document-display-name" ng-if="::!documentCanBeOpened(document)"\n                data-bs-custom-class="hide-outside-scroll-area"\n                data-bs-original-title=\'{{::getDocumentOpenTooltip(document)}}\'><span ng-bind-html="::document.resultHighlight"></span>\n              </div>\n            </div>\n          </div>\n          <div>\n            <span class="os-documents-icon-column advancedSearch document-item" ng-click="toggleSelection(document, $event)">\n              <span os-document-icon a-document="document" is-publication="isResultAPublication(document)" align-bottom></span>\n    