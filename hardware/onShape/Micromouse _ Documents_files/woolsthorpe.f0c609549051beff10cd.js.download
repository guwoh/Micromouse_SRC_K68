icationSection && $ctrl.canShowApplicationsTab()">\n      <span>{{ "Application" | i18next }}</span>\n    </div>\n    <div class="os-tab"\n         ng-class="{\'os-tab--active\': $ctrl.isTabSelected($ctrl.shareTypes.LINK)}"\n         ng-click="$ctrl.selectTab($ctrl.shareTypes.LINK)"\n         ng-if="!$ctrl.shareOptions.hideLinkSharingSection && $ctrl.canShowLinkTab()">\n      <span>{{ "Link sharing" | i18next }}</span>\n    </div>\n  </div>\n\n  <div class="add-section-body"\n       ng-show="$ctrl.isTabSelected($ctrl.shareTypes.INDIVIDUAL, $ctrl.shareTypes.TEAM, $ctrl.shareTypes.COMPANY) ||\n       ($ctrl.isTabSelected($ctrl.shareTypes.GUESTS) && $ctrl.canInviteGuests() && $ctrl.availableSeats > 0) ||\n       ($ctrl.isTabSelected($ctrl.shareTypes.CONNECTIONS) && $ctrl.canInviteConnectionUsers())">\n    <div class="share-results-label"\n         ng-if="$ctrl.shareResults !== \'\'">\n      {{ $ctrl.shareResults }}\n    </div>\n    <div class="section-row" ng-show="$ctrl.isTabSelected($ctrl.shareTypes.CONNECTIONS)">\n      <div class="os-grow os-connections-container">\n        <select class="shareWithOrganization form-control"\n                ng-model="$ctrl.selectedConnection"\n                ng-options="connection.name for connection in $ctrl.companyConnections">\n        </select>\n      </div>\n    </div>\n    <div class="section-row">\n    <span ng-if="$ctrl.isTabSelected($ctrl.shareTypes.INDIVIDUAL)"\n          class="os-grow add-email-suggestions">\n      <os-suggestions class="add-email"\n                      get-suggestions="$ctrl.findFriends(query)"\n                      is-valid-new-suggestion="$ctrl.isNewEmailValid(query)"\n                      os-input-tokens\n                      on-suggestion-selected="TokenController.addToken(suggestion)"\n                      require-input-focus="true"\n                      placeholder="{{ $ctrl.suggestionPlaceholder }}">\n      </os-suggestions>\n    </span>\n    <span ng-show="$ctrl.isTabSelected($ctrl.shareTypes.GUESTS)"\n          class="os-grow">\n      <div class="os-guests-container">\n        <input class="form-control" ng-model="$ctrl.guestUserEmails" ng-change="$ctrl.onGuestUserEmailChanged()" ng-focus="$ctrl.onGuestUserEmailChanged()" autocomplete="off" placeholder="{{\'Enter emails\' | i18next}}" type="text"/>\n      </div>\n      <p class="helper-text">{{ "Add multiple users by entering emails separated by comma or space" | i18next}}</p>\n    </span>\n\n    <span ng-if="$ctrl.isTabSelected($ctrl.shareTypes.CONNECTIONS)"\n          class="os-grow add-email-suggestions">\n          <os-suggestions class="add-email"\n            get-suggestions="$ctrl.onConnectionChange(query)"\n            os-input-tokens\n            on-suggestion-selected="TokenController.addToken(suggestion)"\n            placeholder="{{ $ctrl.suggestionPlaceholder }}">\n          </os-suggestions>\n    </span>\n\n    <span ng-show="$ctrl.isTabSelected($ctrl.shareTypes.COMPANY)"\n            class="os-grow os-organization-container">\n      <select class="shareWithOrganization company-select-dropdown form-control"\n              ng-model="$ctrl.selectedCompany"\n              ng-options="company.name for company in $ctrl.memberCompanies">\n      </select>\n    </span>\n\n      <span ng-if="$ctrl.isTabSelected($ctrl.shareTypes.TEAM)"\n            class="os-grow">\n        <os-suggestions class="add-team"\n          get-suggestions="$ctrl.findTeams(query)"\n          is-valid-new-suggestion="false"\n          os-input-tokens\n          on-suggestion-selected="TokenController.addToken(suggestion)"\n          require-input-focus="true"\n          placeholder="{{ \'Search names\' | i18next }}">\n        </os-suggestions>\n      </span>\n\n      <select class="os-permission form-control"\n              ng-model="$ctrl.newShareACL.newMajorPermission"\n              ng-change="$ctrl.newShareACL.changePermission()"\n              ng-options="permission as (permission.prettyName | i18next) for permission in $ctrl.newShareACL.availablePermissions track by permission.permission">\n      </select>\n      <input ng-if="!$ctrl.currentUserDetails.isOwner  || $ctrl.newShareACL.newMajorPermission.permission !== \'OWNER\'"\n             ng-click="$ctrl.share($ctrl.sharedDocument)"\n             class="btn btn-primary os-share-btn"\n             type="button" value="{{\'Share\' | i18next}}"\n             ng-disabled="$ctrl.shouldDisableShareButton()" />\n    </div>\n\n    <div class="section-row minor-permissions"\n         ng-if="$ctrl.newShareACL.newMajorPermission.permission !== \'OWNER\'">\n      <label ng-repeat="minorPermission in $ctrl.newShareACL.newMinorPermissions"\n             ng-class="{\'disabled\': !minorPermission.editable}"\n             class="os-row os-align-center os-minor-permission"\n             ng-if="$ctrl.canShowMinorPermission(minorPermission)">\n        <input type="checkbox"\n               data-permission="{{minorPermission.permission}}"\n               ng-change="$ctrl.newShareACL.onMinorPermissionChanged(minorPermission)"\n               ng-disabled="!minorPermission.editable"\n               ng-model="minorPermission.isSelected" />\n        {{ minorPermission.prettyName | i18next }}\n      </label>\n    </div>\n\n    <div class="section-row viewer-help-message"\n         ng-if="!$ctrl.shareOptions.hideViewOnlyToolbarMessage && $ctrl.canShowCollaborativeViewerMessage()">\n      <span ng-i18next="[html:i18next] Users without edit permission will see the <a href=\'{{$ctrl.getCollaborativeViewerHelpHref()}}\' data-bs-original-title=\'Open documentation in new tab\' target=\'_blank\'>View only toolbar</a> by default."></span>\n    </div>\n    <div class="section-row limit-permissions-message" ng-if="$ctrl.newShareACL.newMajorPermission.permission !== \'OWNER\' && !$ctrl.isTabSelected($ctrl.shareTypes.GUESTS)">\n      <span>\n        <span ng-if="!$ctrl.isPublication">{{ "Limited permissions reduce the risk of 3rd parties copying or exporting your documents." | i18next}}</span>\n        <span ng-if="$ctrl.isPublication">{{ "Limited permissions reduce the risk of 3rd parties copying or exporting your publications." | i18next}}</span>\n        <a ng-if="!$ctrl.shareOptions.hideLearnAboutSecurityMessage"\n           href=\'https://www.onshape.com/en/features/security\'\n           target=\'_blank\'>{{ "Learn more about security." | i18next}}</a>\n      </span>\n    </div>\n    <div class="section-row invite-guests-message" ng-if="$ctrl.isTabSelected($ctrl.shareTypes.GUESTS)">\n      <span>{{"Inviting a guest will add them to your enterprise. Guests have access only to data shared directly with them." | i18next}}</span>\n    </div>\n    <div class="section-row personal-message-area" ng-if="!$ctrl.isTabSelected(\'everyone\') && $ctrl.canShowPersonalMessageCheckbox()">\n      <label class="control-label smaller-label who-has-access os-row os-align-center">\n        <input type="checkbox" ng-model="$ctrl.addPersonalMessage" ng-click="$ctrl.validatePersonalMessageLimit()"/>\n        {{ "Include a personal message" | i18next}}\n        <span class="user-input-message-limit-error text-danger" ng-show="$ctrl.addPersonalMessage" ng-hide="$ctrl.isPersonalMessageLimitValid">\n          {{ $ctrl.errorMessage }}\n        </span>\n      </label>\n    </div>\n    <div class="section-row personal-message-area message-area-counter"\n         ng-show="$ctrl.addPersonalMessage && !$ctrl.isTabSelected(\'everyone\')">\n      <textarea class="form-control custom-message-input"\n                type="text"\n                maxlength="$ctrl.staticMaxPersonalMessageLimit"\n                ng-model="$ctrl.personalMessage"\n                ng-change="$ctrl.validatePersonalMessageLimit()"\n                placeholder="{{\'Optional: include a personal message\' | i18next}}"\n                ng-class="{\'error-border\': $ctrl.errorMessage}">\n      </textarea>\n      <div class="input-message-length-counter">\n        {{ $ctrl.personalMessage.length +\' / \'+ $ctrl.staticMaxPersonalMessageLimit }}\n      </div>\n    </div>\n  </div>\n\n  <div class="add-section-body" ng-if="$ctrl.isTabSelected($ctrl.shareTypes.GUESTS) && !$ctrl.canInviteGuests()">\n    <div class="invite-guests-not-allowed">{{"You do not have permission to share data with guests. Contact your administrator if you need to share data with people outside your enterprise." | i18next}}</div>\n  </div>\n  <div class="add-section-body" ng-if="$ctrl.isTabSelected($ctrl.shareTypes.GUESTS) && $ctrl.canInviteGuests() && $ctrl.availableSeats < 1">\n    <div class="invite-guests-not-allowed">{{"No subscriptions available to invite guests. Contact your administrator if you need to share data with people outside your enterprise." | i18next}}</div>\n  </div>\n\n  <div class="add-section-body" ng-if="$ctrl.isTabSelected($ctrl.shareTypes.PUBLIC)">\n    <div class="share-results-label" ng-if="$ctrl.shareResults !== \'\'">\n      {{ $ctrl.shareResults }}\n    </div>\n    <div class="share-make-public-section">\n      <div class="share-public-warning-container alert alert-warning">\n        <os-svg icon="warning-overlay"></os-svg>\n        <span class="os-share-public-warning">\n          {{"Any Onshape user can view and copy this document." | i18next}}\n        </span>\n      </div>\n\n      <input ng-click="$ctrl.togglePublic(true)"\n             class="btn btn-primary os-share-btn os-public-btn"\n             type="button"\n             value="{{\'Make public\' | i18next}}"\n      />\n    </div>\n    <div class="section-row minor-permissions">\n      <label class="disabled os-minor-permission">\n        <input type="checkbox" disabled checked class="os-minor-permission" />\n        {{ "Copy" | i18next }}\n      </label>\n      <label class="disabled os-minor-permission">\n        <input type="checkbox" disabled checked class="os-minor-permission" />\n        {{ "Link document" | i18next }}\n      </label>\n      <label class="disabled os-minor-permission">\n        <input type="checkbox" disabled checked class="os-minor-permission" />\n        {{ "Export" | i18next }}\n      </label>\n    </div>\n  </div>\n\n  <div class="add-section-body" ng-if="$ctrl.isTabSelected($ctrl.shareTypes.APPLICATION)">\n    <div class="share-results-label" ng-if="$ctrl.shareResults !== \'\'">\n      {{ $ctrl.shareResults }}\n    </div>\n    <div class="section-row" ng-if="$ctrl.availableApplications === null">\n      <span class="os-share-public-info">{{"Loading applications." | i18next}}</span>\n    </div>\n    <div class="section-row" ng-if="$ctrl.availableApplications !== null">\n      <select class="os-applications share-dropdown form-control os-grow" ng-model="$ctrl.selectedApplication">\n        <option ng-repeat="app in $ctrl.availableApplications" value="{{app.id}}">\n          {{app.name}}\n        </option>\n      </select>\n      <span class="os-share-public-info os-no-shrink">{{"Can access this document." | i18next}}</span>\n      <input ng-click="$ctrl.share($ctrl.sharedDocument)"\n             ng-disabled="!$ctrl.selectedApplication"\n             class="btn btn-primary os-share-btn os-public-btn"\n             type="button"\n             value="{{\'Allow\' | i18next}}"\n      />\n    </div>\n  </div>\n\n  <div class="add-section-body" ng-if="$ctrl.isTabSelected($ctrl.shareTypes.LINK)">\n    <div class="share-results-label"\n         ng-if="$ctrl.shareResults !== \'\'"\n         ng-class="{\'anonymous-link\': $ctrl.isCopyCompleted}">\n      {{ $ctrl.shareResults }}\n    </div>\n    <div class="section-row" ng-if="!$ctrl.sharedDocument.anonymousAccessAllowed">\n      <span class="os-share-public-warning">\n        <span ng-if="!$ctrl.isPublication">{{"Turn on link sharing to allow anyone with the link to view this document." | i18next}}</span>\n        <span ng-if="$ctrl.isPublication">{{"Turn on link sharing to allow anyone with the link to view this publication." | i18next}}</span>\n      </span>\n      <input ng-cli