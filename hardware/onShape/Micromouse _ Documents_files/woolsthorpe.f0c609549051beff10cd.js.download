nes"></os-svg>\n          </button>\n          <button class="os-button os-clear document-filter-button" id="showAutoVersionsToggle"\n            ng-class="{\'os-active\': ctrl.showAutoVersions}"\n            ng-click="toggleIncludeAutoVersionsAndFetchVersionGraph()"\n            ng-disabled="ctrl.isFilterHistoryMode || ctrl.doingGraphItemQuery || !showContent"\n            data-bs-original-title="{{getShowHideAutoVersionsTooltip()}}"\n            data-bs-placement="bottom">\n              <os-svg class="os-svg-icon" icon="auto-version"></os-svg>\n          </button>\n        </div>\n      </div>\n      <div ng-show="showContent && !ctrl.isFilterHistoryMode" os-versions-and-history-graph class="os-version-graph" width="{{svgContainerWidth}}px"\n           oncontextmenu="return false;"\n           ng-class="{\'show-horizontal-scroll\': svgWidth > svgContainerWidth}"\n           style="max-width:{{svgContainerWidth}}px;">\n      </div>\n      <div ng-show="!showContent && insideDocumentDetailPane && !ctrl.isFilterHistoryMode" class="os-version-graph-spinner">\n        <div class="os-spinner-spinning os-spinner-medium"></div>\n      </div>\n      <div ng-show="showContent"\n           class="versions-history-table-container"\n           ng-class="{\'has-chain-update-version\': hasChainUpdateVersion()}"\n      >\n        \x3c!-- Header --\x3e\n        <div class="os-flex-table-header">\n          <div class="os-flex-col os-item-workspace-or-version-graph" style="flex: 0 0 {{svgContainerWidth}}px; -webkit-flex: 0 0 {{svgContainerWidth}}px; z-index:2000;" ng-if="!ctrl.isFilterHistoryMode">\n            <span class="left-right-arrow left-arrow" ng-show="svgWidth > svgContainerWidth" ng-click="scrollVersionGraphToLeftEdge()">\n              <img ng-src="/images/arrow-left.svg"/>\n            </span>\n            <span class="left-right-arrow right-arrow" ng-show="svgWidth > svgContainerWidth" ng-click="scrollVersionGraphToRightEdge()">\n              <img ng-src="/images/arrow-right.svg"/>\n            </span>\n          </div>\n          <div class="os-flex-col os-item-auto-version" ng-if="!ctrl.isFilterHistoryMode"></div>\n          <div class="os-flex-col os-item-workspace-or-version-name" ng-if="!ctrl.isFilterHistoryMode">\n            <span>{{ "Name" | i18next}}</span></div>\n          <div class="os-flex-col os-item-workspace-or-version-description"\n               ng-class="{\'history-search-results-header\': ctrl.isFilterHistoryMode}"\n               ng-if="!insideDocumentDetailPane || ctrl.isFilterHistoryMode">\n            <span>{{ "Description" | i18next}}</span>\n          </div>\n          <div class="os-flex-col os-item-modified-by" ng-show="!ctrl.isFilterHistoryMode">\n            <span>{{ "Modified" | i18next}}</span></div>\n          <div class="os-flex-col os-item-modified-date"\n               ng-class="{\'history-search-results-header\': ctrl.isFilterHistoryMode}"\n               ng-if="!insideDocumentDetailPane || ctrl.isFilterHistoryMode">\n            <span>{{ "Modified by" | i18next}}</span>\n          </div>\n          <div class="os-flex-col os-item-workspace-or-version-actions" ng-if="!insideDocumentDetailPane"></div>\n        </div>\n\n        \x3c!-- Table body --\x3e\n        <div class="versions-history-table-body">\n          <div ng-repeat="graphItem in ctrl.getDisplayedGraphItems()" ng-class="{selected: graphItem.isSelected(),\n                      \'click-disabled\': isLoadingMoment,\n                      \'compare-target\': graphItem.isCompareTarget(),\n                      \'separator\': graphItem.isSeparator(),\n                      \'change\': graphItem.isChange() || graphItem.isMoreFilteredRecords(),\n                      \'branch-point\': graphItem.isBranchPoint(),\n                      \'collapsed-changes\': graphItem.isCollapsedChanges(),\n                      \'no-filter-results\': graphItem.isNoFilterResults(),\n                      \'history-search-result\': ctrl.isFilterHistoryMode,\n                      \'nonloaded-changes\': graphItem.isNonloadedChanges()}"\n               class="os-flex-table-row"\n               ng-mouseover="setChangeHovered(graphItem, true)"\n               ng-mouseleave="setChangeHovered(graphItem, false)"\n               os-context-menu="getActionMenu(graphItem)"\n               os-context-menu-close-event="COLLAPSE_FLYOUT"\n               data-bs-html="true"\n               data-bs-original-title="{{getShortTooltip(graphItem)}}"\n               data-bs-expanded-content="{{graphItem.getExpandedTooltip()}}"\n               data-bs-placement="{{insideDocumentDetailPane ? \'left\' : \'right\'}}"\n               tooltip-expand-delay="0">\n            <div class="os-flex-col os-item-workspace-or-version-graph"\n                 ng-if = "!ctrl.isFilterHistoryMode"\n                 style="flex: 0 0 {{getSvgContainerWidth(graphItem)}}px; -webkit-flex: 0 0 {{getSvgContainerWidth(graphItem)}}px"\n                 ng-click="setWorkspaceOrVersionSelected(graphItem)"></div>\n            <div class="os-flex-col os-item-auto-version"\n                 ng-if="graphItem.isChainUpdateVersion()"\n                 ng-click="setWorkspaceOrVersionSelected(graphItem)">\n              <os-svg icon="auto-version"/>\n            </div>\n            \x3c!-- Name --\x3e\n            <div ng-if="graphItem.isWorkspace()"\n                 class="os-flex-col os-item-workspace-or-version-name"\n                 ng-click="setWorkspaceOrVersionSelected(graphItem)">\n              <span class="workspace-name workspace-or-version-name {{graphItem.getBranchColorClass()}}">\n                <span ng-if="graphItem.isLocked()">\n                  <os-svg icon="lock-icon_static" class="branch-lock-icon"></os-svg>\n                </span>\n                {{graphItem.name}}\n              </span><br>\n              <span class="change-details"\n                    ng-click="toggleWorkspaceOrVersionExpanded($event, graphItem)">\n                <os-svg\n                  ng-if="graphItem.hasAssociatedChanges()"\n                  class="os-icon-xsmall"\n                  icon="{{graphItem.getMicroversionDetailsIcon()}}">\n                </os-svg>\n                <span ng-class="{\'n-changes\': graphItem.hasAssociatedChanges()}">{{graphItem.getMicroversionDetailsDescription()}}</span>\n              </span>\n            </div>\n            <div ng-if="graphItem.isVersion()"\n                 class="os-flex-col os-item-workspace-or-version-name"\n                 ng-click="setWorkspaceOrVersionSelected(graphItem)">\n              <span class="version-name workspace-or-version-name">{{graphItem.name}}</span>\n              <br>\n              <span ng-if="graphItem.parent"\n                    class="change-details"\n                    ng-click="toggleWorkspaceOrVersionExpanded($event, graphItem)">\n                  <os-svg\n                    ng-if="graphItem.hasAssociatedChanges()"\n                    class="os-icon-xsmall"\n                    icon="{{graphItem.getMicroversionDetailsIcon()}}">\n                  </os-svg>\n                <span ng-class="{\'n-changes\': graphItem.hasAssociatedChanges()}">{{graphItem.getMicroversionDetailsDescription()}}</span>\n              </span>\n            </div>\n            <div ng-if="graphItem.isMergeMicroVersion()" class="os-flex-col os-item-workspace-or-version-name"\n              ng-click="setWorkspaceOrVersionSelected(graphItem)">\n              <span class="version-name">{{graphItem.name}}</span>\n              <br>\n              <span ng-if="graphItem.parent" class="change-details"\n                ng-click="toggleWorkspaceOrVersionExpanded($event, graphItem)">\n                <os-svg\n                  ng-if="graphItem.hasAssociatedChanges()"\n                  class="os-icon-xsmall changes-expanded-toggle"\n                  icon="{{graphItem.getMicroversionDetailsIcon()}}">\n                </os-svg>\n                <span\n                  ng-class="{\'n-changes\': graphItem.hasAssociatedChanges(), \'enable-when-disabled\': isInCompareSetupMode && oldCompareBaseSelected && graphItem.isCompareTarget()}">\n                  {{graphItem.getMicroversionDetailsDescription()}}\n                </span>\n              </span>\n            </div>\n            <div ng-if="graphItem.isChange()"\n                 class="os-flex-col os-item-workspace-or-version-description"\n                 ng-click="setChangeSelected(graphItem)">\n              <span class="change-name">{{graphItem.description_}}</span>\n            </div>\n            <div ng-if="graphItem.isBranchPoint()"\n                 class="os-flex-col os-item-workspace-or-version-description">\n              <span class="branch-point-name">{{graphItem.getBranchedFromDescription()}}</span>\n              <br>\n              <span class="underline-link" ng-click="showFullActiveBranch()">{{graphItem.getShowFullHistoryText()}}</span>\n            </div>\n            <div ng-if="graphItem.isCollapsedChanges()"\n                 class="os-flex-col separator-ellipsis"\n                 ng-click="setChangesExpanded(graphItem.changeIds)">\n              <span>{{"Show changes…" | i18next}}</span></div>\n            <div ng-if="graphItem.isNonloadedChanges()"\n                   class="os-flex-col separator-ellipsis"\n                   ng-click="showMoreChanges(graphItem)">\n                <span>{{"Show more changes…" | i18next}}</span></div>\n\n            <div ng-if="ctrl.isFilterHistoryMode && graphItem.isMoreFilteredRecords()"\n                 class="os-flex-col"\n                 ng-click="ctrl.loadMoreFilteredRecords()">\n              <span>{{"Load more changes…" | i18next}}</span>\n            </div>\n\n            <div ng-if="ctrl.isFilterHistoryMode && graphItem.isNoFilterResults()"\n                 class="os-flex-col ns-select-item-dialog-item-empty">\n              <span>{{"No changes found" | i18next}}</span>\n            </div>\n\n            \x3c!-- Description --\x3e\n            <div ng-if="graphItem.isWorkspaceOrVersion() && !insideDocumentDetailPane"\n                 class="os-flex-col os-item-description"\n                 ng-click="setWorkspaceOrVersionSelected(graphItem)">\n              <span>{{graphItem.description}}</span></div>\n            <div ng-if="graphItem.isMergeMicroVersion() && !insideDocumentDetailPane"\n                 class="os-flex-col os-item-description"\n                 ng-click="setWorkspaceOrVersionSelected(graphItem)">\n            </div>\n            <div ng-if="graphItem.isChange() && !ctrl.isFilterHistoryMode && !insideDocumentDetailPane"\n                 class="os-flex-col os-item-description"\n                 ng-click="setChangeSelected(graphItem)"></div>\n            <div ng-if="graphItem.isBranchPoint() && !insideDocumentDetailPane && !ctrl.isFilterHistoryMode"\n                 class="os-flex-col os-item-modified-by">\n              <span>{{graphItem.parentVersion.description}}</span></div>\n\n            \x3c!-- Modified date --\x3e\n            <div ng-if="graphItem.isWorkspace()"\n                 class="os-flex-col os-item-modified-date"\n                 ng-click="setWorkspaceOrVersionSelected(graphItem)">\n                <div class="os-item-modified-by-content" ng-if="insideDocumentDetailPane">\n                  <os-svg\n                    ng-if="graphItem.showOnshapeSupportCue()"\n                    class="onshape-collaborator-icon"\n                    icon="onshape-logo-collaborator">\n                  </os-svg>\n                  <span>{{graphItem.lastModifier.name}}</span>\n                </div>\n                <div><span>{{graphItem.modifiedAt | prettyDate}}</span></div>\n            </div>\n            <div ng-if="graphItem.isVersion()"\n                 class="os-flex-col os-item-modified-date"\n                 ng-click="setWorkspaceOrVersionSelected(graphItem)">\n                <div class="os-item-modified-by-content" ng-if="insideDocumentDetailPane">\n  