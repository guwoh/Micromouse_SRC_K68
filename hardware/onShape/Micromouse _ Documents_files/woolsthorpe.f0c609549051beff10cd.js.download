ption.optionName}} ng-repeat="enumOption in $ctrl.configParam.getEnumOptions()">\n                <input type="checkbox" class="form-check-input" ng-change="$ctrl.enumOptionSelectionChanged()"\n                  ng-model="statement.controlledEnumOptionToIsSelected[enumOption.option]">\n                {{enumOption.optionName}}\n              </label>\n            </fieldset>\n          </div>\n        </li>\n      </div>\n      \x3c!-- Select controlled enum option range --\x3e\n      <div ng-if="statement.controlledEntity == $ctrl.ControlledEntities.OPTION_RANGE" class="d-flex">\n        <div class="dropdown mx-2"\n          data-bs-original-title="{{$ctrl.getRangeStartTooltip()}}">\n          <button class="btn btn-secondary options dropdown-toggle simple-select" ng-disabled="$ctrl.isReadOnly"\n            data-bs-toggle="dropdown" type="button" ng-init="rangeStartOpened = false" ng-blur="rangeStartOpened = true"\n            ng-class="{\'invalid-input\': rangeStartOpened && statement.showError, \'valid-input\': !rangeStartOpened || !statement.showError}">\n            <span class="ellipseOverflowText">{{$ctrl.getRangeStartButtonText()}}</span>\n          </button>\n          <ul class="os-enum-param-select-choices os-select-choices os-select-choices-content os-select-dropdown dropdown-menu" role="menu">\n            <li class="enum-param-option-row clickable-input" ng-repeat="enumOption in $ctrl.configParam.getEnumOptions()"\n              ng-click="$ctrl.setControlledRangeStart(enumOption.option)"\n              data-bs-original-title={{enumOption.optionName}} data-bs-placement="bottom">\n              <a class="dropdown-item ellipseOverflowText" href="#"\n                ng-class="{ selected: statement.controlledEnumOptionRange.start === enumOption.option }">\n                {{enumOption.optionName}}\n              </a>\n            </li>\n          </ul>\n        </div>\n        <div class="dropdown"\n          data-bs-original-title="{{$ctrl.getRangeEndToolt