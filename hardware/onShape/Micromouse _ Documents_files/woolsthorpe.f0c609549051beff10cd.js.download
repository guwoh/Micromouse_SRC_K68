nActiveBomTypeChanged()"\n                      ng-options="bomType.name for bomType in bomController.bomTypes | orderBy:\'name\' track by bomType.id">\n              </select>\n              <button class="os-button billofmaterials-sync-bom-plm-button"\n                      ng-if="bomController.canSyncBomToPLM()"\n                      ng-click="bomController.syncBomToPLM()"\n                      ng-disabled="bomController.isSyncBomToPLMBtnDisabled()">\n                <os-svg icon="{{bomController.syncBomIcon()}}" data-bs-original-title="{{bomController.syncBomTooltip()}}"></os-svg>\n              </button>\n              <button class="os-button billofmaterials-open-bom-in-plm-button"\n                      ng-if="bomController.showSyncedItemLinkBtn()"\n                      ng-click="bomController.onSyncedItemLinkBtnClick()"\n                      ng-disabled="bomController.isSyncedItemLinkBtnDisabled()"\n                      data-bs-original-title="{{ \'tooltips:::Open in __pLMName__\' | i18next:{ pLMName: bomController.activeWorkflow.pLMName } }}">\n                <os-svg icon="{{bomController.openSyncedItemIcon()}}"></os-svg>\n              </button>\n            </div>\n            <div class="os-table-header-responsive-last-row bom-header-flex-wrap">\n              <div ng-if="bomController.allowItemsManagement"\n                   class="billofmaterials-insert-items-button"\n                   data-bs-original-title="{{\'tooltips:::Insert items\' | i18next}}"\n                   data-bs-placement="right"\n                   ng-click="bomController.openInsertItemsDialog()">\n                <os-svg icon="insert-item-button"></os-svg>\n              </div>\n              <div class="dropdown os-add-property-dropdown add-bom-column" auto-close="outsideClick"\n                     data-bs-original-title="{{\'tooltips:::Add columns to the BOM table\' | i18next}}"\n                     data-bs-placement="left">\n                <div data-bs-toggle="dropdown"