ate in bomController.tableTemplates">\n                      <a class="dropdown-item" ng-click="bomController.applyTemplateToBomTable(template)" data-bs-original-title="{{ template.name }}">\n                        <span>{{ template.name }}</span>\n                      </a>\n                    </li>\n                    <li ng-switch-when="false" class="disabled">\n                      <a class="dropdown-item"><span>{{ "No templates created" | i18next }}</span></a>\n                    </li>\n                  </ul>\n                </div>\n                \x3c!-- To keep it at right most side so that dropdown options will not get cut-off even when panel size is reduced (BEL-161813) --\x3e\n                <span class="os-pin-right"></span>\n                \x3c!-- Use ng-show nested inside an ng-if to solve BEL-79834 (each dropdown needs its own angular scope which is provided by ng-if but also needs the ng-show so that the dropdown isn\'t removed (so it can get all of its events) --\x3e\n                <div ng-if="true" class="os-no-shrink">\n                  <li class="dropdown os-table-more-button-container">\n                    <a data-bs-toggle="dropdown"\n                       class="os-table-more-button-control"\n                       >\n                      <os-svg icon="overflow"></os-svg>\n                    </a>\n                    <ul class="dropdown-menu dropdown-menu-end os-table-more-menu">\n                      <li ng-if="bomController.getCanCopyTable()">\n                        <a class="dropdown-item" os-clipboard\n                           os-generate-clipboard-text="bomController.copyActiveTableToClipboard()"\n                           os-clipboard-success="bomController.onCopyTableSuccess();"\n                           os-clipboard-error="bomController.onCopyTableFailed(e);">{{ "Copy table" | i18next}}</a>\n                      </li>\n                      <li ng-if="!bomController.shouldShowSuppressedOption()" ng-switch="bomController.showingExcluded">\n                        <a class="dropdown-item" ng-switch-when="true" ng-click="bomController.showExcluded(false)">{{ "Hide excluded" | i18next}}</a>\n                        <a class="dropdown-item" ng-switch-when="false" ng-click="bomController.showExcluded(true)">{{ "Show excluded" | i18next}}</a>\n                      </li>\n                      <li ng-if="bomController.shouldShowSuppressedOption()" ng-switch="bomController.showingExcluded">\n                        <a class="dropdown-item" ng-switch-when="true" ng-click="bomController.showExcluded(false)">{{ "Hide excluded/suppressed" | i18next}}</a>\n                        <a class="dropdown-item" ng-switch-when="false" ng-click="bomController.showExcluded(true)">{{ "Show excluded/suppressed" | i18next}}</a>\n                      </li>\n                      <li><a class="dropdown-item" ng-if="bomController.isIndented()" ng-click="bomController.expandOrCollapseAll(false)">{{ "Collapse all" | i18next}}</a></li>\n                      <li><a class="dropdown-item" ng-if="bomController.isIndented()" ng-click="bomController.expandOrCollapseAll(true)">{{ "Expand all" | i18next}}</a></li>\n                      <li ng-switch="bomController.isShowingTopLevelAssemblyRow()">\n                        <a class="dropdown-item" ng-switch-when="true" ng-click="bomController.showTopLevelAssemblyRow(false)">{{ "Hide top level assembly row" | i18next}}</a>\n                        <a class="dropdown-item" ng-switch-when="false" ng-click="bomController.showTopLevelAssemblyRow(true)">{{ "Show top level assembly row" | i18next}}</a>\n                      </li>\n                      <li><a class="dropdown-item" ng-if="bomController.shouldShowSaveAsTemplate()" ng-click="bomController.saveAsTemplate()">{{ "Save as template…" | i18next }}</a></li>\n                      <li ng-if="bomController.canExport()" class="dropdown-divider"></li>\n                      <li><a class="dropdown-item" ng-if="bom