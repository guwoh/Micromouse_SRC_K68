tings">\n  <div class="os-upgrade-options-title">\n    <span> {{"Renew Education subscription" | i18next}}</span>\n  </div>\n  <br/>\n<div class="os-form-container">\n  <form class="form-horizontal edu-renewal" name="eduRenewalForm"\n    ng-submit="$ctrl.renewEducationSubscription(); eduRenewalForm.$setPristine()" novalidate>\n    <div class="os-form-group width-2x">\n      <p>{{ "Are you student or an educator?" | i18next}}</p>\n      <div>\n        <select class="form-control" name="educationType" ng-model="$ctrl.state.options.educationType" required>\n            <option disabled="" value="" selected="">- {{"Are you a student or an educator?" | i18next}} -</option>\n            <option value="Student">{{"Student" | i18next}}</option>\n            <option value="Educator">{{"Educator" | i18next}}</option>\n        </select>\n      <span class="errorMessage error-no-name text-danger"\n        ng-show="eduRenewalForm.educationType.$error.required">{{ "This field is required." | i18next}}</span>\n      </div>\n    </div>\n    <div class="os-form-group width-2x">\n      <p>{{ "School level" | i18next}}</p>\n      <div>\n        <select class="form-control" ng-model="$ctrl.state.options.schoolLevel" name="schoolLevel" required>\n              <option disabled="" selected="" value="">- {{"School level" | i18next}} -</option>\n              <option value="Grade school (K-12)">{{"Grade school (K-12)" | i18next}}</option>\n              <option value="College or University">{{"College or University" | i18next}}</option>\n        </select>\n      <span class="text-danger errorMessage error-no-name"\n        ng-show="eduRenewalForm.schoolLevel.$error.required">{{ "School level is required." | i18next}}</span>\n      </div>\n    </div>\n    <div class="os-form-group width-2x" ng-if="$ctrl.state.options.educationType === \'Student\'">\n      <p>{{ "Graduation year" | i18next}}</p>\n      <div>\n        <select class="form-control" name="graduationYear" ng-model="$ctrl.state.options.graduationYear" required>\n        <option disabled="" selected="" value="">- {{"Graduation year" | i18next}} -</option>\n        <option ng-repeat="gradYear in $ctrl.state.graduationYears" value="{{gradYear}}">{{gradYear}}</option>\n        </select>\n      <span class="errorMessage error-no-name text-danger" ng-show="eduRenewalForm.graduationYear.$error.required">{{\n        "Graduation year is required." | i18next}}</span>\n\n      </div>\n    </div>\n    <div class="os-form-group wide-form-group">\n      <div class="consent-checkbox">\n        <label for="educationConsentAccepted" id="education_consent_text">\n          <input type="checkbox" ng-model="$ctrl.state.options.educationConsentAccepted" name="educationConsentAccepted"\n            required id="educationConsentAccepted" />\n          <span class="os-radio-or-checkbox-text">\n            {{ "I agree to use this plan for classes, personal learning projects, school clubs/organizations, and academic research. I will not use this plan for government, commercial, or other organizational use" | i18next }}\n          </span>\n        </label>\n      </div>\n      <div class="consent-checkbox">\n        <label for="privacyConsentAccepted" id="privacy_consent_text">\n          <input type="checkbox" ng-model="$ctrl.state.options.privacyConsentAccepted" name="privacyConsentAccepted" required\n            id="privacyConsentAccepted" />\n          <span class="os-radio-or-checkbox-text"\n            ng-i18next="[html:i18next]({privacyPolicyLink: $ctrl.privacyPolicyLink, termsOfUseLink: $ctrl.termsOfUseLink })I agree to these terms as well as Onshape\'s <a href=\'__termsOfUseLink__\' target=\'_blank\'>Terms of Use</a> and <a href=\'__privacyPolicyLink__\' target=\'_blank\'>Privacy Policy</a> and confirm that the above information is accurate and truthful."></span>\n        </label>\n      </div>\n    </div>\n    <div class="os-form-group wide-form-group">\n    </div>\n    <div class="os-form-group">\n      <div>\n        <button class="btn btn-primary" id="btn-user-account-save" ng-disabled="eduRenewalForm.$invalid">{{\n          "Renew Education subscription" | i18next}}</button>\n      </div>\n    </div>\n  </form>\n</div>\n</div>\n')}]),e.exports=n},91785:function(e,t,i){var n="/project/web/ts/userSettings/settings.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div class="os-profile-vertical-list">\n  \x3c!-- locale section --\x3e\n  <osx-preference-language></osx-preference-language>\n  \x3c!-- Theming preference section --\x3e\n  <osx-preference-themes\n    ng-if="$ctrl.darkModeEnabled"\n    [user-current-theme]="$ctrl.userCurrentTheme"\n    (update-user-settings)="$ctrl.updateUserSettings($event.params, $event.successMessage, $event.failureMessage)">\n  </osx-preference-themes>\n\n  \x3c!-- decimal format section --\x3e\n  <osx-preference-decimal-format\n    [use-decimal-comma]="$ctrl.useDecimalComma"\n    (update-user-settings)="$ctrl.updateUserSettings($event.params, $event.successMessage, $event.failureMessage)">\n  </osx-preference-decimal-format>\n\n  \x3c!-- Startup page section --\x3e\n  <div class="user-profile-section-header" ng-if="$ctrl.isEnterprise()">\n    <h4>{{ "Startup page" | i18next }}</h4>\n  </div>\n  <div class="user-settings" ng-if="$ctrl.isEnterprise()">\n    <osx-startup-page\n      [startup-page]="$ctrl.startupPage"\n      [startup-page-message]="$ctrl.startupPageMessage"\n      (update-startup-page)="$ctrl.updateStartupPage($event)">\n    </osx-startup-page>\n  </div>\n\n  \x3c!-- Unit section --\x3e\n  <div class="user-profile-section-header">\n    <h4>{{ "Units" | i18next }}</h4>\n  </div>\n  <div class="user-profile-sub-section">\n    <span>{{\'Change the default units for all newly created documents. Units for existing documents are not changed.\' | i18next}}\n      <a href="{{$ctrl.helpUrl}}" target="_blank">{{\'Learn more about default units.\' | i18next}}</a>\n    </span>\n  </div>\n  \x3c!-- Default Unit and precision section --\x3e\n  <div class="user-settings">\n    <div class="os-form-container">\n      <form class="form-horizontal" ng-submit="$ctrl.updateUserUnitAndDisplayPrecision()">\n        <system-units is-for-user-settings="true" user-settings="$ctrl.userSettings"\n                      on-unit-change="$ctrl.onUnitChange(newDefault)"\n                      on-precision-change="$ctrl.onPrecisionChange(newPrecision)"></system-units>\n        <div>\n          <table class="os-units-display-precision-table">\n            <tbody>\n            \x3c!-- Time format --\x3e\n            <tr>\n              <td class="os-units-display-heading">\n                <label>{{"Time format" | i18next}}</label>\n              </td>\n            </tr>\n            <tr>\n              <td class="os-units-display">\n                <select class="form-control" id="userAccountSettings-time-format-new"\n                        ng-model="$ctrl.use24HourTime"\n                        ng-options="o.value as o.label for o in $ctrl.timeFormatOptions">\n                </select>\n              </td>\n            </tr>\n            \x3c!-- end of time format options --\x3e\n            </tbody>\n          </table>\n        </div>\n        <div class="os-form-group">\n          <div class="os-units-display-precision-save">\n            <button ng-disabled="!$ctrl.getCanSaveUnitsAndPrecision()" class="btn btn-primary" id="btn-user-settings-save-units">{{ "Save changes" | i18next}}</button>\n          </div>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  <div class="user-profile-section-header">\n    <h4>{{ "Mouse controls" | i18next }}</h4>\n  </div>\n  <div class="user-settings">\n    <div class="os-form-container">\n      <div class="os-form-group row-item">\n        <p>{{ "View settings" | i18next}}</p>\n        <div>\n          <select id="view-manipulation-selector-new" class="form-control"\n                  ng-model="$ctrl.viewManipulationMapping.selectedChoice"\n                  ng-options="option.name for option in $ctrl.viewManipulationMapping.choices"\n                  ng-change="$ctrl.setDefaultMouseScrollDirection()">\n          </select>\n        </div>\n      </div>\n      <form class="form-horizontal" ng-submit="$ctrl.updateMouseActions()">\n        <div class="os-view-manipulation-choices-table-wrapper">\n          <table class="os-view-manipulation-choices-table">\n            <thead>\n            <tr class="os-view-manipulation-choices-header">\n              <th class="os-view-manipulation-modes"></th>\n              <th class="os-view-manipulation-modes-border"><span>{{"3D Part & Assembly" | i18next}}</span></th>\n              <th class="os-view-manipulation-modes-border"><span>{{"2D Drawing" | i18next}}</span></th>\n            </tr>\n            </thead>\n            <tbody>\n            \x3c!-- Onshape --\x3e\n            <tr ng-show="$ctrl.isViewSettingOnshape()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Rotate" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{$ctrl.rotateText}}{{"Right mouse button drag" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Not applicable" | i18next}}</td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingOnshape()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Constrained rotate" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{$ctrl.constrainedRotateText}}{{"Right mouse button drag" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Not applicable" | i18next}}</td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingOnshape()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Pan" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">\n                <div class="preserve-newline">{{"Ctrl + Right mouse button drag or \\nMiddle mouse button drag" | i18next}}</div>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions" >\n                <div class="preserve-newline">{{"Ctrl + Right mouse button drag or \\nMiddle mouse button drag or \\nRight mouse button drag or \\nCtrl + Middle mouse button drag" | i18next}}</div>\n              </td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingOnshape()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Zoom" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Scroll wheel in/out" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Scroll wheel in/out" | i18next}}</td>\n            </tr>\n\n            \x3c!-- SW --\x3e\n            <tr ng-show="$ctrl.isViewSettingSW()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Rotate" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{$ctrl.rotateText}}{{"Middle mouse button drag" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Not applicable" | i18next}}</td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingSW()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Constrained rotate" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{$ctrl.constrainedRotateText}}{{"Middle mouse button drag" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Not applicable" | i18next}}</td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingSW()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Pan" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Ctrl + Middle mouse button drag" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">\n                <div class="preserve-newline">{{"Middle mouse button drag or \\nCtrl + Middle mouse button drag" | i18next}}</div>\n              </td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingSW()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Zoom" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align  os-view-manipulation-table-cell-dimensions">\n                <div class="preserve-newline">{{"Scroll wheel in/out or \\nShift + Middle mouse button drag" | i18next}}</div>\n              </td>\n              <td class="os-view-manipulation-text-align  os-view-manipulation-table-cell-dimensions">\n                <div class="preserve-newline">{{"Scroll wheel in/out or \\nShift + Middle mouse button drag" | i18next}}</div>\n              </td>\n            </tr>\n\n            \x3c!-- NX --\x3e\n            <tr ng-show="$ctrl.isViewSettingNX()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Rotate" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{$ctrl.rotateText}}{{"Middle mouse button drag" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Not applicable" | i18next}}</td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingNX()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Constrained rotate" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{$ctrl.constrainedRotateText}}{{"Middle mouse button drag" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Not applicable" | i18next}}</td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingNX()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Pan" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Shift + Middle mouse button drag" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Shift + Middle mouse button drag" | i18next}}</td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingNX()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Zoom" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">\n                <div class="preserve-newline">{{"Scroll wheel in/out or \\nCtrl + Middle mouse button drag" | i18next}}</div>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">\n                <div class="preserve-newline">{{"Scroll wheel in/out or \\nCtrl + Middle mouse button drag" | i18next}}</div>\n              </td>\n            </tr>\n\n            \x3c!-- Creo --\x3e\n            <tr ng-show="$ctrl.isViewSettingCreo()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Rotate" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{$ctrl.rotateText}}{{"Middle mouse button drag" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Not applicable" | i18next}}</td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingCreo()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Constrained rotate" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{$ctrl.constrainedRotateText}}{{"Middle mouse button drag" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Not applicable" | i18next}}</td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingCreo()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Pan" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Shift + Middle mouse button drag" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Middle mouse button drag" | i18next}}</td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingCreo()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Zoom" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">\n                <div class="preserve-newline">{{"Scroll wheel in/out or \\nCtrl + Middle mouse button drag" | i18next}}</div>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">\n                <div class="preserve-newline">{{"Scroll wheel in/out or \\nCtrl + Middle mouse button drag" | i18next}}</div>\n              </td>\n            </tr>\n\n            \x3c!-- AutoCad --\x3e\n            <tr ng-show="$ctrl.isViewSettingAutoCAD()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Rotate" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{$ctrl.rotateText}}{{"Shift + Middle mouse button drag" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Not applicable" | i18next}}</td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingAutoCAD()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Constrained rotate" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{$ctrl.constrainedRotateText}}{{"Shift + Middle mouse button drag" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Not applicable" | i18next}}</td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingAutoCAD()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Pan" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Middle mouse button drag" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Middle mouse button drag" | i18next}}</td>\n            </tr>\n            <tr ng-show="$ctrl.isViewSettingAutoCAD()">\n              <td class="os-view-manipulation-table-cell-dimensions">\n                <label class="os-view-manipulation-actions-names ">{{"Zoom" | i18next}}</label>\n              </td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Scroll wheel in/out" | i18next}}</td>\n              <td class="os-view-manipulation-text-align os-view-manipulation-table-cell-dimensions">{{"Scroll wheel in/out" | i18next}}</td>\n            </tr>\n            </tbody>\n\n          </table>\n          <br>\n        </div>\n        <div class="os-form-group message">\n          <div>\n            <label><input type="checkbox" class="os-user-preference-reverse-scroll" ng-model="$ctrl.newMouseActions.scrollCheckbox"> {{ "Reverse scroll wheel zoom direction" | i18next}}</label>\n          </div>\n          <div ng-show="$ctrl.allowDefaultAxisRotationLock">\n            <label><input type="checkbox" class="os-user-preference-reverse-scroll" ng-model="$ctrl.rotationLockSettings.axisRotationLock" ng-change="$ctrl.changeRotationLockSettings()"> {{ "Set default rotation behavior to constrained rotate" | i18next}}</label>\n          </div>\n        </div>\n        <div class="os-form-group">\n          <div>\n            <button id="btn-view-manipulation-settings-save-new" class="btn btn-primary"\n                    ng-disabled="$ctrl.viewManipulationMapping.selectedChoice.id === $ctrl.viewManipulationMapping.choiceId && $ctrl.newMouseActions.scrollCheckbox === $ctrl.newMouseActions.scrollCheckboxOriginalValue && $ctrl.rotationLockSettings.axisRotationLock === $ctrl.rotationLockSettings.axisRotationLockOriginalValue">\n              {{ "Save mouse controls" | i18next}}\n            </button>\n          </div>\n        </div>\n      </form>\n    </div>\n  </div>\n\n  \x3c!-- Environment Profile --\x3e\n  <osx-preference-environment-profile></osx-preference-environment-profile>\n\n  \x3c!-- Assembly settings section --\x3e\n  <osx-preference-assembly-settings\n    [display-assembly-properties]="$ctrl.displayAssemblyProperties"\n    (update-user-settings)="$ctrl.updateUserSettings($event.params, $event.successMessage, $event.failureMessage)">\n  </osx-preference-assembly-settings>\n</div>\n\n<div class="user-settings-section-header" os-focus-view="customize-keyboard-shortcuts">\n  <h4 class="os-user-preference-inline-heading">{{"Keyboard shortcuts" | i18next}}</h4>\n  <div class="popover-container">\n    <span class="os-user-preference-info os-question-mark"\n          popover-trigger="\'mouseenter\'"\n          popover-append-to-body="true"\n          uib-popover=\'{{"Customize your keyboard shortcuts by clicking the pencil icon. If a shortcut combination contains operating system specific keys, this may result in unexpected behavior in different operating systems." | i18next}}\'\n          popover-placement="right">\n    </span>\n  </div>\n</div>\n<div class="user-settings">\n  <div class="os-form-container">\n    <customize-shortcuts class="os-row"></customize-shortcuts>\n  </div>\n</div>\n\n\x3c!-- mini toolbars --\x3e\n<div class="user-profile-section-header" id="mini">\n  <h4>{{"Shortcut toolbars" | i18next}}</h4>\n</div>\n<div class="user-settings">\n  <div class="os-form-container">\n    <form class="form-horizontal" ng-submit="$ctrl.updateShortcutToolbar()">\n      <div class="os-mini-toolbar-context-selection">\n        <select class="form-control"\n                ng-model="$ctrl.selectedMiniToolbarContext"\n                ng-change="$ctrl.setMiniToolbarCommands()"\n                ng-options="(setting.tabType | i18next) for setting in $ctrl.miniToolbarSettings">\n        </select>\n      </div>\n      <div class="os-mini-toolbar-commands-list float-start">\n          <div ng-repeat="commandSet in [$ctrl.selectedMiniToolbarContextCommands, $ctrl.selectedMiniToolbarContextGeneralCommands]">\n            <div class="mini-toolbar-settings-divider" ng-if="commandSet.length && !$first">\n              <hr class="left"/><span class="mini-toolbar-settings-divider-text">{{"General" | i18next}}</span><hr class="right" />\n            </div>\n            <span ng-repeat="command in commandSet">\n              <label class="os-mini-toolbar-commands-entries" ng-class="{\'os-mini-toolbar-commands-show\': command.display}">\n                <input type="checkbox" ng-model="command.display" ng-change="$ctrl.miniToolbarCheckboxChecked()" icon="{{command.icon}}" />\n                <os-svg ng-if="command.icon" icon="{{command.icon}}"></os-svg>\n                <span ng-if="command.iconInitials" class="os-tool-initials-icon">\n                  {{command.iconInitials}}\n                </span>\n                <span>{{(command.name) | i18next}}</span>\n              </label><br/>\n            </span>\n          </div>\n      </div>\n      <div class="os-mini-toolbar-preview">\n        <div class=\'os-mini-toolbar\'>\n          <div class="expanded-tool os-tool-item" ng-show="command.display" ng-repeat="command in $ctrl.selectedMiniToolbarContext.commands">\n            <div class="os-tool-button os-toolbar-button">\n              <div class="os-tool-command">\n                <div class="os-tool-command-icon" >\n                  <os-svg ng-if="command.icon" icon="{{command.icon}}"></os-svg>\n                  <span ng-if="command.iconInitials" class="os-tool-initials-icon">\n                    {{command.iconInitials}}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div ng-if="$ctrl.areCommandsEmptyForAContext($ctrl.selectedMiniToolbarContext)" class="os-mini-toolbar-empty-command">\n            <spa>{{"No tools added" | i18next}}</spa>\n          </div>\n        </div>\n      </div>\n      <div class="os-form-group">\n        <div>\n          <button ng-disabled="!$ctrl.miniToolbarDefinitionChanged || $ctrl.processingShortcutUpdate"\n                  class="btn btn-primary text-nowrap os-mini-toolbar-save-button">\n            {{ "Save shortcut toolbar settings" | i18next}}\n          </button>\n        </div>\n      </div>\n    </form>\n  </div>\n</div>\n\n<div>\n  <div class="user-profile-section-header">\n    <h4>{{\'Toolbars\' | i18next}}</h4>\n  </div>\n  <div class="user-settings">\n    <div class="os-form-container">\n      <button class="btn btn-primary" type="button" ng-disabled="$ctrl.processingResetToolbars" ng-click="$ctrl.resetCustomToolbars()">{{\'Reset to defaults\' | i18next}}</button>\n    </div>\n  </div>\n</div>\n\n\x3c!-- Drawings settings --\x3e\n<osx-preference-drawings\n  [drawing-background-mapping-choice-id]="$ctrl.drawingBackgroundMappingChoiceId"\n  (update-user-settings)="$ctrl.updateUserSettings($event.params, $event.successMessage, $event.failureMessage)">\n</osx-preference-drawings>\n\n<div class="user-profile-section-header">\n  <h4>{{ "Material libraries" | i18next }}</h4>\n</div>\n<div class="user-profile-details-wrapper">\n  <div class="os-profile-vertical-list">\n    <div clas