ableGroup)}"\n         ng-click="documentInsertableSet.switchToInsertableGroup(insertableGroup)">\n      {{insertableGroup.getDisplayName()}}\n    </div>\n  </div>\n\n  \x3c!-- Document search box --\x3e\n  <div ng-show="viewState.shouldShowDocumentSearchBox()"\n       class="os-control-container document-version-picker-search-container ng-cloak">\n    <search-box class="os-row search-box select-item-document-search"\n                placeholder="viewState.documentSearchPlaceholder"\n                search-query="viewState.documentSearchText"\n                with-query="viewState.documentSearchText"\n                with-criteria="true"\n                is-active="viewState.shouldShowDocumentSearchBox()"\n                excluded-fields="viewState.getDocumentSelector().getCriteriaToExcludeFromSearch()"\n                searchable-types="::(viewState.getDocumentSelector().getSearchableTypes())"\n    ></search-box>\n  </div>\n\n  \x3c!-- Insertables search box --\x3e\n  <div class="os-control-container document-version-picker-search-container"\n       ng-if="viewState.shouldShowInsertablesSearchBox(Ctrl.insertableSelector)">\n    <div class="os-control-row">\n      <os-search-box class="select-item-insertables-search os-search-box-container os-grow os-field"\n                     trim="false"\n                     search-text="viewState.insertablesSearchText"\n                     placeholder="viewState.insertablesSearchPlaceholder">\n      </os-search-box>\n    </div>\n  </div>\n\n  \x3c!-- Document list title row --\x3e\n  <div class="os-dialog-title-row os-no-shrink"\n       ng-if="viewState.shouldShowDocumentListFilterTitleBar()">\n    <os-select-item-home-btn view-state="viewState"></os-select-item-home-btn>\n    <button class="os-button os-clear document-version-picker-go-back-to-filters-list"\n            type="button"\n            ng-if="viewState.getDocumentSelector().getCanGoBackFromDocumentList()"\n            ng-click="viewState.getDocumentSelector().goBackFromDocumentList()"\n            ng-disabled="viewState.getIsReadonly()"\n            data-bs-original-title="{{ viewState.getDocumentSelector().getBackButtonTitle() }}"\n            data-bs-placement="left">\n      <os-svg icon="back-tab" class="button-icon"> </os-svg>\n    </button>\n    <div class="os-col os-grow document-version-picker-selected-filter">\n      <span class="select-item-dialog-document-name document-version-picker-current-filter">{{viewState.getDocumentSelector().getSelectedFilterTitle()}}</span>\n    </div>\n  </div>\n\n  \x3c!-- Standard content--\x3e\n  <div ng-include="\'/project/web/ts/standardContent/standardContent.html\'" ng-controller="StandardContentDialogController as ctrl" class="standard-content-container" ng-show="viewState.shouldShowStandardContent()"></div>\n\n  \x3c!-- Non-Geometric items--\x3e\n  <div ng-include="\'/project/web/ts/items/insertItemsTemplate.html\'" ng-controller="InsertItemsController as ctrl" class="insert-items-container" ng-show="viewState.shouldShowNonGeometricItems()"></div>\n\n  \x3c!-- Document filter list--\x3e\n  <div class="document-version-picker-section document-version-picker-document-filters select-item-dialog-subdialog-container"\n    ng-show="viewState.shouldShowDocumentFilterList()">\n    <osx-document-filters-component\n      [is-flat]="true"\n      display-source="documentVersionPicker"\n      [view-state]="viewState"\n      [global-tree-nodes]="globalTreeNodes"\n      (change-tree-node)="changeTreeNode($event.treeNode, $event.$event)"\n      (change-filter)="changeFilter($event.filterType)"\n      (change-filter-to-recently-referenced)="changeFilterToRecentlyReferenced($event.fullParameterId)"\n      [user-teams]="userTeams"\n      (change-team)="changeTeam($event.team)"\n      [user-labels]="userLabels"\n      (change-label)="changeLabel($event.label)"\n      [show-public-filter]="showPublicDocumentFilter">\n    </osx-document-filters-component>\n  </div>\n\n  \x3c!-- Element Libraries--\x3e\n  <div ng-include="\'/project/web/ts/elementLibrary/elementLibraryComponentTemplate.html\'"\n    ng-controller="ElementLibraryController as ctrl" ng-if="viewState.shouldShowElementLibraries()"\n    class="os-element-library-container"></div>\n\n  \x3c!-- Toolbar FS tables--\x3e\n  <div ng-include="\'/project/web/ts/selectItem/toolbarFsTableComponentTemplate.html\'"\n    ng-controller="ToolbarFsTableController as ctrl" ng-if="viewState.shouldShowToolbarFsTables()"\n    class="toolbar-fs-tables-container"></div>\n\n  \x3c!-- Document list--\x3e\n  <div class="document-version-picker-section document-version-picker-document-list select-item-dialog-subdialog-content"\n       ng-if="viewState.shouldShowDocumentsList()" when-scrolled="viewState.getDocumentSelector().documentVersionPickerSearchResult.loadNextDocuments()">\n    <div ng-show="viewState.getDocumentSelector().documentVersionPickerSearchResult.isFetchingFirstPage()" class="ns-select-item-dialog-item-empty">\n      <span>{{"Loading…" | i18next}}</span>\n    </div>\n    <div ng-if="!viewState.getDocumentSelector().documentVersionPickerSearchResult.isFetchingFirstPage()">\n      <div ng-show="viewState.getDocumentSelector().documentVersionPickerSearchResult.isEmpty()" class="ns-select-item-dialog-item-empty">\n        <span ng-if="!viewState.documentSearchText">{{"No documents found" | i18next}}</span>\n        <span ng-if="viewState.documentSearchText">{{"No results found" | i18next}}</span>\n\n      </div>\n      <picker-item-list class="select-item-tree" doc-selector="viewState.getDocumentSelector()"></picker-item-list>\n    </div>\n  </div>\n\n  \x3c!-- Version graph--\x3e\n  <div class="os-col document-version-picker-section document-version-picker-version-graph"\n       ng-if="viewState.shouldShowVersionGraph()"\n       ng-class="Ctrl.documentVersionPicker.getVersionGraphNgClasses()">\n    <div class="os-dialog-title-row os-version-graph-legend os-no-shrink">\n      <os-svg icon="workspace"></os-svg>\n      <span class="workspace-name">{{"Workspace" | i18next}}</span>\n      <os-svg icon="version"></os-svg>\n      <span class="version-name">{{"Version" | i18next}}</span>\n    </div>\n    <div class="os-dialog-title-row os-version-graph-legend os-no-shrink" ng-if="isReleaseEnabled()">\n      <os-svg icon="revision-pending"></os-svg>\n      <span class="version-name">{{"Release candidate" | i18next}}</span>\n      <os-svg icon="revision"></os-svg>\n      <span class="version-name">{{"Release" | i18next}}</span>\n    </div>\n    <div class="os-versions-container os-grow">\n      <div ng-if="doingQueries" class="os-padded-centered-holder">\n        <span >{{ "Loading versions…" | i18next}}</span>\n      </div>\n      <div ng-if="doingQueries" class="os-padded-centered-holder">\n        <div class="os-spinner-medium os-spinner-spinning"></div>\n      </div>\n      <div os-version-graph\n           class="os-version-graph"\n           ng-show="showContent"\n           ng-style="{width: svgWidth + \'px\'}">\n      </div>\n      <div ng-show="showContent" class="os-version-list os-col">\n        <div ng-repeat="workspaceOrVersion in displayedWorkspacesAndVersions"\n             class="os-row os-align-center os-version-row os-selectable-item {{viewState.getDocumentSelector().isWorkspaceOrVersionSelectable(workspaceOrVersion) ? \'os-selectable-version\' : \'os-disabled-version\'}}"\n             ng-class="{\'os-selected\': viewState.getDocumentSelector().getIsCurrentWorkspaceOrVersion(workspaceOrVersion.id)}"\n             ng-click="viewState.getDocumentSelector().selectVersion(documentId, workspaceOrVersion)"\n             ng-style="{\'padding-left\': svgWidth + \'px\'}"\n             data-bs-original-title="{{workspaceOrVersion.name}}">\n          <span class="version-name">{{workspaceOrVersion.name}}</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \x3c!-- Filter buttons --\x3e\n  <div class= "os-control-container os-wrap os-no-shrink" ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().getShouldShowFilterBar() && viewState.getIsShowingInsertablesView() && !Ctrl.insertableSelector.getIsLoadingElementsOrConfigurations()">\n    <div class="os-control-row" >\n      <button ng-repeat="filter in Ctrl.insertableSelector.getCurrentInsertablesGroup().getFilterBar().filterButtons"\n              class="os-button os-clear"\n              ng-class="{\'os-right-justified\': filter.isButtonRightJustified(), \'os-active\': filter.isFilterActive}"\n              ng-click="filter.toggleFilterButton()"\n              ng-if="filter.isFilterVisible"\n              ng-disabled="filter.isFilterDisabled"\n              data-bs-original-title="{{filter.filterDisplayName}}"\n              data-bs-placement="right">\n        <div class="button-content">\n          <os-svg icon="{{filter.iconName}}" class="button-icon"></os-svg>\n        </div>\n      </button>\n    </div>\n  </div>\n\n  \x3c!-- Insertables picker --\x3e\n  <div ng-if="viewState.getIsShowingInsertablesView()" os-select-dropdown-bounds\n       class="select-item-dialog-subdialog-container">\n    <div ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup()" class="select-item-dialog-subdialog-content" >\n      <div ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().getChangesSinceVersionSave() > 0" class="select-item-warning alert alert-info">\n          <span ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().getChangesSinceVersionSave() === 1">\n              {{"1 change since the last version." | i18next}}\n          </span>\n          <span ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().getChangesSinceVersionSave() !== 1">\n              {{"__numberOfChanges__ changes since the last version." | i18next:{numberOfChanges: Ctrl.insertableSelector.getCurrentInsertablesGroup().getChangesSinceVersionSave()} }}\n          </span>\n          <div ng-if="!Ctrl.insertableSelector.getRestrictedVersionId() && Ctrl.documentVersionPicker.getCanShowCreateVersionButton()">\n            <span ng-if="!Ctrl.insertableSelector.getCurrentInsertablesGroup().hasMultipleVersions && Ctrl.insertableSelector.getCurrentInsertablesGroup().getIsSuccessfullyLoadedAndEmpty()">\n              {{ "__displayName__ need to be inserted from versioned documents. This document has not yet been versioned." | i18next:{displayName: Ctrl.insertableSelector.getCurrentInsertablesGroup().getDisplayName()} }}\n            </span>\n            <br>\n            <span ng-if="!Ctrl.insertableSelector.getCurrentInsertablesGroup().hasPermissionToSaveVersion">\n              {{ "You do not have permission to edit this document. Ask the owner to create a version." | i18next }}\n            </span>\n            <div ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().hasPermissionToSaveVersion" class="select-item-prompt-save-version">\n              <a\n                ng-click="viewState.getDocumentSelector().promptForSavingVersion()">\n                {{ "Create a version in __documentName__." | i18next:{documentName: viewState.getDocumentSelector().getSelectedDocumentName()} }}\n              </a>\n            </div>\n          </div>\n      </div>\n     <div ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().hasLoadingErrors()" class="select-item-warning alert alert-info">\n        <span>{{Ctrl.insertableSelector.getCurrentInsertablesGroup().getLoadErrorMessage()}}</span>\n     </div>\n\n      <div class="select-item-tree">\n        \x3c!--Element level insertables--\x3e\n        <div class="select-item-parent-group"\n          ng-repeat="elementInsertableViewModel in Ctrl.insertableSelector.getCurrentInsertablesGroup().getElementInsertableViewModels()"\n          ng-if="Ctrl.insertableSelector.shouldShowElementInsertable(elementInsertableViewModel)">\n          <div class="select-item-dialog-item-row parent-item-expander-row">\n\n            \x3c!--Element level collapse/expand buttons--\x3e\n            <div ng-if="elementInsertableViewModel.getCanShowExpanderButton()"\n                class="ns-select-item-dialog-item-expand-collapse"\n                ng-click="elementInsertableViewModel.toggleExpandedState()">\n              <os-svg\n                ng-if="elementInsertableViewModel.isExpanded"\n                class="os-icon-xsmall"\n                icon="expanded">\n              </os-svg>\n              <os-svg\n                ng-if="!elementInsertableViewModel.isExpanded"\n                class="os-icon-xsmall"\n                icon="collapsed">\n              </os-svg>\n            </div>\n\n            <div class="select-item-dialog-item parent-item"\n               data-bs-original-title="{{elementInsertableViewModel.getTooltip()}}"\n               os-single-double-click="{{Ctrl.closeAfterDoubleClick}}"\n               os-click="Ctrl.insertableSelector.selectElementInsertable(elementInsertableViewModel)"\n               os-double-click="Ctrl.insertableSelector.selectElementInsertableThenClose(elementInsertableViewModel)"  ng-class="{\'os-selectable-item\': Ctrl.insertableSelector.getCanTopLevelInsertableBeSelected(elementInsertableViewModel),\n              \'select-item-disabled-item\': elementInsertableViewModel.getIsDisabled(),\n              \'select-item-readonly-item\': viewState.getIsReadOnly(),\n              \'os-selected\': elementInsertableViewModel.isReferenceSelected}">\n\n              \x3c!--Element level image/icon/thumbnail container--\x3e\n              <div ng-if="Ctrl.insertableSelector.shouldShowElementThumbnail() || elementInsertableViewModel.hasReleased()" class="select-item-dialog-thumbnail-container os-no-shrink">\n\n                \x3c!--Element level icon--\x3e\n                <svg ng-if="elementInsertableViewModel.getHasIconImage()"\n                      class="select-item-dialog-item-icon">\n                  <use xlink:href="{{elementInsertableViewModel.getIconImageSource()}}"></use>\n                </svg>\n\n                \x3c!--Element level thumbnail--\x3e\n                <img ng-if="elementInsertableViewModel.hasAThumbnail()"\n                     ng-src="{{elementInsertableViewModel.getDisplayThumbnailUri()}}"\n                     img-fallback-src="{{elementInsertableViewModel.getDefaultThumbnailUri()}}"\n                     img-fallback-retry="true">\n\n              </div>\n\n              \x3c!--Element level display name--\x3e\n              <div class="select-item-dialog-item-name os-row">\n                <span class="os-select-item-insertable-name" data-bs-original-title="{{elementInsertableViewModel.getInsertableName()}}">{{elementInsertableViewModel.getInsertableName()}}</span>\n                <span ng-if="elementInsertableViewModel.hasReleased()" class="os-select-item-part-number" data-bs-original-title="{{elementInsertableViewModel.insertable.partNumber}}">{{elementInsertableViewModel.insertable.partNumber}}</span>\n                <span ng-if="elementInsertableViewModel.hasReleased()" class="os-select-item-revision" data-bs-original-title="({{elementInsertableViewModel.insertable.revision}})">({{elementInsertableViewModel.insertable.revision}})</span>\n              </div>\n\n              \x3c!--Element level spinner--\x3e\n              <div ng-if="elementInsertableViewModel.isInsertionInProgress" class="select-item-spinner-holder">\n                <div class="os-spinner-small os-spinner-spinning"></div>\n              </div>\n\n              <button\n                ng-if="viewState.getDocumentSelector().getIsShowingReleasedItems() && elementInsertableViewModel.hasReleased() && !viewState.getIsReadOnly()"\n                class="os-button os-clear select-item-dialog-has-release"\n                data-bs-original-title="{{\'Select another revision of this part number\' | i18next}}"\n                ng-click="Ctrl.insertableSelector.showReleaseHistory($event, elementInsertableViewModel)"\n              ><os-svg icon="released"></os-svg></button>\n            </div>\n        </div>\n\n          \x3c!-- Configuration selector --\x3e\n          <div\n            ng-if="elementInsertableViewModel.isExpanded && elementInsertableViewModel.getHasConfigurations()"\n               class="select-item-configuration-selector">\n\n            \x3c!-- Configuration parameters --\x3e\n            <os-parameter-list-view bt-parameters="elementInsertableViewModel.getConfigurationSelectorBtParameters()"\n                                    build-context-menu-for-parameter="Ctrl.insertableSelector.buildContextMenuForConfigurationParameterFunction"></os-parameter-list-view>\n\n            \x3c!-- Generate button --\x3e\n            <div ng-if="elementInsertableViewModel.getCanShowGenerateButton() && !viewState.getIsReadOnly()"\n                 class="select-item-generate-button-holder">\n            <button ng-click="elementInsertableViewModel.generateConfigurations()"\n\n                    ng-disabled="!elementInsertableViewModel.getCanGenerateConfigurations()"\n                    class="os-button os-outline select-item-generate-button">\n              <span>{{(\'Generate\' | i18next)}}</span>\n            </button>\n            </div>\n            <div ng-if="elementInsertableViewModel.getIsConfigurationLoading()" class="os-padded-centered-holder">\n              <div class="os-spinner-medium os-spinner-spinning"></div>\n            </div>\n\n          </div>\n\n          \x3c!--Child level insertables--\x3e\n          <div ng-if="elementInsertableViewModel.isExpanded && elementInsertableViewModel.getIsCurrentConfigurationLoadedAndEmpty()" class="ns-select-item-dialog-item-empty">\n            <span>{{ "No __pluralName__ in this configuration." | i18next:{pluralName: Ctrl.insertableSelector.getCurrentInsertablesGroup().getPluralName()} }}</span>\n          </div>\n\n          <div ng-if="elementInsertableViewModel.isExpanded" ng-repeat="childViewModel in Ctrl.insertableSelector.getCurrentInsertablesGroup().getFilteredChildInsertableItems(elementInsertableViewModel)">\n            <div ng-if="childViewModel.isSearchMatch && childViewModel.canDisplay && !Ctrl.insertableSelector.getHideParts()"\n                 class="select-item-dialog-item-row child-item-container"\n                 ng-class="{\'os-selectable-item\': (!childViewModel.getIsDisabled() && !viewState.getIsReadOnly()),\n                            \'select-item-disabled-item\': childViewModel.getIsDisabled(),\n                            \'select-item-readonly-item\': viewState.getIsReadOnly(),\n                            \'os-selected\': childViewModel.isReferenceSelected}"\n                 os-single-double-click="{{Ctrl.closeAfterDoubleClick}}"\n                 os-click="Ctrl.insertableSelector.selectChildInsertable(childViewModel, elementInsertableViewModel)"\n                 os-double-click="Ctrl.insertableSelector.selectChildInsertableThenClose(childViewModel, elementInsertableViewModel)">\n              <div class="select-item-dialog-item child-item"\n                   data-bs-original-title="{{childViewModel.getTooltip()}}">\n\n                \x3c!--Child level image/icon/thumbnail container--\x3e\n                <div class="select-item-dialog-thumbnail-container os-no-shrink">\n\n                  \x3c!--Child level thumbnail--\x3e\n                  <img ng-if="childViewModel.showThumbnail()"\n                       ng-src="{{childViewModel.getDisplayThumbnailUri()}}"\n                       img-fallback-src="{{childViewModel.getDefaultThumbnailUri()}}"\n                       img-fallback-retry="true">\n\n                  <div ng-if="childViewModel.showIcon()" class="os-tool-button select-item-icon">\n                    <div class="os-tool-command-icon">\n                      <os-svg ng-if="childViewModel.hasIconUri()" icon="{{Ctrl.getWorkspaceIdUri(childViewModel.getIcon())}}" from-uri="true"></os-svg>\n                      <os-svg ng-if="!childViewModel.hasIconUri()" icon="{{childViewModel.getIcon()}}"></os-svg>\n                    </div>\n                  </div>\n\n                  \x3c!--Child level auto generated initials icon (for custom feature types)--\x3e\n                  <div ng-if="childViewModel.showIconInitials()"\n                       class="os-tool-button select-item-icon">\n                    <div class="os-tool-command-icon">\n                      <span class="os-tool-initials-icon">{{::childViewModel.getIconInitials()}}</span>\n                    </div>\n                  </div>\n\n                </div>\n\n                \x3c!--Child level display name--\x3e\n                <div class="select-item-dialog-item-name"\n                     ng-class="{\'ns-list-item-error\': childViewModel.getIsFaulty()}">\n                  {{::childViewModel.getInsertableName()}}\n                </div>\n\n                \x3c!--Child level spinner--\x3e\n                <div ng-if="childViewModel.isInsertionInProgress" class="select-item-spinner-holder">\n                  <div class="os-spinner-small os-spinner-spinning"></div>\n                </div>\n\n                <button\n                  ng-if="Ctrl.insertableSelector.getDocumentSelector().getIsShowingReleasedItems() && childViewModel.hasReleased()"\n                  class="os-button os-clear select-item-dialog-has-release"\n                  data-bs-original-title="{{\'Select another revision of this part number\' | i18next}}"\n                  ng-click="Ctrl.insertableSelector.showReleaseHistory($event, childViewModel)"\n                ><os-svg icon="released"></os-svg></button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div ng-if="Ctrl.insertableSelector.getIsLoadingElementsOrConfigurations()"\n           class="os-center-content ns-select-item-dialog-item-empty">\n        <div class="os-spinner-medium os-spinner-spinning"></div>\n      </div>\n      <div ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().getIsSuccessfullyLoadedAndEmpty()" class="ns-select-item-dialog-item-empty">\n        <span>{{ "No __pluralName__ available." | i18next:{pluralName: Ctrl.insertableSelector.getCurrentInsertablesGroup().getPluralName()} }}</span>\n      </div>\n      <div ng-if="Ctrl.insertableSelector.isMissingPermanentRestrictedElement()" class="ns-select-item-dialog-item-empty">\n        <span>{{ "The associated tab or its content may have been removed." | i18next }}</span>\n      </div>\n      <div ng-if="Ctrl.insertableSelector.isMissingPermanentRestrictedElementContent()" class="ns-select-item-dialog-item-empty">\n        <span>{{ "The content in the associated tab may have been removed." | i18next }}</span>\n      </div>\n      <div ng-if="Ctrl.insertableSelector.getCurrentInsertablesGroup().getIsLoaded() && viewState.insertablesSearchText && !Ctrl.insertableSelector.getCurrentInsertablesGroup().getSearchHasMatches()"\n        class="ns-select-item-dialog-item-empty">\n        <span> {{ "No __pluralName__ match current search." | i18next:{pluralName: Ctrl.insertableSelector.getCurrentInsertablesGroup().getPluralName()} }}</span>\n      </div>\n    </div>\n    <div ng-if="viewState.showInsertionStatus" class="os-inserted-count-container">\n      <span ng-if="Ctrl.inserting">{{ "Inserting…" | i18next}}</span> <span ng-if="!Ctrl.inserting">{{ "Inserted: " | i18next}} {{Ctrl.totalInsertedCount}}</span>\n    </div>\n  </div>\n\n  <div class="os-dialog-title-row" ng-if="viewState.showPartNumberHistory">\n    <button class="os-button os-clear document-version-picker-go-back-from-release-history"\n            type="button"\n            ng-click="Ctrl.insertableSelector.hideReleaseHistory()"\n            ng-disabled="viewState.getIsReadOnly()"\n            data-bs-original-title="{{\'Back\' | i18next}}"\n            data-bs-placement="left">\n      <div class="button-content">\n        <img src="/images/back-tab.svg" alt="" class="button-icon"/>\n      </div>\n    </button>\n    <div class="select-item-dialog-document-name-box os-col os-grow">\n      <span class="select-item-dialog-document-name document-version-picker-current-document ellipseOverflowText">{{Ctrl.insertableSelector.partNumberForHistory}}</span>\n    </div>\n  </div>\n  <div class="select-item-revision-history" ng-if="viewState.showPartNumberHistory" os-select-dropdown-bounds>\n    <div ng-if="Ctrl.insertableSelector.hasRevisionHistoryError" class="select-item-warning alert alert-info">\n      <span>{{Ctrl.insertableSelector.revisionHistoryErrorMessage}}</span>\n    </div>\n    <part-history\n      ng-if="!Ctrl.insertableSelector.hasRevisionHistoryError"\n      revisions="::Ctrl.insertableSelector.revisionHistory"\n      compact="true"\n      hide-obsolete="true"\n      row-class="\'document-version-item-row select-item-dialog-item-row os-selectable-item\'"\n      on-row-click="Ctrl.insertableSelector.selectInsertableVersionFromRevision(rev)"\n      class="select-item-dialog-subdialog-content"\n    >\n    </part-history>\n  </div>\n\n  <div ng-if="showImportButton" class="select-item-import-button-container">\n    <span class="select-item-import-button" ng-click="Ctrl.onImportClick()">\n      <os-svg icon="document-upload" class="button-icon"></os-svg>{{\'Import…\' | i18next}}\n    </span>\n  </div>\n</div>\n')}]),e.exports=n},12254:function(e,t,i){var n="/project/web/ts/selectItem/selectedItem.html";i(57229).module("ng").run(["$templateCache",function(e){e.put(n,'<div ng-repeat="addition in $ctrl.additions" class="select-item-dialog-item-row selected-item-row os-selectable-item">\n  <div class="select-item-dialog-item" data-bs-original-title="{{::addition.item.getSelectedInsertableName()}}">\n    \x3c!-- image/icon/thumbnail container--\x3e\n    <div class="select-item-dialog-thumbnail-container os-no-shrink">\n      \x3c!--Element level icon--\x3e\n      <svg ng-if="addition.item.getHasIconImage()" class="select-item-dialog-item-icon">\n        <use xlink:href="{{addition.item.getIconImageSource()}}"></use>\n      </svg>\n\n  