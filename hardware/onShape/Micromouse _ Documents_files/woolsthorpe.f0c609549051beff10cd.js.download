n" data-bs-original-title="{{\'Change to revisions\' | i18next}}" data-bs-placement="right">\n          <os-svg icon="revisioned-document"></os-svg>\n        </button>\n      </div>\n      <div ng-if="documentVersionList.getIsLoading()" class="ns-select-item-dialog-item-empty">\n        <span ng-if="!documentVersionList.isChangingToRevisions()">{{"Loading latest versions…" | i18next}}</span>\n        <span ng-if="documentVersionList.isChangingToRevisions()">{{"Loading latest revisions…" | i18next}}</span>\n      </div>\n      <div class="external-reference-update-document-version-list os-grow">\n        <ul class="select-item-tree os-col">\n          <span class="external-reference-show-identical-references-item" ng-if="activeTab === SELECTIVE_UPDATE && documentVersionList.shouldShowIdenticalReferencesLabel(activeTab, lockedOnlyFilter)">{{"Identical references" | i18next}}</span>\n          <li ng-repeat="updateItemViewModel in documentVersionList.getUpdateItems(activeTab, lockedOnlyFilter)">\n            <div class="external-reference-update-single-item os-row os-align-center">\n              <span class="external-reference-update-item-checkbox os-col" ng-if="activeTab === SELECTIVE_UPDATE">\n                <input type="checkbox" ng-model="updateItemViewModel.isSelected" ng-disabled="updateItemViewModel.isRevisionUpdateInvalid()">\n              </span>\n              <span class="select-item-dialog-thumbnail-container os-col os-no-shrink">\n                <img ng-src="{{updateItemViewModel.getDisplayThumbnailUri(activeTab)}}" img-fallback-src="{{updateItemViewModel.getDefaultThumbnailUri()}}">\n              </span>\n              <div class="select-item-dialog-document-name-box os-col os-grow">\n                <span class="select-item-dialog-document-name">{{updateItemViewModel.getItemHeaderLabel()}}</span>\n                <span class="select-item-dialog-document-version-name os-row">\n                  <span class="current-version ellipseOverflowText" ng-if="canShowItemFromLabel(activeTab, updateItemViewModel)">{{getItemFromLabel(activeTab, updateItemViewModel)}}</span>\n                  <span class="version-arrow" ng-if="canShowFromToArrow(activeTab, updateItemViewModel)">&#x21e8;</span>\n                  <span class="newest-version ellipseOverflowText" ng-if="canShowItemToLabel(activeTab, updateItemViewModel)" style="max-width: {{custommizeMaxVersionLength(activeTab, updateItemViewModel)}}%;">{{getItemToLabel(activeTab, updateItemViewModel)}}</span>\n                </span>\n              </div>\n              <div class="out-of-date-icon" data-bs-placement="right" data-bs-original-title="{{updateItemViewModel.getOutOfDateIconTooltip(activeTab)}}">\n                <os-svg icon="{{updateItemViewModel.getOutOfDateIcon(activeTab)}}"></os-svg>\n              </div>\n              <div ng-if="activeTab === SELECTIVE_UPDATE && updateItemViewModel.hasRevisions() && !revisionHistoryVisible" class="btn-group os-split-btn os-no-shrink external-reference-update-version-graph-button">\n                <button class="btn btn-secondary os-btn" ng-if="!updateItemViewModel.isTrackingRevisions()"\n                ng-click="showVersionGraph(updateItemViewModel)" data-bs-original-title="{{\'Version graph\' | i18next}}" data-bs-placement="right">\n                  <div class="button-content d-flex">\n                    <os-svg icon="version-graph-button"/>\n                  </div>\n                </button>\n                <button class="btn btn-secondary revisions-btn os-btn" ng-if="updateItemViewModel.isTrackingRevisions()" ng-disabled="isLoadingRevisions || updateItemViewModel.getIsTypeChanged()"\n                ng-click="showRevisions(updateItemViewModel)" data-bs-original-title="{{\'Select another revision of this part number\' | i18next}}" data-bs-placement="right">\n                  <div class="button-content d-flex">\n                    <os-svg icon="revisioned-document"/>\n                  </div>\n                </button>\n                <button type="button" class="btn btn-secondary os-btn dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" data-bs-reference="parent" aria-haspopup="true" ng-disabled="isLoadingRevisions" aria-expanded="false">\n                  <span class="visually-hidden">Toggle Dropdown</span>\n                </button>\n                <ul class="dropdown-menu external-reference-update-dropdown" os-append-to-body>\n                  <li>\n                    <a class="dropdown-item d-flex" href="#" ng-click="showVersionGraph(updateItemViewModel)">\n                      <svg class="os-svg-icon">\n                        <use xlink:href="#svg-icon-version-graph-button"></use>\n                      </svg>\n                      <span>{{\'Show versions\' | i18next}}</span>\n                    </a>\n                  </li>\n                  <li ng-if="!updateItemViewModel.getIsTypeChanged()">\n                    <a class="dropdown-item d-flex" href="#" ng-click="showRevisions(updateItemViewModel)">\n                      <svg class="os-svg-icon">\n                        <use xlink:href="#svg-icon-revisioned-document"></use>\n                      </svg>\n                      <span>{{\'Show revisions\' | i18next}}</span>\n                    </a>\n                  </li>\n                </ul>\n              </div>\n              <div ng-if="activeTab === SELECTIVE_UPDATE && !updateItemViewModel.hasRevisions() && !revisionHistoryVisible" class="btn-group os-split-btn os-no-shrink"\n                style="padding-right: {{extraRightPadding()}}px;">\n                <button class="os-button os-col external-reference-update-version-graph-button" ng-disabled="updateItemViewModel.getIsTypeChanged()"\n                ng-click="showVersionGraph(updateItemViewModel)" data-bs-original-title="{{\'Version graph\' | i18next}}" data-bs-placement="right">\n                  <div class="button-content d-flex">\n                    <os-svg icon="version-graph-button"/>\n                  </div>\n                </button>\n              </div>\n            </div>\n            <div class="alert alert-info external-reference-update-alert"\n                 ng-if="updateItemViewModel.getIsTypeChanged()"\n                 os-compile="updateItemViewModel.getTypeChangedMessage()">\n            </div>\n          </li>\n        </ul>\n      </div>\n      <div class="external-reference-update-footer os-row os-align-center os-justify-end os-no-shrink">\n        <button type="button" ng-disabled="documentVersionList.canUpdateAll() === false" class="btn btn-primary external-reference-manager-update-all"\n          ng-click="doUpdate(UPDATE_TO_LATEST)" ng-if="activeTab === UPDATE_TO_LATEST">{{\'Update all\' | i18next}}</button>\n        <button type="button" ng-disabled="documentVersionList.canUpdateSelected() === false" class="btn btn-primary external-reference-manager-update-selected"\n          ng-click="doUpdate(SELECTIVE_UPDATE)" ng-if="activeTab === SELECTIVE_UPDATE">{{\'Update selected\' | i18next}}</button>\n      </div>\n    </div>\n\n    \x3c!-- Version graph--\x3e\n    <div ng-if="versionGraphVisible" class="external-reference-update-body-section external-reference-update-version-graph-section">\n      <div class="os-dialog-title-row">\n        <button class="os-button os-clear" ng-click="hideVersionGraph()" data-bs-original-title="Hide version graph" data-bs-placement="left">\n          <div class="button-content d-flex">\n            <os-svg icon="back-tab"/>\n          </div>\n        </button>\n        <div class="select-item-dialog-document-name-box os-col os-grow">\n          <span class="select-item-dialog-document-name ellipseOverflowText">{{selectedItem.getItemHeaderLabel()}}</span>\n          <span class="select-item-dialog-document-version-name ellipseOverflowText">\n            <svg class="os-svg-icon select-item-dialog-document-version-image" ng-if="selectedItem.isTrackingRevisions()">\n              <use x